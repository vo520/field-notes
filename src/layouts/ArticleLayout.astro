---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

import ArticleNav from '../components/ArticleNav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContentCard from '../components/ContentCard.astro';
import GiscusComments from '../components/GiscusComments.astro';
import ProseEnhancements from '../components/ProseEnhancements.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import { siteConfig } from '../config/site';
import { estimateReadingTime, estimateWordCount } from '../lib/content';
import { formatCompactDate, formatLongDate } from '../lib/date';
import BaseLayout from './BaseLayout.astro';

interface Props {
  article: CollectionEntry<'articles'>;
  headings: MarkdownHeading[];
  previous?: CollectionEntry<'articles'> | undefined;
  next?: CollectionEntry<'articles'> | undefined;
  related?: CollectionEntry<'articles'>[];
  /** 文章声明的所属项目；无效引用由详情页过滤，这里只渲染有效值 */
  project?: CollectionEntry<'projects'> | undefined;
  /** 同一项目下的文章自动构成的系列；独立文章没有系列 */
  series?: {
    title: string;
    project: { id: string } | undefined;
    articles: readonly CollectionEntry<'articles'>[];
  } | undefined;
  seriesIndex: number;
  breadcrumbsItems?: { label: string; href: string }[];
}

const {
  article,
  headings,
  previous,
  next,
  related = [],
  project,
  series,
  seriesIndex,
  breadcrumbsItems = [],
} = Astro.props;
const { data } = article;
const date = formatLongDate(data.publishedAt);
const readingTime = estimateReadingTime(article.body ?? '');
const wordCount = estimateWordCount(article.body ?? '');
// 长文才给内嵌目录：标题太少时侧栏目录已够用，正文开头再放一份反而冗余
const INLINE_TOC_MIN = 8;
const inlineTocItems = headings.filter((heading) => heading.depth === 2);
const showInlineToc = inlineTocItems.length >= INLINE_TOC_MIN;
const breadcrumbList = breadcrumbsItems.length > 0 ? {
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbsItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href, Astro.site).href,
  })),
} : null;
const articleJsonLd = {
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  ...(data.cover ? { image: new URL(data.cover, Astro.site).href } : {}),
  datePublished: data.publishedAt.toISOString(),
  ...(data.updatedAt ? { dateModified: data.updatedAt.toISOString() } : {}),
  author: { '@type': 'Person', name: siteConfig.author.name },
  mainEntityOfPage: new URL(`/articles/${article.id}/`, Astro.site).href,
  keywords: data.tags.join(', '),
  wordCount,
};
const jsonLd: Record<string, unknown>[] = [articleJsonLd];
if (breadcrumbList) jsonLd.push(breadcrumbList);
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  jsonLd={jsonLd}
  readingProgress={true}
  readingMinutes={readingTime}
>
  <article>
    {breadcrumbsItems.length > 0 && (
      <div class="container">
        <Breadcrumbs items={breadcrumbsItems} />
      </div>
    )}
    <header class="container article-hero" data-pagefind-body>
      <p class="eyebrow">{siteConfig.articlePage.eyebrowTemplate.replace('{minutes}', String(readingTime))}</p>
      <h1 data-pagefind-meta="title" transition:name={`article-${article.id}`}>{data.title}</h1>
      <p class="article-description">{data.description}</p>
      <div class="article-meta">
        <time datetime={data.publishedAt.toISOString()}>{date}</time>
        {data.updatedAt && <span>{siteConfig.articlePage.updatedPrefix} {formatCompactDate(data.updatedAt)}</span>}
        <span>{siteConfig.articlePage.wordCountTemplate.replace('{count}', String(wordCount))}</span>
        <TagList tags={data.tags} linked />
        <button
          type="button"
          class="copy-link-button"
          data-copy-link
          aria-label={siteConfig.ui.share.ariaLabel}
        >{siteConfig.ui.share.copyLink}</button>
      </div>
      {series?.project && (
        <a class="article-series" href={`/projects/${series.project.id}/`}>
          {siteConfig.articlePage.seriesTemplate
            .replace('{title}', series.title)
            .replace('{index}', String(seriesIndex))
            .replace('{total}', String(series.articles.length))}
          <span aria-hidden="true">→</span>
        </a>
      )}
      {data.cover && (
        <figure class="article-cover">
          <img
            src={data.cover}
            alt={siteConfig.articlePage.coverAltTemplate.replace('{title}', data.title)}
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )}
    </header>

    <div class="container article-grid">
      <div class="prose" data-pagefind-body>
        {showInlineToc && (
          <details class="inline-toc">
            <summary>
              {siteConfig.articlePage.inlineTocTitle}
              <span class="inline-toc__count">{inlineTocItems.length}</span>
            </summary>
            <ol>
              {inlineTocItems.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )}
        <slot />
        <ArticleNav previous={previous} next={next} />
      </div>
      <TableOfContents headings={headings} />
    </div>

    {project && (
      <section class="container related" data-pagefind-ignore>
        <p class="eyebrow">{siteConfig.projectPage.related.eyebrow}</p>
        <h2>{siteConfig.projectPage.related.title}</h2>
        <div class="related-grid">
          <ProjectCard
            href={`/projects/${project.id}/`}
            title={project.data.title}
            description={project.data.description}
            cover={project.data.cover}
            category={project.data.category}
            status={project.data.status}
            tech={project.data.tech}
            repoUrl={project.data.repoUrl}
            sourceVisibility={project.data.sourceVisibility}
            repositories={project.data.repositories}
            featured={project.data.featured}
          />
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="container related" data-pagefind-ignore>
        <p class="eyebrow">{siteConfig.articlePage.relatedEyebrow}</p>
        <h2>{siteConfig.articlePage.relatedTitle}</h2>
        <div class="related-grid">
          {related.map((entry) => (
            <ContentCard
              type="article"
              href={`/articles/${entry.id}/`}
              title={entry.data.title}
              description={entry.data.description}
              publishedAt={entry.data.publishedAt}
              tags={entry.data.tags}
            />
          ))}
        </div>
      </section>
    )}

    <div class="container comments-slot"><GiscusComments mapping="pathname" /></div>
    <ProseEnhancements />
  </article>
</BaseLayout>

<style>
  .article-hero {
    max-width: var(--content-narrow);
    padding-block: clamp(64px, 8vw, 104px) 56px;
    text-align: left;
  }

  .article-hero h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 3.9rem);
    line-height: 1.14;
  }

  .article-description {
    max-width: 720px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.14rem);
    line-height: 1.75;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 12px 18px;
    margin-top: 26px;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .copy-link-button {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease;
  }

  .copy-link-button:hover {
    color: var(--ink-strong);
    border-color: var(--border-strong);
  }

  .article-series {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    padding: 8px 16px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .article-series:hover { border-color: var(--accent); background: var(--accent-soft); }

  .article-cover {
    margin: 32px 0 0;
  }

  .article-cover img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--prose)) 200px;
    gap: 64px;
    justify-content: center;
    padding-block: 56px 96px;
    border-top: 1px solid var(--border);
  }

  .prose {
    min-width: 0;
    font-size: 1.0625rem;
    line-height: 1.82;
  }

  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 100px;
    line-height: 1.25;
  }

  .prose :global(h2) { margin: 2.6em 0 0.7em; font-size: 1.62rem; }
  .prose :global(h3) { margin: 2em 0 0.6em; font-size: 1.22rem; }
  .prose :global(h2:first-child) { margin-top: 0; }

  .prose :global(p),
  .prose :global(li) {
    color: var(--ink);
  }

  .prose :global(a) { color: var(--ink-strong); text-decoration: underline; text-underline-offset: 0.22em; }
  .prose :global(a:hover) { text-decoration-thickness: 2px; }

  /* 外部链接标识：构建期已给外链加 target=_blank，这里补视觉提示（站内链接不受影响） */
  .prose :global(a[target='_blank'])::after {
    content: ' ↗';
    color: var(--muted-weak);
    font-size: 0.82em;
  }

  /* —— 长文内嵌目录：折叠式，标题数达到阈值才渲染 —— */
  .inline-toc {
    margin: 0 0 2.2em;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
    font-size: 0.92rem;
  }

  .inline-toc summary {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-strong);
    font-weight: 500;
    cursor: pointer;
  }

  .inline-toc__count {
    padding: 1px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 400;
  }

  .inline-toc ol {
    margin: 12px 0 0;
    padding-left: 22px;
  }

  .inline-toc li { margin-top: 0.35em; }

  /* —— 打印：正文优先，隐藏交互装饰并展开折叠代码 —— */
  @media print {
    .prose :global(pre.is-collapsed) {
      max-height: none;
      overflow: visible;
    }

    .prose :global(pre.is-collapsed::after),
    .prose :global(.copy-code),
    .prose :global(.code-toggle) { display: none; }

    .inline-toc { display: none; }
  }
  .prose :global(li + li) { margin-top: 0.45em; }

  .prose :global(blockquote) {
    margin: 2em 0;
    padding: 2px 0 2px 20px;
    border-left: 2px solid var(--border-strong);
    color: var(--muted);
  }

  .prose :global(code) {
    padding: 0.15em 0.35em;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--surface-soft);
    font-family: var(--font-mono);
    font-size: 0.86em;
  }

  .prose :global(pre) {
    overflow: auto;
    margin: 2em 0;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--code-ink);
    background: var(--code) !important;
    line-height: 1.65;
  }

  .prose :global(pre code) {
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .prose :global(th),
  .prose :global(td) { padding: 10px 12px; border-bottom: 1px solid var(--border); text-align: left; }
  .prose :global(th) { background: var(--surface-soft); }

  .related {
    padding-block: 64px 88px;
    border-top: 1px solid var(--border);
  }

  .related h2 { margin: 0 0 26px; font-size: 1.9rem; }
  .related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .comments-slot { max-width: var(--prose); padding-bottom: 88px; }

  @media (max-width: 1024px) {
    .article-grid { grid-template-columns: minmax(0, var(--prose)); }
  }

  @media (max-width: 768px) {
    .article-hero { text-align: left; }
    .article-meta { justify-content: flex-start; }
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
