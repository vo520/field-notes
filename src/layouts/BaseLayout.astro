---
import { ClientRouter } from 'astro:transitions';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import BackToTop from '../components/BackToTop.astro';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';
import Lightbox from '../components/Lightbox.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { siteConfig } from '../config/site';
import { buildOgPath } from '../lib/og-image';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  readingProgress?: boolean;
  readingMinutes?: number;
}

const {
  title,
  description = siteConfig.description,
  type = 'website',
  noindex = false,
  jsonLd,
  readingProgress = false,
  readingMinutes = 0,
} = Astro.props;
const pageTitle = title.includes(siteConfig.name)
  ? title
  : `${title}${siteConfig.titleSeparator}${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogPath = buildOgPath(Astro.url.pathname);
const ogImageUrl = new URL(ogPath, Astro.site).href;
const extraJsonLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: siteConfig.name,
      url: new URL('/', Astro.site).href,
      description: siteConfig.description,
      inLanguage: 'zh-CN',
    },
    {
      '@type': 'Person',
      name: siteConfig.author.name,
      jobTitle: siteConfig.author.role,
      url: new URL('/', Astro.site).href,
      sameAs: [siteConfig.social.github, siteConfig.social.gitee].filter(Boolean),
      ...(siteConfig.social.email ? { email: siteConfig.social.email } : {}),
    },
    ...extraJsonLd,
  ],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter fallback="none" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.rssTitleTemplate.replace('{name}', siteConfig.name)} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () { /* 离线能力非核心，注册失败不影响浏览 */ });
        });
      }
    </script>
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('site-theme');
        } catch {
          stored = null;
        }
        // 优先级：显式存储（仅接受合法值）→ 夜间自动（22:00–07:00 深色）→ 系统偏好 → 默认 light。
        // 夜间自动只在用户从未手动选择时生效，手动选择过的用户永远跟随自己的偏好。
        const scheduledTheme = (() => {
          const hour = new Date().getHours();
          return hour >= 22 || hour < 7 ? 'dark' : null;
        })();
        const theme = stored === 'dark' || stored === 'light'
          ? stored
          : (scheduledTheme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        // 移动端浏览器工具栏用 theme-color 上色，暗色主题下不同步会留出一条白边
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        themeMeta?.setAttribute('content', theme === 'dark' ? '#141414' : '#ffffff');
      })();
    </script>
  </head>
  <body>
    <script>
      import { smoothScroll } from '../lib/smooth-scroll';
      import { initScrollEffects } from '../lib/scroll-effects';
      import { registerPageInit } from '../lib/page-lifecycle';
      registerPageInit(() => {
        smoothScroll.start();
        const stopScrollEffects = initScrollEffects();
        return () => {
          smoothScroll.stop();
          stopScrollEffects();
        };
      });
    </script>
    {readingProgress && <ReadingProgress minutes={readingMinutes} />}
    <a class="skip-link" href="#main-content">{siteConfig.ui.skipLink}</a>
    <Header />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <KeyboardShortcuts />
    <Lightbox />
    <CommandPalette />
  </body>
</html>
