---
import type { CollectionEntry } from 'astro:content';

import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContentCard from '../components/ContentCard.astro';
import GiscusComments from '../components/GiscusComments.astro';
import ProseEnhancements from '../components/ProseEnhancements.astro';
import ProjectCapabilityPanel from '../components/ProjectCapabilityPanel.astro';
import ProjectScreenshots from '../components/ProjectScreenshots.astro';
import RepositoryConstellation from '../components/RepositoryConstellation.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import { siteConfig } from '../config/site';
import { estimateReadingTime } from '../lib/content';
import { formatCompactDate, formatLongDate } from '../lib/date';
import BaseLayout from './BaseLayout.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  related?: CollectionEntry<'projects'>[];
  /** 声明了本项目的文章，由详情页按 slug 反查；不在这里维护第二份关联 */
  relatedArticles?: CollectionEntry<'articles'>[] | undefined;
  breadcrumbsItems?: { label: string; href: string }[];
}

const { project, related = [], relatedArticles = [], breadcrumbsItems = [] } = Astro.props;
const { data } = project;
const readingMinutes = estimateReadingTime(project.body ?? '');
const hasMultipleRepositories = (data.repositories?.length ?? 0) > 1;
const date = formatLongDate(data.publishedAt);
const statusLabels = siteConfig.projectPage.statusLabels;
const projectScreenshotSlug = project.id.replace(/\.[^/.]+$/, '').replace(/[^a-zA-Z0-9_-]+/g, '-');
const projectScreenshotHeadingId = `project-${projectScreenshotSlug || 'detail'}-screenshots-title`;
const breadcrumbList = breadcrumbsItems.length > 0 ? {
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbsItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href, Astro.site).href,
  })),
} : null;
const projectJsonLd = {
  '@type': 'SoftwareSourceCode',
  name: data.title,
  description: data.description,
  ...(data.cover ? { image: new URL(data.cover, Astro.site).href } : {}),
  dateCreated: data.publishedAt.toISOString(),
  ...(data.updatedAt ? { dateModified: data.updatedAt.toISOString() } : {}),
  ...(data.repoUrl ? { codeRepository: data.repoUrl } : {}),
  ...(data.tech?.length ? { keywords: data.tech.join(', ') } : {}),
  author: { '@type': 'Person', name: siteConfig.author.name },
};
const jsonLd: Record<string, unknown>[] = [projectJsonLd];
if (breadcrumbList) jsonLd.push(breadcrumbList);
// 与下方区块和 ProjectCapabilityPanel 的渲染条件保持一致，避免 rail 出现点不动的死锚点
const hasCapabilities = Boolean(
  data.modules?.length || data.roles?.length || data.workflow?.length
  || data.metrics?.length || data.integrations?.length,
);
// 系列目录按发布时间正序排列，读者从第 1 篇顺着往下读
const seriesArticles = [...relatedArticles].sort(
  (left, right) => left.data.publishedAt.getTime() - right.data.publishedAt.getTime(),
);
const projectSections = [
  { id: 'project-overview', label: siteConfig.crumbs.projects },
  ...(data.screenshots
    ? [{ id: projectScreenshotHeadingId, label: siteConfig.projectPage.screenshots.title }]
    : []),
  ...(hasCapabilities
    ? [{ id: 'project-capabilities-title', label: siteConfig.projectPage.capabilities.title }]
    : []),
  ...((data.repositories?.length ?? 0) > 0
    ? [{ id: 'product-panorama-title', label: siteConfig.projectPage.panorama.title }]
    : []),
  { id: 'project-notes', label: '项目复盘' },
  ...(relatedArticles.length > 0
    ? [{ id: 'project-series', label: siteConfig.projectPage.series.title }]
    : []),
];
---

<BaseLayout title={data.title} description={data.description} type="website" jsonLd={jsonLd} readingProgress={true} readingMinutes={readingMinutes}>
  <article class="project-detail">
    {breadcrumbsItems.length > 0 && (
      <div class="container">
        <Breadcrumbs items={breadcrumbsItems} />
      </div>
    )}
    <header class="container project-hero" id="project-overview">
      <div class="project-hero__grid">
        <div class="project-hero__copy">
          <p class="eyebrow">{siteConfig.projectPage.eyebrowTemplate.replace('{status}', statusLabels[data.status])}</p>
          <h1>{data.title}</h1>
          <p class="project-description">{data.description}</p>
          <div class="button-row">
            {data.demoUrl && <a class="button button--primary" href={data.demoUrl} target="_blank" rel="noopener noreferrer">{siteConfig.projectPage.demoAction} ↗</a>}
            {data.repoUrl && <a class="button" href={data.repoUrl} target="_blank" rel="noopener noreferrer">{data.repoLabel ?? siteConfig.projectPage.repoFallback} ↗</a>}
            <button type="button" class="button" data-copy-link aria-label={siteConfig.ui.share.ariaLabel}>{siteConfig.ui.share.copyLink}</button>
          </div>
        </div>
        <dl class="project-meta">
          <div><dt>{siteConfig.projectPage.meta.publishedAt}</dt><dd><time datetime={data.publishedAt.toISOString()}>{date}</time>
            {data.updatedAt && <small class="project-updated">{siteConfig.articlePage.updatedPrefix} {formatCompactDate(data.updatedAt)}</small>}
          </dd></div>
          <div><dt>{siteConfig.projectPage.meta.status}</dt><dd>{statusLabels[data.status]}</dd></div>
          <div><dt>{siteConfig.projectPage.meta.source}</dt><dd>{data.sourceVisibility === 'public' ? siteConfig.projectPage.publicRepo : siteConfig.projectPage.privateRepo}</dd></div>
          <div><dt>{siteConfig.projectPage.meta.tech}</dt><dd><TagList tags={data.tech} /></dd></div>
        </dl>
      </div>
      {data.cover && (
        <figure class="project-showcase">
          <img src={data.cover} alt={siteConfig.projectPage.coverAltTemplate.replace('{title}', data.title)} width="1440" height="900" loading="eager" fetchpriority="high" decoding="async" />
        </figure>
      )}
    </header>

    {data.screenshots && (
      <ProjectScreenshots
        screenshots={data.screenshots}
        projectTitle={data.title}
        headingId={projectScreenshotHeadingId}
      />
    )}

    <ProjectCapabilityPanel project={project} />

    {(data.repositories?.length ?? 0) > 0 && (
      <section class="container project-panorama" aria-labelledby="product-panorama-title">
        <div class="project-panorama__heading">
          <p class="eyebrow">{siteConfig.projectPage.panorama.eyebrow}</p>
          <h2 id="product-panorama-title">{siteConfig.projectPage.panorama.title}</h2>
          <p>
            {hasMultipleRepositories
              ? siteConfig.projectPage.panorama.descriptionMultiple
              : siteConfig.projectPage.panorama.descriptionSingle}
          </p>
        </div>
        <RepositoryConstellation repositories={data.repositories ?? []} />
      </section>
    )}

    <div class="container project-body-grid" id="project-notes">
      <div class="project-index" aria-hidden="true"><span>{project.id.slice(0, 2).toUpperCase()}</span></div>
      <div class="prose" data-pagefind-body>
        <slot />
      </div>
    </div>

    {relatedArticles.length > 0 && (
      <section class="container series-directory" id="project-series" aria-labelledby="project-series-title" data-pagefind-ignore>
        <header class="series-directory__head">
          <p class="eyebrow">{siteConfig.projectPage.series.eyebrow}</p>
          <h2 id="project-series-title">{siteConfig.projectPage.series.title}</h2>
          <p class="series-directory__count">{siteConfig.projectPage.series.countTemplate.replace('{count}', String(seriesArticles.length))}</p>
        </header>
        <ol class="series-directory__list">
          {seriesArticles.map((entry, index) => (
            <li>
              <a href={`/articles/${entry.id}/`}>
                <span class="series-directory__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="series-directory__body">
                  <strong>{entry.data.title}</strong>
                  <span class="series-directory__desc">{entry.data.description}</span>
                </span>
                <span class="series-directory__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {related.length > 0 && (
      <section class="container related" data-pagefind-ignore>
        <p class="eyebrow">{siteConfig.projectPage.related.eyebrow}</p>
        <h2>{siteConfig.projectPage.related.title}</h2>
        <div class="related-grid">
          {related.map((entry) => (
            <ContentCard
              type="project"
              href={`/projects/${entry.id}/`}
              title={entry.data.title}
              description={entry.data.description}
              publishedAt={entry.data.publishedAt}
              tags={entry.data.tech}
            />
          ))}
        </div>
      </section>
    )}

    <div class="container comments-slot">
      <GiscusComments mapping="pathname" />
    </div>
    <ProseEnhancements />
  </article>
  <TableOfContents variant="rail" label="章节导航" sections={projectSections} />
</BaseLayout>

<style>
  .project-hero {
    /* 章节导航跳到"概览"时容器顶部会停在悬浮头部下方 */
    scroll-margin-top: calc(var(--header-height) + 32px);
    padding-block: clamp(64px, 8vw, 96px) 64px;
    border-bottom: 1px solid var(--border);
  }

  .project-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(280px, 4fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: end;
  }

  .project-hero h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 3.6rem);
    line-height: 1.14;
    /* 长英文标题没有空格可断行，窄屏会撑出横向滚动 */
    overflow-wrap: anywhere;
  }

  .project-description {
    max-width: 720px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.14rem);
    line-height: 1.75;
  }

  .project-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin: 0;
  }

  .project-showcase {
    overflow: hidden;
    margin: 44px 0 0;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
  }

  .project-showcase img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-meta div {
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  dt {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 300;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  dd {
    margin: 8px 0 0;
    font-weight: 500;
  }

  .project-updated {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 400;
  }

  .project-panorama {
    display: grid;
    grid-template-columns: minmax(220px, 0.3fr) minmax(0, 0.7fr);
    gap: clamp(36px, 5vw, 72px);
    padding-block: clamp(64px, 8vw, 96px);
    border-bottom: 1px solid var(--border);
  }

  .project-panorama__heading h2 {
    scroll-margin-top: calc(var(--header-height) + 32px);
    margin: 0;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    line-height: 1.14;
  }

  .project-panorama__heading > p:last-child {
    margin: 22px 0 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .project-body-grid {
    /* 复盘区块自身是导航锚点，同样需要避让悬浮头部 */
    scroll-margin-top: calc(var(--header-height) + 32px);
    display: grid;
    grid-template-columns: 72px minmax(0, var(--prose));
    gap: 60px;
    justify-content: center;
    padding-block: 72px 88px;
  }

  .project-index span {
    position: sticky;
    top: 110px;
    display: grid;
    width: 64px;
    height: 64px;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--accent-ink);
    background: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .prose {
    min-width: 0;
    font-size: 1.06rem;
    line-height: 1.8;
  }

  .prose :global(h2) {
    /* 章节导航锚点跳转时标题会停在悬浮头部下方，预留头部高度避免被遮挡 */
    scroll-margin-top: calc(var(--header-height) + 32px);
    margin: 2.4em 0 0.65em;
    font-size: 1.55rem;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--ink);
  }

  /* 与文章详情保持一致：项目正文同样会用到行内代码与多行列表 */
  .prose :global(li + li) {
    margin-top: 0.45em;
  }

  .prose :global(code) {
    padding: 0.15em 0.35em;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--surface-soft);
    font-family: var(--font-mono);
    font-size: 0.86em;
  }

  .prose :global(pre code) {
    padding: 0;
    border: 0;
    background: transparent;
    font-size: inherit;
  }

  .prose :global(a) {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .prose :global(pre) {
    overflow: auto;
    margin: 2em 0;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--code-ink);
    background: var(--code);
  }

  .related {
    padding-block: 64px 88px;
    border-top: 1px solid var(--border);
  }

  .related h2 { margin: 0 0 26px; font-size: 1.9rem; }
  .related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }

  .series-directory {
    /* 章节导航锚点落到该区块时需避让悬浮头部 */
    scroll-margin-top: calc(var(--header-height) + 32px);
    padding-block: 64px 40px;
    border-top: 1px solid var(--border);
  }

  .series-directory__head { margin-bottom: 30px; }
  .series-directory__head h2 { margin: 0 0 8px; font-size: 1.9rem; }
  .series-directory__count { margin: 0; color: var(--muted); font-size: 0.84rem; }

  .series-directory__list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .series-directory__list li + li { border-top: 1px solid var(--border); }

  .series-directory__list a {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding-block: 20px;
    color: inherit;
    text-decoration: none;
    transition: padding-inline 180ms ease;
  }

  .series-directory__list a:hover,
  .series-directory__list a:focus-visible { padding-inline: 10px; }

  .series-directory__index {
    color: var(--muted);
    font-size: 1.3rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .series-directory__body { display: flex; min-width: 0; flex-direction: column; gap: 6px; }
  .series-directory__body strong { font-weight: 600; line-height: 1.4; }
  .series-directory__desc {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .series-directory__arrow { color: var(--muted); font-size: 1.1rem; }

  @media (max-width: 640px) {
    .series-directory__list a { grid-template-columns: 34px minmax(0, 1fr) auto; gap: 12px; }
    .series-directory__index { font-size: 1rem; }
    .series-directory__desc { white-space: normal; }
  }

  .comments-slot {
    max-width: var(--prose);
    padding-bottom: 88px;
  }

  @media (max-width: 768px) {
    .related-grid { grid-template-columns: 1fr; }
    .project-hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .project-hero h1 {
      font-size: clamp(2.5rem, 10vw, 2.75rem);
    }

    .project-meta {
      grid-template-columns: 1fr;
    }

    .project-body-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .project-panorama {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .project-index {
      display: none;
    }
  }
</style>

