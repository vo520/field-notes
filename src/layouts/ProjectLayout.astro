---
import type { CollectionEntry } from 'astro:content';

import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContentCard from '../components/ContentCard.astro';
import GiscusComments from '../components/GiscusComments.astro';
import ProjectCapabilityPanel from '../components/ProjectCapabilityPanel.astro';
import ProjectScreenshots from '../components/ProjectScreenshots.astro';
import RepositoryConstellation from '../components/RepositoryConstellation.astro';
import TagList from '../components/TagList.astro';
import { siteConfig } from '../config/site';
import BaseLayout from './BaseLayout.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  related?: CollectionEntry<'projects'>[];
  breadcrumbsItems?: { label: string; href: string }[];
}

const { project, related = [], breadcrumbsItems = [] } = Astro.props;
const { data } = project;
const hasMultipleRepositories = (data.repositories?.length ?? 0) > 1;
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(data.publishedAt);
const statusLabels = { active: '持续迭代', completed: '已经完成', archived: '已归档' } as const;
const projectScreenshotSlug = project.id.replace(/\.[^/.]+$/, '').replace(/[^a-zA-Z0-9_-]+/g, '-');
const projectScreenshotHeadingId = `project-${projectScreenshotSlug || 'detail'}-screenshots-title`;
const breadcrumbList = breadcrumbsItems.length > 0 ? {
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbsItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href, Astro.site).href,
  })),
} : null;
const projectJsonLd = {
  '@type': 'SoftwareSourceCode',
  name: data.title,
  description: data.description,
  ...(data.cover ? { image: new URL(data.cover, Astro.site).href } : {}),
  dateCreated: data.publishedAt.toISOString(),
  ...(data.repoUrl ? { codeRepository: data.repoUrl } : {}),
  ...(data.tech?.length ? { keywords: data.tech.join(', ') } : {}),
  author: { '@type': 'Person', name: siteConfig.author.name },
};
const jsonLd: Record<string, unknown>[] = [projectJsonLd];
if (breadcrumbList) jsonLd.push(breadcrumbList);
---

<BaseLayout title={data.title} description={data.description} type="article" jsonLd={jsonLd} readingProgress={true} backToTop={true}>
  <article class="project-detail">
    {breadcrumbsItems.length > 0 && (
      <div class="container">
        <Breadcrumbs items={breadcrumbsItems} />
      </div>
    )}
    <header class="container project-hero">
      <div class="project-hero__grid">
        <div class="project-hero__copy">
          <p class="eyebrow">PROJECT / {statusLabels[data.status]}</p>
          <h1>{data.title}</h1>
          <p class="project-description">{data.description}</p>
          {(data.demoUrl || data.repoUrl) && (
            <div class="button-row">
              {data.demoUrl && <a class="button button--primary" href={data.demoUrl} target="_blank" rel="noopener noreferrer">在线体验 ↗</a>}
              {data.repoUrl && <a class="button" href={data.repoUrl} target="_blank" rel="noopener noreferrer">{data.repoLabel ?? 'GitHub 源码'} ↗</a>}
            </div>
          )}
        </div>
        <dl class="project-meta">
          <div><dt>发布日期</dt><dd><time datetime={data.publishedAt.toISOString()}>{date}</time></dd></div>
          <div><dt>当前状态</dt><dd>{statusLabels[data.status]}</dd></div>
          <div><dt>源码</dt><dd>{data.repoUrl ? '公开仓库' : '私有仓库 · 未公开'}</dd></div>
          <div><dt>技术与方向</dt><dd><TagList tags={data.tech} /></dd></div>
        </dl>
      </div>
      {data.cover && (
        <figure class="project-showcase">
          <img src={data.cover} alt={`${data.title} 项目封面`} width="1440" height="900" loading="eager" fetchpriority="high" />
        </figure>
      )}
    </header>

    {data.screenshots && (
      <ProjectScreenshots
        screenshots={data.screenshots}
        projectTitle={data.title}
        headingId={projectScreenshotHeadingId}
      />
    )}

    <ProjectCapabilityPanel project={project} />

    {(data.repositories?.length ?? 0) > 0 && (
      <section class="container project-panorama" aria-labelledby="product-panorama-title">
        <div class="project-panorama__heading">
          <p class="eyebrow">ONE PRODUCT · CONNECTED CODEBASES</p>
          <h2 id="product-panorama-title">产品全景</h2>
          <p>
            {hasMultipleRepositories
              ? '一个产品，按用户前台、运营后台和服务端拆分职责，并通过清晰的源码节点保持关联。'
              : '一个产品，由一个仓库完整维护产品与源码，主仓库入口位于页面首屏。'}
          </p>
        </div>
        <RepositoryConstellation repositories={data.repositories ?? []} />
      </section>
    )}

    <div class="container project-body-grid">
      <div class="project-index" aria-hidden="true"><span>{project.id.slice(0, 2).toUpperCase()}</span></div>
      <div class="prose" data-pagefind-body>
        <slot />
      </div>
    </div>

    {related.length > 0 && (
      <section class="container related" data-pagefind-ignore>
        <p class="eyebrow">RELATED WORK</p>
        <h2>相关项目</h2>
        <div class="related-grid">
          {related.map((entry) => (
            <ContentCard
              type="project"
              href={`/projects/${entry.id}/`}
              title={entry.data.title}
              description={entry.data.description}
              publishedAt={entry.data.publishedAt}
              tags={entry.data.tech}
            />
          ))}
        </div>
      </section>
    )}

    <div class="container comments-slot">
      <GiscusComments mapping="pathname" />
    </div>
  </article>
</BaseLayout>

<style>
  .project-hero {
    padding-block: clamp(64px, 8vw, 96px) 64px;
    border-bottom: 1px solid var(--border);
  }

  .project-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(280px, 4fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: end;
  }

  .project-hero h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 3.6rem);
    line-height: 1.08;
  }

  .project-description {
    max-width: 720px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.14rem);
    line-height: 1.75;
  }

  .project-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin: 0;
  }

  .project-showcase {
    overflow: hidden;
    margin: 44px 0 0;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
  }

  .project-showcase img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-meta div {
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  dt {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 300;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  dd {
    margin: 8px 0 0;
    font-weight: 500;
  }

  .project-panorama {
    display: grid;
    grid-template-columns: minmax(220px, 0.3fr) minmax(0, 0.7fr);
    gap: clamp(36px, 5vw, 72px);
    padding-block: clamp(64px, 8vw, 96px);
    border-bottom: 1px solid var(--border);
  }

  .project-panorama__heading h2 {
    margin: 0;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    line-height: 1.1;
  }

  .project-panorama__heading > p:last-child {
    margin: 22px 0 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .project-body-grid {
    display: grid;
    grid-template-columns: 72px minmax(0, var(--prose));
    gap: 60px;
    justify-content: center;
    padding-block: 72px 88px;
  }

  .project-index span {
    position: sticky;
    top: 110px;
    display: grid;
    width: 64px;
    height: 64px;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--accent-ink);
    background: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .prose {
    min-width: 0;
    font-size: 1.06rem;
    line-height: 1.8;
  }

  .prose :global(h2) {
    margin: 2.4em 0 0.65em;
    font-size: 1.55rem;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--ink);
  }

  .prose :global(a) {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .prose :global(pre) {
    overflow: auto;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--code-ink);
    background: var(--code);
  }

  .related {
    padding-block: 64px 88px;
    border-top: 1px solid var(--border);
  }

  .related h2 { margin: 0 0 26px; font-size: 1.9rem; }
  .related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }

  .comments-slot {
    max-width: var(--prose);
    padding-bottom: 88px;
  }

  @media (max-width: 760px) {
    .related-grid { grid-template-columns: 1fr; }
    .project-hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .project-hero h1 {
      font-size: clamp(2.5rem, 10vw, 2.75rem);
    }

    .project-meta {
      grid-template-columns: 1fr;
    }

    .project-body-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .project-panorama {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .project-index {
      display: none;
    }
  }
</style>

