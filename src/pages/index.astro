---
import { getCollection } from 'astro:content';

import ContentCard from '../components/ContentCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { isPublishedProject, isVisibleEntry, sortByPublishedAt } from '../lib/content';
import '../styles/home.css';

const projects = sortByPublishedAt(
  (await getCollection('projects')).filter((entry) => isPublishedProject(entry, import.meta.env.PROD)),
);
const articles = sortByPublishedAt(
  (await getCollection('articles')).filter((entry) => isVisibleEntry(entry, import.meta.env.PROD)),
);
const selectedProjects = [...projects]
  .sort((left, right) => Number(right.data.featured) - Number(left.data.featured))
  .slice(0, 3);
const featuredAll = siteConfig.home.featuredAllTemplate.replace('{count}', String(projects.length));
---

<BaseLayout title={siteConfig.title}>
  <!-- 首页仅索引品牌文案区；项目/文章卡片已在各自详情页收录，避免重复结果 -->
  <section class="hero-studio" data-pagefind-body>
    <div class="container hero-studio__inner">
      <div class="hero-studio__copy">
        <p class="eyebrow">{siteConfig.author.name} · {siteConfig.author.role}</p>
        <h1>{siteConfig.home.heroTitle}</h1>
        <p class="hero-studio__intro">{siteConfig.description}</p>
        <div class="button-row">
          <a class="button button--primary" href="/projects/">{siteConfig.home.projectsCta} <span class="button__arrow" aria-hidden="true">→</span></a>
          <a class="button" href="/articles/">{siteConfig.home.articlesCta} <span class="button__arrow" aria-hidden="true">→</span></a>
        </div>
        <nav class="hero-projects" aria-label={siteConfig.home.heroProjectsAriaLabel}>
          <span class="hero-projects__label">{siteConfig.home.featuredLabel}</span>
          <div class="hero-projects__links">
            {selectedProjects.map((project) => (
              <a href={`/projects/${project.id}/`}>{project.data.title}</a>
            ))}
            <a class="hero-projects__all" href="/projects/">{featuredAll} →</a>
          </div>
        </nav>
      </div>
      <ul class="hero-studio__stats" aria-label={siteConfig.home.statsAriaLabel}>
        <li><strong>{siteConfig.home.stats.delivery.value}</strong><span>{siteConfig.home.stats.delivery.label}</span></li>
        <li aria-label={siteConfig.ui.projectCountAriaTemplate.replace('{count}', String(projects.length))}><strong data-project-count={projects.length}>{projects.length}</strong><span>{siteConfig.home.stats.projectCountLabel}</span></li>
        <li><strong>{siteConfig.home.stats.interaction.value}</strong><span>{siteConfig.home.stats.interaction.label}</span></li>
      </ul>
    </div>
  </section>

  <div class="container">
    <aside class="open-source-promise" data-free-open-source data-pagefind-body>
      <span aria-hidden="true">✦</span>
      <div>
        <strong>{siteConfig.home.promise.title}</strong>
        <p>{siteConfig.home.promise.description}</p>
      </div>
      <a href="/about/">{siteConfig.home.promise.cta} →</a>
    </aside>

    <section class="home-section home-section--projects" data-home-project-catalog data-pagefind-ignore>
      <SectionHeading
        eyebrow={siteConfig.home.projectsSection.eyebrow}
        title={siteConfig.home.projectsSection.title}
        description={siteConfig.home.projectsSection.description}
        href="/projects/"
        linkLabel={siteConfig.home.projectsSection.cta}
      />
      <div class="home-grid">
        {selectedProjects.map((project) => (
          <ProjectCard
            href={`/projects/${project.id}/`}
            title={project.data.title}
            description={project.data.description}
            cover={project.data.cover}
            category={project.data.category}
            status={project.data.status}
            tech={project.data.tech}
            repoUrl={project.data.repoUrl}
            sourceVisibility={project.data.sourceVisibility}
            repositories={project.data.repositories}
            featured={project.data.featured}
          />
        ))}
      </div>
    </section>

    <section class="home-section home-section--last" data-pagefind-ignore>
      <SectionHeading
        eyebrow={siteConfig.home.articlesSection.eyebrow}
        title={siteConfig.home.articlesSection.title}
        href="/articles/"
        linkLabel={siteConfig.home.articlesSection.cta}
      />
      <div class="home-grid">
        {articles.slice(0, 4).map((article) => (
          <ContentCard
            type="article"
            href={`/articles/${article.id}/`}
            title={article.data.title}
            description={article.data.description}
            publishedAt={article.data.publishedAt}
            tags={article.data.tags}
            featured={article.data.featured}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
