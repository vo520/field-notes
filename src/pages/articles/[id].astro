---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import { getRelatedByTags, isVisibleEntry, sortByPublishedAt } from '../../lib/content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

interface Props {
  article: CollectionEntry<'articles'>;
  previous?: CollectionEntry<'articles'>;
  next?: CollectionEntry<'articles'>;
  related: CollectionEntry<'articles'>[];
}

export async function getStaticPaths() {
  const articles = sortByPublishedAt(
    (await getCollection('articles')).filter((entry) => isVisibleEntry(entry, import.meta.env.PROD)),
  );

  return articles.map((article, index) => ({
    params: { id: article.id },
    props: {
      article,
      previous: articles[index + 1],
      next: articles[index - 1],
      related: getRelatedByTags(articles, article, 3),
    },
  }));
}

const { article, previous, next, related } = Astro.props;
const { Content, headings } = await render(article);
---

<ArticleLayout article={article} headings={headings} previous={previous} next={next} related={related}>
  <Breadcrumbs items={[
    { label: '首页', href: '/' },
    { label: '文章', href: '/articles/' },
    { label: article.data.title, href: `/articles/${article.id}/` },
  ]} />
  <Content />
</ArticleLayout>
