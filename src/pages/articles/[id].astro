---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import { makeArticleBreadcrumbs } from '../../lib/breadcrumbs';
import {
  findArticleProject,
  getArticlePager,
  getArticleProjectIssue,
  getSeriesAwareRelated,
  groupArticlesIntoSeries,
  isPublishedProject,
  isVisibleEntry,
  toTagSlug,
  sortByPublishedAt,
  type ArticleSeries,
} from '../../lib/content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { siteConfig } from '../../config/site';

interface Props {
  article: CollectionEntry<'articles'>;
  previous?: CollectionEntry<'articles'> | undefined;
  next?: CollectionEntry<'articles'> | undefined;
  related: CollectionEntry<'articles'>[];
  project?: CollectionEntry<'projects'> | undefined;
  series?: ArticleSeries<CollectionEntry<'articles'>> | undefined;
  /** 当前文章所在章节：序号与总数都按章节口径，不再用整个项目的篇数 */
  section?: { title: string; articles: readonly CollectionEntry<'articles'>[] } | undefined;
  seriesIndex: number;
}

export async function getStaticPaths() {
  const articles = sortByPublishedAt(
    (await getCollection('articles')).filter((entry) => isVisibleEntry(entry, import.meta.env.PROD)),
  );
  // 关联校验以生产闸门为口径：草稿或未过发布红线的项目不算有效目标。
  const projects = (await getCollection('projects'))
    .filter((entry) => isPublishedProject(entry, import.meta.env.PROD));
  const publishedProjectIds = new Set(projects.map((entry) => toTagSlug(entry.id)));
  const seriesGroups = groupArticlesIntoSeries(
    articles,
    projects,
    siteConfig.articlesPage.standaloneTitle,
    siteConfig.articlesPage.chapters,
    siteConfig.articlesPage.uncategorizedChapterTitle,
  );

  return articles.map((article) => {
    const issue = getArticleProjectIssue(article, publishedProjectIds);
    if (issue) {
      console.warn(`[articles] 文章 "${article.id}" 的项目关联无效：${issue}（文章照常发布，关联区块不渲染）`);
    }

    // 只有归类到具体项目的组才算系列；独立文章组没有系列语义，沿用全站时间序导航。
    const ownSeries = seriesGroups.find(
      (group) => group.project && group.articles.some((entry) => entry.id === article.id),
    );
    const seriesArticles = ownSeries?.articles;
    // 上下篇沿用章节切分后的扁平阅读顺序；同章节内才显示真实序号
    const pager = getArticlePager(articles, seriesArticles, article.id);
    const ownSection = ownSeries?.sections.find((section) =>
      section.articles.some((entry) => entry.id === article.id),
    );

    return {
      params: { id: article.id },
      props: {
        article,
        previous: pager.previous,
        next: pager.next,
        related: getSeriesAwareRelated(articles, seriesArticles, article, 3),
        project: findArticleProject(article, projects),
        series: ownSeries,
        section: ownSection,
        seriesIndex:
          (ownSection?.articles.findIndex((entry) => entry.id === article.id) ?? -1) + 1
          || (seriesArticles?.findIndex((entry) => entry.id === article.id) ?? -1) + 1,
      },
    };
  });
}

const { article, previous, next, related, project, series, section, seriesIndex } = Astro.props;
const { Content, headings } = await render(article);
---

<ArticleLayout
  article={article}
  headings={headings}
  previous={previous}
  next={next}
  related={related}
  project={project}
  series={series}
  section={section}
  seriesIndex={seriesIndex}
  breadcrumbsItems={makeArticleBreadcrumbs(article.id, article.data.title)}
>
  <Content />
</ArticleLayout>
