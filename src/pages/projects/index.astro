---
import { getCollection } from 'astro:content';

import ProjectGallery from '../../components/ProjectGallery.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { siteConfig } from '../../config/site';
import { getArticlesForProject, isPublishedProject, isVisibleEntry, sortByPublishedAt } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const copy = siteConfig.projectsPage;
const projects = sortByPublishedAt(
  (await getCollection('projects')).filter((entry) => isPublishedProject(entry, import.meta.env.PROD)),
);
// 项目侧不存文章数：沿用文章 data.project 的声明反查，与详情页系列目录同一口径
const articles = sortByPublishedAt(
  (await getCollection('articles')).filter((entry) => isVisibleEntry(entry, import.meta.env.PROD)),
);
const articleCountByProject = new Map(
  projects.map((project) => [project.id, getArticlesForProject(articles, project.id).length]),
);
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="container page-shell" data-project-catalog data-pagefind-body>
    <header class="project-catalog__hero" data-reveal>
      <SectionHeading
        eyebrow={copy.eyebrow}
        title={copy.heading}
        description={copy.intro}
        level="h1"
      />
      <p class="project-catalog__count">
        <strong data-project-count={projects.length}>{projects.length}</strong>
        <span>{copy.countUnit}</span>
      </p>
    </header>

    <div class="project-catalog__gallery" data-reveal style="--reveal-delay: 60ms">
      <ProjectGallery projects={projects} articleCountByProject={articleCountByProject} />
    </div>
  </div>
</BaseLayout>

<style>
  .page-shell {
    padding-block: clamp(56px, 8vw, 88px) 96px;
  }

  .project-catalog__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(36px, 7vw, 100px);
    align-items: end;
    margin-bottom: 34px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--border);
  }

  .project-catalog__count {
    display: flex;
    min-width: 160px;
    min-height: 0;
    flex-direction: column;
    justify-content: flex-end;
    margin: 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--border-strong);
  }

  .project-catalog__count strong {
    color: var(--ink-strong);
    font-size: clamp(2.4rem, 4.6vw, 3.2rem);
    line-height: 1;
  }

  .project-catalog__count span {
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .project-catalog__gallery {
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .project-catalog__hero {
      grid-template-columns: 1fr;
    }

    .project-catalog__count {
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .page-shell {
      padding-block: 72px 92px;
    }
  }
</style>

