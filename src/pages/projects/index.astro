---
import { getCollection } from 'astro:content';

import ProjectGallery from '../../components/ProjectGallery.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { isVisibleEntry, sortByPublishedAt } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = sortByPublishedAt(
  (await getCollection('projects')).filter((entry) => isVisibleEntry(entry, import.meta.env.PROD)),
);
---

<BaseLayout title="项目作品" description="Gitee 与 GitHub 上的真实项目实践，包含企业官网、管理系统、小程序与开源项目部署。">
  <div class="container page-shell" data-project-catalog data-pagefind-body>
    <header class="project-catalog__hero">
      <SectionHeading
        eyebrow="PRODUCT CONSTELLATION"
        title="来自 Gitee 与 GitHub 的项目"
        description="每张卡片对应一个真实仓库，包含原创项目与精选开源项目实践；进入详情可查看技术方案与源码状态。"
        level="h1"
      />
      <p class="project-catalog__count">
        <strong data-project-count={projects.length}>{projects.length}</strong>
        <span>个项目 / 仓库实践</span>
      </p>
    </header>

    <div class="project-catalog__gallery">
      <ProjectGallery projects={projects} />
    </div>
  </div>
</BaseLayout>

<style>
  .page-shell {
    padding-block: clamp(56px, 8vw, 88px) 96px;
  }

  .project-catalog__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(36px, 7vw, 100px);
    align-items: end;
    margin-bottom: 34px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--border);
  }

  .project-catalog__count {
    display: flex;
    min-width: 160px;
    min-height: 0;
    flex-direction: column;
    justify-content: flex-end;
    margin: 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--border-strong);
  }

  .project-catalog__count strong {
    color: var(--ink-strong);
    font-size: clamp(2.4rem, 4.6vw, 3.2rem);
    line-height: 1;
  }

  .project-catalog__count span {
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .project-catalog__gallery {
    min-width: 0;
  }

  @media (max-width: 980px) {
    .project-catalog__hero {
      grid-template-columns: 1fr;
    }

    .project-catalog__count {
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .page-shell {
      padding-block: 72px 92px;
    }
  }
</style>

