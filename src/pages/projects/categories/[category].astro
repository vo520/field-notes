---
import { getCollection, type CollectionEntry } from 'astro:content';

import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProjectGallery from '../../../components/ProjectGallery.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { siteConfig } from '../../../config/site';
import { isVisibleEntry, sortByPublishedAt, toTagSlug } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

interface Props {
  slug: string;
  label: string;
  projects: CollectionEntry<'projects'>[];
}

export async function getStaticPaths() {
  const projects = sortByPublishedAt(
    (await getCollection('projects')).filter((entry) => isVisibleEntry(entry, import.meta.env.PROD)),
  );

  const cats = new Map<string, string>();
  projects.forEach((p) => {
    const cat = p.data.category;
    cats.set(toTagSlug(cat), cat);
  });

  return [...cats.entries()].map(([slug, label]) => ({
    params: { category: slug },
    props: {
      slug,
      label,
      projects: projects.filter((p) => toTagSlug(p.data.category) === slug),
    },
  }));
}

const { slug, label, projects } = Astro.props;
const copy = siteConfig.categoryPage;
---

<BaseLayout
  title={copy.titleTemplate.replace('{label}', label)}
  description={copy.descriptionTemplate.replace('{label}', label)}
>
  <div class="container cat-page" data-pagefind-body>
    <Breadcrumbs items={[
      { label: siteConfig.crumbs.home, href: '/' },
      { label: siteConfig.crumbs.projects, href: '/projects/' },
      { label: siteConfig.crumbs.projectCategories, href: '/projects/categories/' },
      { label, href: `/projects/categories/${encodeURIComponent(slug)}/` },
    ]} />
    <SectionHeading
      level="h1"
      eyebrow={copy.eyebrow}
      title={label}
      description={copy.countTemplate.replace('{count}', String(projects.length))}
      href="/projects/categories/"
      linkLabel={copy.cta}
    />
    <ProjectGallery projects={projects} showFilters={false} />
  </div>
</BaseLayout>

<style>
  .cat-page { padding-block: clamp(56px, 8vw, 88px) 104px; }
</style>
