---
import { readFileSync } from 'node:fs';

import { parse as parseYaml } from 'yaml';

import { siteConfig } from '../../config/site';
import BackToTop from '../../components/BackToTop.astro';

// 后台保存校验要读仓库数据：repo / branch 必须直接派生自后台配置本身，
// 不能再抄一份常量——否则迁移仓库或改分支后校验会读错地方，且不会有任何报错。
const cmsConfig = parseYaml(readFileSync(new URL('../../../public/admin/config.yml', import.meta.url), 'utf8')) as {
  backend?: { repo?: string; branch?: string };
};
const cmsRepo = cmsConfig.backend?.repo ?? '';
const cmsBranch = cmsConfig.backend?.branch ?? '';
if (!cmsRepo || !cmsBranch) {
  throw new Error('public/admin/config.yml 缺少 backend.repo / backend.branch，后台保存校验无法定位仓库');
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{siteConfig.admin.cmsTitleTemplate.replace('{name}', siteConfig.author.name)}</title>
    <style>
      /* CMS 壳层不引入整站样式，只补返回顶部按钮依赖的令牌；主题跟随系统或 Sveltia 写入的 data-theme */
      :root {
        --surface: #ffffff;
        --surface-soft: #f1f2f4;
        --ink-strong: #000000;
        --border: rgba(0, 0, 0, 0.08);
        --accent: #000000;
        --sab: env(safe-area-inset-bottom, 0px);
      }
      :root[data-theme='dark'] { color-scheme: dark; }
      :root[data-theme='dark'] {
        --surface: #1c1c1c;
        --surface-soft: #232323;
        --ink-strong: #ffffff;
        --border: rgba(255, 255, 255, 0.12);
        --accent: #ffffff;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --surface: #1c1c1c;
          --surface-soft: #232323;
          --ink-strong: #ffffff;
          --border: rgba(255, 255, 255, 0.12);
          --accent: #ffffff;
        }
      }
      /* CMS 的工作区常有高层级浮层，按钮必须压在最上层才可点 */
      :global(#back-to-top) { z-index: 2147483000; }
    </style>
  </head>
  <body data-cms-repo={cmsRepo} data-cms-branch={cmsBranch}>
    <BackToTop />
    <script
      is:inline
      src="https://unpkg.com/@sveltia/cms@0.272.0/dist/sveltia-cms.js"
      integrity="sha384-znPe/7IsycrTpfyaKEhSPHNMvhkRFxaYJOpTt3L5KhK7CovMdYndiJqS2ajy8KWp"
      crossorigin="anonymous"
    ></script>
    <script>
      import {
        getArticleProjectErrorMessage,
        getCategoryErrorMessage,
        getRemovedCategoriesInUse,
        normalizeCategories,
        type ProjectCategoryUsage,
      } from '../../lib/project-category-guard';

      // 双向校验都读仓库里的最新数据：保存项目时比对分类清单，保存清单时反查有没有项目还在用。
      // repo / branch 由服务端从 admin/config.yml 注入到 body，避免两处配置漂移。
      const body = document.body;
      const REPO_SLUG = body.dataset.cmsRepo ?? '';
      const BRANCH = body.dataset.cmsBranch ?? '';
      if (!REPO_SLUG || !BRANCH) {
        console.warn('[admin] 缺少仓库配置，分类保存校验未启用');
      }
      const CATEGORIES_JSON_URL = `https://api.github.com/repos/${REPO_SLUG}/contents/src/data/projects.json?ref=${BRANCH}`;
      const PROJECTS_TREE_URL = `https://api.github.com/repos/${REPO_SLUG}/git/trees/${BRANCH}?recursive=1`;
      const PROJECTS_RAW_BASE = `https://raw.githubusercontent.com/${REPO_SLUG}/${BRANCH}/`;
      const PROJECTS_DIR = 'src/content/projects/';
      const MAX_PROJECT_FILES = 200;
      const CACHE_TTL = 60_000;

      interface SveltiaCms {
        registerEventListener(options: {
          name: string;
          handler: (args: { entry?: unknown }) => unknown;
        }): void;
      }

      let siteCategoriesCache: { categories: string[]; at: number } | null = null;

      function showCategoryError(message: string) {
        const banner = document.createElement('div');
        banner.setAttribute('role', 'alert');
        banner.textContent = message;
        banner.style.cssText =
          'position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:2147483647;max-width:min(680px,90vw);padding:12px 16px;border-radius:8px;background:#b3261e;color:#fff;font:14px/1.5 system-ui,sans-serif;box-shadow:0 6px 24px rgba(0,0,0,0.25);';
        document.body.append(banner);
        window.setTimeout(() => banner.remove(), 12_000);
      }

      /** 直读仓库（不缓存），供保存分类清单时与「即将写入的清单」做反向比对 */
      async function fetchSiteCategories(): Promise<string[] | null> {
        try {
          const response = await fetch(CATEGORIES_JSON_URL, {
            // 校验用途必须拿仓库最新内容；同会话刚保存过清单时浏览器 CDN 缓存会是旧值
            cache: 'no-store',
            headers: { Accept: 'application/vnd.github+json' },
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);

          const file = (await response.json()) as { content?: unknown };
          if (typeof file.content !== 'string') throw new Error('projects.json 内容为空');

          const binary = atob(file.content.replace(/\s/g, ''));
          const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
          const data = JSON.parse(new TextDecoder().decode(bytes)) as {
            projectsPage?: { categories?: unknown };
          };

          return normalizeCategories(data.projectsPage?.categories);
        } catch (error) {
          // 拉不到最新清单时不拦保存（避免网络或限流造成误拦截），构建期闸门仍会兜底
          console.warn('[admin] 读取最新分类清单失败，本次保存跳过校验', error);
          return null;
        }
      }

      async function loadCategories(): Promise<string[] | null> {
        if (siteCategoriesCache && Date.now() - siteCategoriesCache.at < CACHE_TTL) {
          return siteCategoriesCache.categories;
        }
        const categories = await fetchSiteCategories();
        if (categories) siteCategoriesCache = { categories, at: Date.now() };
        return categories;
      }

      function readCategoryFromMarkdown(source: string): string {
        const match = /^category:\s*(.*)$/m.exec(source);
        if (!match) return '';
        return (match[1] ?? '').trim().replace(/^(['"])(.*)\1$/, '$2');
      }

      let projectUsageCache: { items: ProjectCategoryUsage[]; at: number } | null = null;

      /**
       * 读取仓库里所有项目的当前分类：目录列表走 GitHub API（一次），
       * 文件内容走 raw.githubusercontent（不受 API 限流），逐文件解析 frontmatter。
       */
      async function loadProjectCategories(): Promise<ProjectCategoryUsage[] | null> {
        if (projectUsageCache && Date.now() - projectUsageCache.at < CACHE_TTL) {
          return projectUsageCache.items;
        }

        try {
          const response = await fetch(PROJECTS_TREE_URL, {
            // 同会话刚新建项目后树会变化，不读缓存才能拿到新项目
            cache: 'no-store',
            headers: { Accept: 'application/vnd.github+json' },
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);

          const tree = (await response.json()) as {
            tree?: { path?: unknown; type?: unknown }[];
            truncated?: boolean;
          };
          // 树被 GitHub 截断，或项目数超过上限时，不能拿不完整清单去做「删除分类」校验：
          // 漏掉的项目会在分类被删后被构建期静默下线，后台却提示校验通过。
          // 这里直接放弃本次校验（返回 null），由构建期发布闸门兜底。
          if (tree.truncated) throw new Error('GitHub 树响应被截断，分类反向校验跳过');

          const paths = (tree.tree ?? [])
            .filter((node): node is { path: string; type: string } => (
              node.type === 'blob'
              && typeof node.path === 'string'
              && node.path.startsWith(PROJECTS_DIR)
              && node.path.endsWith('.md')
            ))
            .map((node) => node.path);

          if (paths.length > MAX_PROJECT_FILES) {
            throw new Error(`项目数超过 ${MAX_PROJECT_FILES}，分类反向校验跳过`);
          }

          const items = await Promise.all(paths.map(async (path) => {
            const file = await fetch(`${PROJECTS_RAW_BASE}${path}`);
            if (!file.ok) throw new Error(`HTTP ${file.status}：${path}`);
            return {
              id: path.slice(PROJECTS_DIR.length).replace(/\.md$/, ''),
              category: readCategoryFromMarkdown(await file.text()),
            };
          }));

          projectUsageCache = { items, at: Date.now() };
          return items;
        } catch (error) {
          console.warn('[admin] 读取项目分类失败，本次保存跳过分类清单校验', error);
          return null;
        }
      }

      // Sveltia 会把 preSave 钩子抛出的错误归为「意外错误」且不展示原文，
      // 所以先自己弹提示，再抛错中止保存。
      async function guardProjectCategory({ entry }: { entry?: unknown }) {
        const raw = entry as { toJS?: () => unknown } | undefined;
        const plain = (typeof raw?.toJS === 'function' ? raw.toJS() : raw) as
          | { collection?: unknown; data?: { category?: unknown } }
          | undefined;

        if (plain?.collection !== 'projects') return;

        const categories = await loadCategories();
        let message = categories && getCategoryErrorMessage(categories, plain.data?.category);
        // 同会话里刚保存过分类清单时，60 秒缓存可能仍是旧快照：
        // 按旧清单把刚新增的分类判成非法。作废缓存直读一次，只有最新仓库里也不存在才拦。
        if (message) {
          siteCategoriesCache = null;
          const fresh = await loadCategories();
          message = fresh && getCategoryErrorMessage(fresh, plain.data?.category);
        }
        if (!message) return;

        showCategoryError(message);
        throw new Error(message);
      }

      /**
       * 文章关联项目的保存校验：填了不存在的项目 slug 就当场拦下。
       * 不校验的话文章照样发布，只是静默落回「独立文章」组——归属丢失却毫无提示。
       */
      async function guardArticleProject({ entry }: { entry?: unknown }) {
        const raw = entry as { toJS?: () => unknown } | undefined;
        const plain = (typeof raw?.toJS === 'function' ? raw.toJS() : raw) as
          | { collection?: unknown; data?: { project?: unknown } }
          | undefined;

        if (plain?.collection !== 'articles') return;

        const projects = await loadProjectCategories();
        let slugs = projects ? projects.map((project) => project.id) : null;
        let message = getArticleProjectErrorMessage(slugs, plain.data?.project);
        // 同会话里刚新建项目时，60 秒缓存可能还没这个项目：
        // 作废缓存直读一次，只有最新仓库里也没有才判为无效关联。
        if (message) {
          projectUsageCache = null;
          const fresh = await loadProjectCategories();
          slugs = fresh ? fresh.map((project) => project.id) : null;
          message = getArticleProjectErrorMessage(slugs, plain.data?.project);
        }
        if (!message) return;

        showCategoryError(message);
        throw new Error(message);
      }

      /**
       * 反向校验：删除或改名分类清单里的某一项时，若还有项目在用这个分类，
       * 就拦下保存并列出项目——否则构建期会把那些项目静默下线。
       * 只认「旧清单有、新清单没有」的分类；清空整份清单属于既有约定，不在这里拦。
       */
      async function guardSettingsCategories({ entry }: { entry?: unknown }) {
        const raw = entry as { toJS?: () => unknown } | undefined;
        const plain = (typeof raw?.toJS === 'function' ? raw.toJS() : raw) as
          | { data?: { projectsPage?: { categories?: unknown } } }
          | undefined;

        const nextCategories = plain?.data?.projectsPage?.categories;
        if (nextCategories === undefined) return;

        const previous = await fetchSiteCategories();
        if (!previous) return;

        // 清空整份清单是既有约定（视为「未配置」），不拦；没有删除任何分类
        // （只是新增/调序/改其它设置）时也不必去拉项目文件
        const nextList = normalizeCategories(nextCategories);
        if (nextList.length === 0) return;
        if (previous.every((category) => nextList.includes(category))) return;

        const projects = await loadProjectCategories();
        if (!projects) return;

        const conflicts = getRemovedCategoriesInUse(previous, nextList, projects);
        if (conflicts.length === 0) return;

        const detail = conflicts
          .map((conflict) => `「${conflict.category}」（${conflict.projects.join('、')}）`)
          .join('；');
        const message = `这些分类仍有项目在使用，不能删除或改名：${detail}。请先把对应项目的「分类」改成新名字，或保留原分类后再保存。`;
        showCategoryError(message);
        throw new Error(message);
      }

      const cms = (window as unknown as { CMS?: SveltiaCms }).CMS;
      if (cms?.registerEventListener) {
        cms.registerEventListener({ name: 'preSave', handler: guardProjectCategory });
        cms.registerEventListener({ name: 'preSave', handler: guardArticleProject });
        cms.registerEventListener({ name: 'preSave', handler: guardSettingsCategories });
      } else {
        console.warn('[admin] 未找到 Sveltia CMS，分类保存校验未启用');
      }
    </script>
  </body>
</html>
