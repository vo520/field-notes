---
import { getCollection, type CollectionEntry } from 'astro:content';

import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContentCard from '../../components/ContentCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { siteConfig } from '../../config/site';
import { groupBySlug, isVisibleEntry, sortByPublishedAt } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const copy = siteConfig.tagPage;

interface Props {
  slug: string;
  label: string;
  articles: CollectionEntry<'articles'>[];
}

export async function getStaticPaths() {
  const articles = sortByPublishedAt(
    (await getCollection('articles')).filter((entry) => isVisibleEntry(entry, import.meta.env.PROD)),
  );

  // 保留首次出现（即最新文章）的写法，和标签总览页的显示名、数量保持一致
  return groupBySlug(articles, (article) => article.data.tags).map(({ slug, label, entries }) => ({
    params: { tag: slug },
    props: { slug, label, articles: entries },
  }));
}

const { slug, label, articles } = Astro.props;
---

<BaseLayout
  title={copy.titleTemplate.replace('{tag}', label)}
  description={copy.descriptionTemplate.replace('{tag}', label)}
>
  <div class="container tag-page" data-pagefind-body>
    <Breadcrumbs items={[
      { label: siteConfig.crumbs.home, href: '/' },
      { label: siteConfig.crumbs.tags, href: '/tags/' },
      { label, href: `/tags/${encodeURIComponent(slug)}/` },
    ]} />
    <SectionHeading
      level="h1"
      eyebrow={copy.eyebrow}
      title={copy.headingTemplate.replace('{tag}', label)}
      description={copy.countTemplate.replace('{count}', String(articles.length))}
      href="/tags/"
      linkLabel={copy.cta}
    />
    <div class="tag-grid">
      {articles.map((article) => (
        <ContentCard
          type="article"
          href={`/articles/${article.id}/`}
          title={article.data.title}
          description={article.data.description}
          publishedAt={article.data.publishedAt}
          tags={article.data.tags}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .tag-page { padding-block: clamp(56px, 8vw, 88px) 104px; }
  .tag-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 768px) { .tag-grid { grid-template-columns: 1fr; } }
</style>
