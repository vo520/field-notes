---
import { getCollection } from 'astro:content';

import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { siteConfig } from '../../config/site';
import { groupBySlug, isVisibleEntry, sortByPublishedAt } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const copy = siteConfig.tagsPage;

// 按发布时间倒序后再聚合，标签显示名取最新文章里的写法，与 /tags/<slug>/ 详情页保持一致
const articles = sortByPublishedAt(
  (await getCollection('articles')).filter((entry) => isVisibleEntry(entry, import.meta.env.PROD)),
);

const tags = groupBySlug(articles, (article) => article.data.tags)
  .map(({ slug, label, entries }) => ({ slug, label, count: entries.length }))
  .sort((left, right) => right.count - left.count || left.label.localeCompare(right.label, 'zh-CN'));
---

<BaseLayout
  title={copy.title}
  description={copy.descriptionTemplate.replace('{count}', String(tags.length))}
>
  <div class="container page-shell" data-pagefind-body>
    <Breadcrumbs items={[
      { label: siteConfig.crumbs.home, href: '/' },
      { label: siteConfig.crumbs.tags, href: '/tags/' },
    ]} />
    <SectionHeading
      level="h1"
      eyebrow={copy.eyebrow}
      title={copy.heading}
      description={copy.summaryTemplate
        .replace('{count}', String(tags.length))
        .replace('{articles}', String(articles.length))}
      href="/articles/"
      linkLabel={copy.cta}
    />

    <ul class="tag-index" data-reveal style="--reveal-delay: 60ms">
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${tag.slug}/`}>
            <span class="tag-index__label"># {tag.label}</span>
            <span class="tag-index__count">{tag.count} {copy.itemUnit}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page-shell { padding-block: clamp(56px, 8vw, 88px) 104px; }
  .tag-index {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-index a {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--ink);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 180ms ease, background-color 180ms ease;
  }

  .tag-index a:hover { border-color: var(--border-strong); background: var(--accent-soft); }
  .tag-index__label { font-weight: 600; }
  .tag-index__count { color: var(--muted); font-size: 0.78rem; white-space: nowrap; }
</style>
