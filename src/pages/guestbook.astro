---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GiscusComments from '../components/GiscusComments.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const copy = siteConfig.guestbook;
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="container guestbook-page" data-pagefind-body>
    <Breadcrumbs items={[
      { label: siteConfig.crumbs.home, href: '/' },
      { label: siteConfig.crumbs.guestbook, href: '/guestbook/' },
    ]} />
    <div class="guestbook-intro" data-reveal>
      <header>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>
          {copy.titleLines.map((line) => <span class="guestbook-title-line">{line}</span>)}
        </h1>
        <p>{copy.intro}</p>
      </header>

      <div class="guestbook-rules">
        {copy.rules.map((rule) => <span>{rule}</span>)}
      </div>
    </div>

    <GiscusComments mapping="specific" term="global-guestbook" title={copy.commentsTitle} />
  </div>
</BaseLayout>

<style>
  .guestbook-page {
    max-width: var(--content-narrow);
    display: grid;
    grid-template-columns: minmax(240px, 4fr) minmax(0, 8fr);
    gap: clamp(40px, 6vw, 72px);
    align-items: start;
    padding-block: clamp(56px, 8vw, 88px) 96px;
  }
  .guestbook-page :global(.site-breadcrumbs) { grid-column: 1 / -1; }
  /* 标题由多行 span 组成，1.1 会让中文上下行贴字 */
  .guestbook-page header h1 { margin: 0; font-size: clamp(2.4rem, 4.6vw, 3.2rem); line-height: 1.14; }
  .guestbook-title-line { display: block; }
  .guestbook-page header > p:last-child { margin: 20px 0 0; color: var(--muted); font-size: 0.96rem; line-height: 1.78; }
  .guestbook-rules { display: grid; grid-template-columns: 1fr; gap: 14px; margin-top: 32px; }
  .guestbook-rules span { padding-top: 13px; border-top: 1px solid var(--border); color: var(--muted); font-family: var(--font-sans); font-size: 0.72rem; font-weight: 300; letter-spacing: 0.06em; }
  @media (max-width: 768px) {
    .guestbook-page { grid-template-columns: 1fr; }
    .guestbook-page header h1 { font-size: clamp(2.5rem, 10vw, 2.75rem); }
  }
</style>

