---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const copy = siteConfig.bookmarks;
---

<BaseLayout title={copy.title} description={copy.description} noindex>
  <div class="container bookmarks-page" data-pagefind-ignore>
    <Breadcrumbs items={[
      { label: siteConfig.crumbs.home, href: '/' },
      { label: copy.heading, href: '/bookmarks/' },
    ]} />
    <header>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p>{copy.intro}</p>
    </header>
    <div class="copy-announcer copy-announcer--local" data-copy-announcer aria-live="polite" aria-atomic="true"></div>
    <div class="bookmarks-grid" data-bookmarks-grid></div>
    <p class="bookmarks-empty" data-bookmarks-empty tabindex="-1" hidden>{copy.empty}</p>
  </div>
</BaseLayout>

<script>
  import { registerPageInit } from '../lib/page-lifecycle';

  registerPageInit(() => {
    const grid = document.querySelector<HTMLElement>('[data-bookmarks-grid]');
    const empty = document.querySelector<HTMLElement>('[data-bookmarks-empty]');
    if (!grid) return;
    const KEY = 'site-bookmarks';

    const render = () => {
      let list = [];
      try {
        const raw = JSON.parse(localStorage.getItem(KEY) ?? '[]');
        list = Array.isArray(raw) ? raw : [];
      } catch { /* ignore */ }
      grid.replaceChildren();
      // 空态按「实际渲染出的卡片数」判定：非法条目被跳过后若一张都不剩，也要显示空态
      let rendered = 0;

      list.forEach((item) => {
        if (typeof item?.href !== 'string' || !item.href.startsWith('/')) return;
        const card = document.createElement('article');
        card.className = 'content-card bookmark-card';

        const link = document.createElement('a');
        link.className = 'card-link';
        link.href = item.href;
        link.setAttribute('aria-label', item.title ?? '');
        link.append(document.createElement('span'));

        const topline = document.createElement('div');
        topline.className = 'card-topline';
        const type = document.createElement('span');
        type.textContent = item.type === 'project' ? 'PROJECT' : 'ARTICLE';
        topline.append(type);

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'bookmark-remove';
        remove.dataset.bookmarkRemove = item.href;
        remove.textContent = '★';
        remove.setAttribute('aria-label', '移除收藏');
        topline.append(remove);

        const main = document.createElement('div');
        main.className = 'card-main';
        const title = document.createElement('h3');
        title.textContent = item.title ?? item.href;
        main.append(title);

        card.append(link, topline, main);
        grid.append(card);
        rendered += 1;
      });

      if (empty) empty.hidden = rendered > 0;

      grid.querySelectorAll<HTMLButtonElement>('[data-bookmark-remove]').forEach((button) => {
        button.addEventListener('click', () => {
          let next = [];
          try {
            const raw = JSON.parse(localStorage.getItem(KEY) ?? '[]');
            next = Array.isArray(raw) ? raw.filter((entry) => entry.href !== button.dataset.bookmarkRemove) : [];
          } catch { /* ignore */ }
          try { localStorage.setItem(KEY, JSON.stringify(next)); } catch { /* ignore */ }
          render();
          // 被删掉的按钮随重渲染销毁，焦点会掉回 body；交给下一张卡片或空态，键盘用户不迷路
          const nextFocus = grid.querySelector<HTMLAnchorElement>('.card-link');
          if (nextFocus) nextFocus.focus();
          else empty?.focus();
        });
      });
    };

    // 只响应收藏键的跨标签变化：任何其它存储事件（主题/阅读位置等）都不该触发重渲染，
    // 否则 replaceChildren 会销毁正被聚焦的移除按钮，焦点掉回 body
    const onStorage = (event: StorageEvent) => {
      if (event.key !== KEY && event.key !== null) return;
      render();
    };
    window.addEventListener('storage', onStorage);
    render();
    return () => window.removeEventListener('storage', onStorage);
  });
</script>

<style>
  .bookmarks-page { max-width: var(--content-narrow); padding-block: clamp(56px, 8vw, 88px) 104px; }
  header { max-width: 760px; margin: 0 0 32px; }
  h1 { margin: 0; font-size: clamp(2.4rem, 4.6vw, 3.2rem); line-height: 1.14; }
  header > p:last-child { max-width: 590px; margin: 18px 0 0; color: var(--muted); font-size: 0.96rem; line-height: 1.75; }

  .copy-announcer--local {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .bookmarks-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }

  /* 卡片由脚本动态注入，拿不到 ContentCard 的 scoped 样式，这里用 :global 补齐外观 */
  .bookmarks-grid :global(.bookmark-card) {
    position: relative;
    display: flex;
    min-height: 160px;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    overflow: hidden;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition: border-color 200ms ease;
  }

  .bookmarks-grid :global(.bookmark-card:hover) { border-color: var(--border-strong); }

  .bookmarks-grid :global(.card-link) { position: absolute; z-index: 2; inset: 0; }
  .bookmarks-grid :global(.card-link:focus-visible) { border-radius: inherit; outline-offset: -4px; }

  .bookmarks-grid :global(.card-topline) {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.18em;
  }

  .bookmarks-grid :global(.card-main h3) {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.24;
  }

  .bookmarks-grid :global(.bookmark-remove) {
    position: relative;
    z-index: 3;
    margin-left: auto;
    min-width: 44px;
    min-height: 44px;
    border: 0;
    color: var(--accent);
    background: transparent;
    font-size: 1.1rem;
    cursor: pointer;
    transition: color 180ms ease, transform 180ms ease;
  }

  .bookmarks-grid :global(.bookmark-remove:hover) { transform: scale(1.1); }

  .bookmarks-empty {
    margin: 0;
    padding: 48px 24px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    color: var(--muted);
    text-align: center;
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .bookmarks-grid { grid-template-columns: 1fr; }
  }
</style>
