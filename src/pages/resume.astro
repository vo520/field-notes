---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { isPublishedProject } from '../lib/content';
import { toTagSlug } from '../lib/slug';

const intro = {
  eyebrow: 'JOB PROFILE · FULL-STACK ENGINEER',
  title: '全栈工程师，把需求做成能上线的产品。',
  summary:
    '我是 Nice，一名全栈工程师。习惯把模糊的需求拆成页面、接口和数据结构，再一路做到部署上线；项目结束后会把源码入口和技术说明一并交出。',
};

const facts = [
  { label: '求职方向', value: '全栈工程师' },
  { label: '主力技术栈', value: 'PHP / Vue / Nuxt / Next.js' },
  { label: '交付范围', value: '企业官网 · 管理后台 · 小程序' },
  { label: '期望城市', value: '深圳' },
  { label: '协作方式', value: '需求 → 开发 → 部署 → 迭代' },
];

const highlights = [
  {
    title: '全栈闭环',
    description: '页面、接口、数据与部署由同一个人负责，减少交接中的信息损耗。',
  },
  {
    title: '业务落地',
    description: '长期处理官网、后台与小程序需求，习惯先把业务语言翻译成页面与数据结构。',
  },
  {
    title: '工程可维护',
    description: '组件化、模板化与构建期校验并行，避免做成只上线一次的一次性页面。',
  },
  {
    title: '开源实践',
    description: '通过公开 fork 验证 Laravel、Vue 与 PHP 项目的部署和二次开发路径。',
  },
];

const stackGroups = [
  { label: '前端界面', items: ['Vue 3', 'Nuxt 2', 'React', 'TypeScript', 'Vite', 'HTML / CSS / JavaScript'] },
  { label: '服务端与数据', items: ['PHP', 'Laravel', 'Next.js', 'FastAPI', 'MySQL', 'SQLite'] },
  { label: '多端与交付', items: ['微信小程序', 'uni-app', 'Docker Compose', 'Cloudflare Workers', 'Git'] },
];

/** 项目经历直接取自项目库，避免简历与作品页两处内容漂移；slug 失效时自动跳过 */
const experienceEntries = [
  { slug: 'yuejiang-news-site', contribution: '负责 RSS 采集流程、任务进度与数据看板的端到端实现。' },
  { slug: 'mydobot-ui', contribution: '负责用户中心的账号资料、产品入口与状态管理。' },
  { slug: 'dobotcn', contribution: '负责栏目模板、页面结构与响应式布局，支撑中英文内容组织。' },
  { slug: 'omnivision-brand', contribution: '负责组件化页面与样式体系重构，统一品牌视觉与移动端表现。' },
  { slug: 'robot-forum-miniapp', contribution: '负责话题浏览、帖子详情与个人资料页的小程序实现。' },
  { slug: 'geoflow', contribution: '完成本地部署、后台功能验证与二次开发，沉淀可复用的部署说明。' },
];

const publishedProjects = (await getCollection('projects')).filter((entry) => isPublishedProject(entry, import.meta.env.PROD));
const projectBySlug = new Map(publishedProjects.map((entry) => [entry.id, entry]));

const experience = experienceEntries.flatMap(({ slug, contribution }) => {
  const project = projectBySlug.get(slug);
  if (!project) return [];
  return [{
    slug,
    title: project.data.title,
    category: project.data.category,
    tech: project.data.tech,
    contribution,
  }];
});

const stats = [
  { value: String(publishedProjects.length), label: '个公开项目' },
  // 分类计数按 slug 归并，避免清单里出现过的大小写变体把同一类业务算成两类
  { value: String(new Set(publishedProjects.map((entry) => toTagSlug(entry.data.category ?? ''))).size), label: '类业务场景' },
  { value: String(experience.length), label: '个代表案例' },
];

/** 工作经历以本机留存的雇主项目提交（最早 2023-08）与绩效文档为准；入职月份若有出入，改 period 即可 */
const workHistory = [
  {
    company: '越疆科技（DOBOT）',
    role: '前端开发工程师',
    team: '国内市场部 · 设计部',
    period: '2023.08 — 至今',
    summary: '负责中英文官网、小程序与管理后台的前端开发，并承接域名、证书与站点运维等交付工作。',
    points: [
      '中英文官网：栏目模板、产品详情页与多语言内容组织，配合 hreflang、sitemap 与页面元数据落地 SEO 基础项。',
      '小程序与管理后台：访客预约、培训报名、订单与资料维护等流程的页面实现与接口联调。',
      '运维与交付：域名 / DNS / SSL 的续期与配置，站点与数据库备份、恢复演练，以及 CDN 与基础安全策略维护。',
    ],
  },
];

/** 本机记录中未找到院校与专业信息，先如实留白，补齐后直接替换这两个字段 */
const education = {
  school: '教育背景暂未公开',
  detail: '本机记录中没有学历信息；岗位需要时，可在邮件或面试中提供完整院校、专业与起止时间。',
};

const profileJsonLd = {
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: siteConfig.author.name,
    jobTitle: siteConfig.author.role,
    description: intro.summary,
    ...(siteConfig.social.email ? { email: siteConfig.social.email } : {}),
    knowsAbout: stackGroups.flatMap((group) => group.items),
  },
};

const workflow = [
  { title: '需求梳理', description: '先确认谁在用、要解决什么问题，再拆页面、接口与数据结构。' },
  { title: '界面实现', description: '结构、响应式与交互一起做，桌面和手机都按同一套设计语言验收。' },
  { title: '接口与数据', description: '账号权限、数据落库与状态流转按真实业务流程设计，而不是只跑通演示。' },
  { title: '部署与迭代', description: '按项目形态选择静态托管、容器或 Workers，上线后按反馈继续调整。' },
];

const socialLabel = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<BaseLayout
  title="求职简历"
  description={`${siteConfig.author.name} 的求职简介：全栈工程师，主攻 PHP / Vue / Nuxt / Next.js，交付企业官网、管理后台与小程序。`}
  jsonLd={profileJsonLd}
  backToTop
>
  <div class="container resume-page" data-pagefind-body>
    <header class="resume-hero">
      <div class="resume-hero__copy">
        <p class="eyebrow">{intro.eyebrow}</p>
        <h1>{intro.title}</h1>
        <p class="resume-hero__lead">{intro.summary}</p>
        <ul class="resume-stats" aria-label="项目概览">
          {stats.map((stat) => (
            <li>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </li>
          ))}
        </ul>
        <div class="button-row">
          {siteConfig.social.email && (
            <a class="button button--primary" href={`mailto:${siteConfig.social.email}`}>邮件联系我 →</a>
          )}
          <a class="button" href="/projects/">查看项目作品</a>
          <button type="button" class="button button--print" data-print-resume>打印 / 存为 PDF</button>
        </div>
      </div>

      <aside class="resume-facts" aria-label="求职信息">
        <p class="resume-facts__title">求职信息</p>
        <dl>
          {facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </header>

    <section class="resume-section" aria-labelledby="resume-summary-title">
      <header class="resume-section__head">
        <p class="eyebrow">SUMMARY</p>
        <h2 id="resume-summary-title">个人简介</h2>
      </header>
      <div class="resume-section__body">
        <p class="resume-summary">
          长期与企业官网、管理系统和小程序打交道：前端负责信息架构、响应式布局与交互细节，后端负责接口、数据落库与权限边界。比起只交付一个页面，更在意项目半年后还能不能顺手地改。
        </p>
        <ul class="resume-highlights">
          {highlights.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="resume-section" aria-labelledby="resume-stack-title">
      <header class="resume-section__head">
        <p class="eyebrow">STACK</p>
        <h2 id="resume-stack-title">技术栈</h2>
      </header>
      <div class="resume-section__body">
        <div class="stack-grid">
          {stackGroups.map((group) => (
            <div class="stack-group">
              <h3>{group.label}</h3>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="resume-section" aria-labelledby="resume-experience-title">
      <header class="resume-section__head">
        <p class="eyebrow">EXPERIENCE</p>
        <h2 id="resume-experience-title">项目经历</h2>
      </header>
      <div class="resume-section__body">
        <ol class="resume-timeline">
          {experience.map((item, index) => (
            <li>
              <div class="resume-timeline__head">
                <span class="resume-timeline__index">{String(index + 1).padStart(2, '0')}</span>
                <h3><a href={`/projects/${item.slug}/`}>{item.title}</a></h3>
                <span class="resume-timeline__category">{item.category}</span>
              </div>
              <p>{item.contribution}</p>
              {item.tech.length > 0 && (
                <ul class="resume-tech" aria-label="项目技术栈">
                  {item.tech.map((tech) => <li>{tech}</li>)}
                </ul>
              )}
            </li>
          ))}
        </ol>
        <a class="resume-more" href="/projects/">查看全部项目 <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="resume-section" aria-labelledby="resume-work-title">
      <header class="resume-section__head">
        <p class="eyebrow">EMPLOYMENT</p>
        <h2 id="resume-work-title">工作经历</h2>
      </header>
      <div class="resume-section__body">
        <ol class="resume-work">
          {workHistory.map((job) => (
            <li>
              <div class="resume-work__head">
                <div>
                  <h3>{job.company}</h3>
                  <p class="resume-work__role">{job.role} · {job.team}</p>
                </div>
                <span class="resume-work__period">{job.period}</span>
              </div>
              <p class="resume-work__summary">{job.summary}</p>
              <ul class="resume-work__points">
                {job.points.map((point) => <li>{point}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="resume-section" aria-labelledby="resume-education-title">
      <header class="resume-section__head">
        <p class="eyebrow">EDUCATION</p>
        <h2 id="resume-education-title">教育背景</h2>
      </header>
      <div class="resume-section__body">
        <div class="resume-education">
          <h3>{education.school}</h3>
          <p>{education.detail}</p>
        </div>
      </div>
    </section>

    <section class="resume-section" aria-labelledby="resume-workflow-title">
      <header class="resume-section__head">
        <p class="eyebrow">APPROACH</p>
        <h2 id="resume-workflow-title">工作方式</h2>
      </header>
      <div class="resume-section__body">
        <div class="workflow-grid">
          {workflow.map((step, index) => (
            <div class="workflow-item">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="resume-contact" aria-labelledby="resume-contact-title">
      <div>
        <p class="eyebrow">CONTACT</p>
        <h2 id="resume-contact-title">在找一个能把项目做上线的全栈工程师？</h2>
        <p>简历之外，也可以直接看项目源码和交付记录。有具体需求时，邮件里说明背景与期望，我会尽快回复。</p>
        <div class="button-row">
          {siteConfig.social.email && (
            <a class="button button--primary" href={`mailto:${siteConfig.social.email}`}>发邮件聊聊 →</a>
          )}
          <a class="button" href="/guestbook/">留言板</a>
        </div>
      </div>
      <dl class="contact-list">
        {siteConfig.social.email && (
          <div>
            <dt>{siteConfig.about.contact.emailLabel}</dt>
            <dd><a href={`mailto:${siteConfig.social.email}`}>{siteConfig.social.email}</a></dd>
          </div>
        )}
        {siteConfig.social.wechat && (
          <div>
            <dt>{siteConfig.about.contact.wechatLabel}</dt>
            <dd>{siteConfig.social.wechat}</dd>
          </div>
        )}
        {siteConfig.social.github && (
          <div>
            <dt>{siteConfig.about.contact.githubLabel}</dt>
            <dd><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">{socialLabel(siteConfig.social.github)}</a></dd>
          </div>
        )}
        {siteConfig.social.gitee && (
          <div>
            <dt>{siteConfig.about.contact.giteeLabel}</dt>
            <dd><a href={siteConfig.social.gitee} target="_blank" rel="noopener noreferrer">{socialLabel(siteConfig.social.gitee)}</a></dd>
          </div>
        )}
      </dl>
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-print-resume]').forEach((button) => {
    button.addEventListener('click', () => window.print());
  });
</script>

<style>
  .resume-page {
    padding-block: clamp(56px, 8vw, 88px) 112px;
  }

  .resume-hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(280px, 4fr);
    align-items: end;
    gap: clamp(32px, 5vw, 72px);
    padding-bottom: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--border-strong);
  }

  .resume-hero h1 {
    max-width: 620px;
    margin: 0;
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    line-height: 1.06;
  }

  .resume-hero__lead {
    max-width: 620px;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.8;
  }

  .resume-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px clamp(20px, 4vw, 40px);
    margin: 28px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .resume-stats li {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .resume-stats strong {
    font-family: var(--font-sans);
    font-size: 1.4rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .resume-stats span {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .button--print {
    appearance: none;
    font-family: inherit;
    cursor: pointer;
  }

  .resume-facts {
    padding: 24px 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .resume-facts__title {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .resume-facts dl {
    margin: 0;
  }

  .resume-facts dl > div {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 12px;
    padding-block: 11px;
    border-top: 1px solid var(--border);
  }

  .resume-facts dl > div:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .resume-facts dl > div:last-child {
    padding-bottom: 0;
  }

  .resume-facts dt {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .resume-facts dd {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .resume-section {
    display: grid;
    grid-template-columns: minmax(160px, 3fr) minmax(0, 9fr);
    gap: clamp(24px, 4vw, 64px);
    padding-block: clamp(36px, 5vw, 52px);
    border-bottom: 1px solid var(--border);
  }

  .resume-section__head h2 {
    margin: 10px 0 0;
    font-size: clamp(1.45rem, 2.4vw, 1.9rem);
  }

  .resume-summary {
    max-width: 760px;
    margin: 0;
    font-size: 1rem;
    line-height: 1.85;
  }

  .resume-highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 28px 0 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--border);
    list-style: none;
  }

  .resume-highlights li {
    padding: 22px;
    background: var(--surface);
  }

  .resume-highlights h3 {
    margin: 0 0 8px;
    font-size: 1rem;
  }

  .resume-highlights p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .stack-group {
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .stack-group h3 {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .stack-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-group li {
    padding: 5px 11px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
  }

  .resume-timeline {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .resume-timeline > li {
    padding-block: 24px;
    border-bottom: 1px solid var(--border);
  }

  .resume-timeline__head {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .resume-timeline__index {
    color: var(--muted-weak);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
  }

  .resume-timeline h3 {
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.4;
  }

  .resume-timeline h3 a {
    color: var(--ink-strong);
    text-decoration: none;
  }

  .resume-timeline h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .resume-timeline h3 a::after {
    content: '↗';
    margin-left: 6px;
    color: var(--muted-weak);
    font-family: var(--font-sans);
    font-size: 0.78em;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .resume-timeline > li:hover h3 a::after,
  .resume-timeline h3 a:focus-visible::after {
    opacity: 1;
  }

  .resume-timeline__category {
    flex: none;
    margin-left: auto;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .resume-timeline > li > p {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .resume-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .resume-tech li {
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.74rem;
    line-height: 1.5;
  }

  .resume-more {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    color: var(--ink-strong);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .resume-more:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .resume-work {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .resume-work > li {
    padding-block: 24px;
    border-bottom: 1px solid var(--border);
  }

  .resume-work__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .resume-work__head h3 {
    margin: 0;
    font-size: 1.14rem;
  }

  .resume-work__role {
    margin: 6px 0 0;
