---
import SearchPanel from '../components/SearchPanel.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const copy = siteConfig.search;
---

<BaseLayout title={copy.title} description={copy.descriptionTemplate.replace('{name}', siteConfig.name)} noindex>
  <div class="container search-page" data-pagefind-ignore>
    <header>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p>{copy.description}</p>
    </header>
    <SearchPanel />
  </div>
</BaseLayout>

<style>
  .search-page { max-width: var(--content-narrow); padding-block: clamp(56px, 8vw, 88px) 104px; }
  header { max-width: 760px; margin: 0 0 32px; }
  h1 { margin: 0; font-size: clamp(2.4rem, 4.6vw, 3.2rem); line-height: 1.08; }
  header > p:last-child { max-width: 590px; margin: 18px 0 0; color: var(--muted); font-size: 0.96rem; line-height: 1.75; }
</style>

