---
import { getCollection } from 'astro:content';

import ContentCard from '../components/ContentCard.astro';
import TagList from '../components/TagList.astro';
import { siteConfig } from '../config/site';
import { groupBySlug, isPublishedProject, isVisibleEntry, sortByPublishedAt } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';

const copy = siteConfig.notFound;
const articles = sortByPublishedAt(
  (await getCollection('articles')).filter((entry) => isVisibleEntry(entry, import.meta.env.PROD)),
);
const projects = sortByPublishedAt(
  (await getCollection('projects')).filter((entry) => isPublishedProject(entry, import.meta.env.PROD)),
);
const recommendedArticles = articles.slice(0, 2);
const recommendedProjects = projects.slice(0, 2);
const popularTags = groupBySlug(
  articles.flatMap((entry) => entry.data.tags),
  (tag) => [tag],
)
  .sort((left, right) => right.entries.length - left.entries.length)
  .slice(0, 8)
  .map((group) => group.entries[0] ?? '');
---

<BaseLayout title={copy.title} description={copy.description} noindex>
  <div class="container not-found-page">
    <header class="not-found-hero" data-reveal>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p>{copy.message}</p>
      <div class="button-row" style="justify-content:center">
        <a class="button button--primary" href="/">{copy.backHome}</a>
      </div>
      <form class="not-found-search" action="/search/" method="get" role="search">
        <label for="not-found-query" class="sr-only">{copy.searchLabel}</label>
        <input
          id="not-found-query"
          name="q"
          type="search"
          placeholder={copy.searchPlaceholder}
          autocomplete="off"
        />
        <button type="submit" aria-label={copy.searchLabel}>→</button>
      </form>
    </header>

    {recommendedArticles.length > 0 && (
      <section class="not-found-section" data-reveal>
        <h2>{copy.articlesTitle}</h2>
        <div class="not-found-grid">
          {recommendedArticles.map((entry) => (
            <ContentCard
              type="article"
              href={`/articles/${entry.id}/`}
              title={entry.data.title}
              description={entry.data.description}
              publishedAt={entry.data.publishedAt}
              tags={entry.data.tags}
            />
          ))}
        </div>
      </section>
    )}

    {recommendedProjects.length > 0 && (
      <section class="not-found-section" data-reveal>
        <h2>{copy.projectsTitle}</h2>
        <div class="not-found-grid">
          {recommendedProjects.map((entry) => (
            <ContentCard
              type="project"
              href={`/projects/${entry.id}/`}
              title={entry.data.title}
              description={entry.data.description}
              publishedAt={entry.data.publishedAt}
              tags={entry.data.tech}
            />
          ))}
        </div>
      </section>
    )}

    {popularTags.length > 0 && (
      <section class="not-found-section not-found-tags" data-reveal>
        <h2>{copy.tagsTitle}</h2>
        <TagList tags={popularTags} linked />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .not-found-page {
    padding-block: 80px 96px;
  }

  .not-found-hero {
    max-width: 640px;
    margin: 0 auto 24px;
    text-align: center;
  }

  .not-found-hero h1 {
    margin: 12px 0 18px;
    font-size: clamp(5rem, 18vw, 9rem);
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .not-found-hero > p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .not-found-search {
    display: flex;
    max-width: 460px;
    margin: 32px auto 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  /* 输入框自己关掉了 outline，焦点必须由外层胶囊提示，否则键盘用户看不到落点 */
  .not-found-search:focus-within {
    border-color: var(--accent);
  }

  .not-found-search:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .not-found-search input {
    flex: 1;
    min-width: 0;
    min-height: 46px;
    padding: 0 18px;
    border: 0;
    color: var(--ink-strong);
    background: var(--surface);
    font-family: var(--font-sans);
    /* 低于 16px 时 iOS 聚焦会自动放大页面 */
    font-size: 1rem;
    outline: none;
  }

  .not-found-search button {
    flex: none;
    width: 52px;
    border: 0;
    color: var(--accent-ink);
    background: var(--accent);
    font-size: 1.2rem;
    cursor: pointer;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .not-found-section {
    margin-top: 64px;
  }

  .not-found-section h2 {
    margin: 0 0 24px;
    font-size: 1.5rem;
  }

  .not-found-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .not-found-tags :global(.tag-list) {
    gap: 10px;
  }

  @media (max-width: 640px) {
    .not-found-grid { grid-template-columns: 1fr; }
    .not-found-page { padding-block: 56px 72px; }
  }
</style>
