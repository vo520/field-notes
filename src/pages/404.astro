---
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const copy = siteConfig.notFound;
---

<BaseLayout title={copy.title} description={copy.description} noindex>
  <div class="container empty-page">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p>{copy.message}</p>
      <div class="button-row" style="justify-content:center">
        <a class="button button--primary" href="/">{copy.backHome}</a>
      </div>
    </div>
  </div>
</BaseLayout>
