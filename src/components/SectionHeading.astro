---
import { siteConfig } from '../config/site';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  href?: string | undefined;
  linkLabel?: string | undefined;
  level?: 'h1' | 'h2';
  id?: string;
}

const { eyebrow, title, description, href, linkLabel = siteConfig.ui.sectionLinkFallback, level = 'h2', id } = Astro.props;
---

<header class="section-heading">
  <div class="section-heading__copy">
    <p class="eyebrow">{eyebrow}</p>
    {level === 'h1' ? <h1 id={id}>{title}</h1> : <h2 id={id}>{title}</h2>}
    {description && <p class="section-description">{description}</p>}
  </div>
  {href && (
    <a class="section-heading__link" href={href}>
      {linkLabel} <span class="section-heading__arrow" aria-hidden="true">→</span>
    </a>
  )}
</header>

<style>
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .section-heading__copy {
    min-width: 0;
  }

  h1,
  h2 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 3rem);
    /* 中文标题常换行，1.08 会让上下行字形相贴，按 CJK 留出 1.18 行距 */
    line-height: 1.18;
  }

  .section-description {
    max-width: 620px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.75;
  }

  .section-heading__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    flex: none;
    padding: 9px 20px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--ink-strong);
    background: transparent;
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 200ms ease, background-color 200ms ease, border-color 200ms ease;
  }

  .section-heading__link:hover {
    color: var(--accent-ink);
    border-color: var(--accent);
    background: var(--accent);
  }

  .section-heading__arrow {
    display: inline-block;
    transition: transform 200ms ease;
  }

  .section-heading__link:hover .section-heading__arrow {
    transform: rotate(45deg);
  }

  @media (max-width: 640px) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }
  }
</style>
