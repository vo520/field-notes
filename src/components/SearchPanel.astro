---
import { siteConfig } from '../config/site';

const copy = siteConfig.search;
---

<section
  class="search-panel"
  aria-labelledby="search-title"
  data-msg-hint={copy.hint}
  data-msg-searching={copy.searching}
  data-msg-result={copy.resultTemplate}
  data-msg-empty={copy.emptyTemplate}
  data-msg-error={copy.error}
  data-type-project={copy.typeProject}
  data-type-article={copy.typeArticle}
  data-type-page={copy.typePage}
  data-filter-all={copy.filterAll}
  data-filter-label={copy.filterLabel}
  data-history-title={copy.historyTitle}
>
  <div class="search-box">
    <label id="search-title" for="site-search">{copy.label}</label>
    <div class="search-input-row">
      <input
        id="site-search"
        type="search"
        inputmode="search"
        autocomplete="off"
        placeholder={copy.placeholder}
        aria-describedby="search-status"
        data-search-input
      />
      <button type="button" data-search-clear hidden>{copy.clear}</button>
    </div>
    <p id="search-status" class="search-status" aria-live="polite" data-search-status>
      {copy.hint}
    </p>
  </div>
  <div class="search-filters" role="group" aria-label={copy.filterLabel} data-search-filters hidden>
    <button type="button" data-type-filter="all" aria-pressed="true">{copy.filterAll}</button>
    <button type="button" data-type-filter="article" aria-pressed="false">{copy.typeArticle}</button>
    <button type="button" data-type-filter="project" aria-pressed="false">{copy.typeProject}</button>
    <button type="button" data-type-filter="page" aria-pressed="false">{copy.typePage}</button>
  </div>
  <div class="search-history" data-search-history hidden>
    <div class="search-history__head">
      <span>{copy.historyTitle}</span>
      <button type="button" data-history-clear>{copy.clearHistory}</button>
    </div>
    <div class="search-history__items" data-search-history-items></div>
  </div>
  <ol class="search-results" data-search-results></ol>
  <noscript><p class="search-fallback">{copy.noscript}</p></noscript>
</section>

<script>
  import { registerPageInit } from '../lib/page-lifecycle';

  interface SearchResult {
    url: string;
    excerpt: string;
    meta: { title?: string };
  }
  type PagefindApi = {
    init: () => Promise<void>;
    search: (query: string) => Promise<{ results: { data: () => Promise<SearchResult> }[] }>;
  };

  registerPageInit(() => {
    const panel = document.querySelector<HTMLElement>('.search-panel');
    const copy = (key: string) => panel?.dataset[key] ?? '';
    const input = document.querySelector<HTMLInputElement>('[data-search-input]');
    const clearButton = document.querySelector<HTMLButtonElement>('[data-search-clear]');
    const status = document.querySelector<HTMLElement>('[data-search-status]');
    const results = document.querySelector<HTMLElement>('[data-search-results]');
    const filters = document.querySelector<HTMLElement>('[data-search-filters]');
    const history = document.querySelector<HTMLElement>('[data-search-history]');
    const historyItems = document.querySelector<HTMLElement>('[data-search-history-items]');
    const historyClear = document.querySelector<HTMLButtonElement>('[data-history-clear]');
    let pagefindPromise: Promise<PagefindApi> | undefined;
    let timer = 0;
    let requestId = 0;
    let activeIndex = -1;
    let resultLinks: HTMLAnchorElement[] = [];
    let activeType = 'all';
    let currentItems: SearchResult[] = [];
    const HISTORY_KEY = 'site-search-history';
    const HISTORY_MAX = 6;

    const readHistory = (): string[] => {
      try {
        const raw: unknown = JSON.parse(localStorage.getItem(HISTORY_KEY) ?? '[]');
        return Array.isArray(raw) ? raw.filter((item): item is string => typeof item === 'string').slice(0, HISTORY_MAX) : [];
      } catch { return []; }
    };
    const writeHistory = (query: string) => {
      try {
        const next = [query, ...readHistory().filter((item) => item !== query)].slice(0, HISTORY_MAX);
        localStorage.setItem(HISTORY_KEY, JSON.stringify(next));
      } catch { /* ignore */ }
    };
    const itemType = (item: SearchResult) => item.url.includes('/projects/')
      ? 'project'
      : item.url.includes('/articles/')
        ? 'article'
        : 'page';
    const renderHistory = () => {
      if (!history || !historyItems) return;
      const entries = readHistory();
      historyItems.replaceChildren();
      entries.forEach((query) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = query;
        button.addEventListener('click', () => {
          if (!input) return;
          input.value = query;
          void performSearch();
          input.focus();
        });
        historyItems.append(button);
      });
      history.hidden = entries.length === 0 || Boolean(input?.value.trim());
    };

    const setStatus = (message: string) => {
      if (status) status.textContent = message;
    };

    const loadPagefind = async (): Promise<PagefindApi> => {
      if (!pagefindPromise) {
        pagefindPromise = (async () => {
          const pagefindUrl = '/pagefind/pagefind.js';
          const pagefind = await import(/* @vite-ignore */ pagefindUrl) as unknown as PagefindApi;
          await pagefind.init();
          return pagefind;
        })();
        pagefindPromise.catch(() => { pagefindPromise = undefined; });
      }
      return pagefindPromise;
    };

    const setActive = (index: number) => {
      activeIndex = index;
      resultLinks.forEach((link, position) => link.classList.toggle('is-active', position === index));
      if (index >= 0) resultLinks[index]?.scrollIntoView({ block: 'nearest' });
    };

    const syncQueryToUrl = (query: string) => {
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      window.history.replaceState(null, '', url);
    };

    const resultStatus = (count: number, query: string) => setStatus(
      count > 0
        ? copy('msgResult').replace('{count}', String(count))
        : copy('msgEmpty').replace('{query}', query),
    );

    const renderResults = (items: SearchResult[]): number => {
      if (!results) return 0;
      currentItems = items;
      results.replaceChildren();
      const visible = items.filter((item) => activeType === 'all' || itemType(item) === activeType);
      visible
        .forEach((item) => {
          const entry = document.createElement('li');
          const link = document.createElement('a');
          const type = document.createElement('span');
          const title = document.createElement('strong');
          const excerpt = document.createElement('p');

          link.href = item.url;
          type.className = 'result-type';
          type.textContent = itemType(item) === 'project'
            ? copy('typeProject')
            : itemType(item) === 'article'
              ? copy('typeArticle')
              : copy('typePage');
          title.textContent = item.meta.title ?? item.url;
          excerpt.innerHTML = item.excerpt;
          link.append(type, title, excerpt);
          entry.append(link);
          results.append(entry);
        });
      resultLinks = [...results.querySelectorAll('a')];
      setActive(-1);
      return visible.length;
    };

    const performSearch = async () => {
      window.clearTimeout(timer);
      const query = input?.value.trim() ?? '';
      const currentRequest = ++requestId;
      if (clearButton) clearButton.hidden = query.length === 0;
      syncQueryToUrl(query);
      if (!query) {
        results?.replaceChildren();
        currentItems = [];
        resultLinks = [];
        setActive(-1);
        setStatus(copy('msgHint'));
        if (filters) filters.hidden = true;
        if (history) history.hidden = readHistory().length === 0;
        return;
      }

      if (filters) filters.hidden = false;
      if (history) history.hidden = true;
      setStatus(copy('msgSearching'));
      results?.replaceChildren();
      currentItems = [];
      resultLinks = [];
      setActive(-1);
      try {
        const pagefind = await loadPagefind();
        const response = await pagefind.search(query);
        const matches = response.results;
        const data = await Promise.all(matches.slice(0, 20).map((result) => result.data()));
        if (currentRequest !== requestId) return;
        resultStatus(renderResults(data), query);
      } catch {
        if (currentRequest !== requestId) return;
        results?.replaceChildren();
        resultLinks = [];
        activeIndex = -1;
        setStatus(copy('msgError'));
      }
    };

    const clearTimer = () => window.clearTimeout(timer);
    const scheduleSearch = () => {
      clearTimer();
      timer = window.setTimeout(() => { void performSearch(); }, 180);
    };
    input?.addEventListener('focus', () => { void loadPagefind().catch(() => undefined); }, { once: true });
    input?.addEventListener('compositionstart', clearTimer);
    input?.addEventListener('compositionend', scheduleSearch);
    input?.addEventListener('input', (event) => {
      if (event.isComposing) { clearTimer(); return; }
      scheduleSearch();
    });
    input?.addEventListener('keydown', (event) => {
      if (event.isComposing) return;
      if (event.key === 'Escape') {
        input.value = '';
        void performSearch();
        return;
      }
      if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && resultLinks.length) {
        event.preventDefault();
        const step = event.key === 'ArrowDown' ? 1 : -1;
        const next = activeIndex === -1
          ? (step === 1 ? 0 : resultLinks.length - 1)
          : (activeIndex + step + resultLinks.length) % resultLinks.length;
        setActive(next);
        return;
      }
      if (event.key === 'Enter') {
        const query = input.value.trim();
        if (query) writeHistory(query);
        if (activeIndex >= 0) {
          event.preventDefault();
          resultLinks[activeIndex]?.click();
        }
      }
    });
    clearButton?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      input.focus();
      void performSearch();
    });

    filters?.querySelectorAll<HTMLButtonElement>('[data-type-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        activeType = button.dataset.typeFilter ?? 'all';
        filters.querySelectorAll('[data-type-filter]').forEach((candidate) => {
          candidate.setAttribute('aria-pressed', String(candidate === button));
        });
        if (currentItems.length) {
          resultStatus(renderResults(currentItems), input?.value.trim() ?? '');
        }
      });
    });
    historyClear?.addEventListener('click', () => {
      try { localStorage.removeItem(HISTORY_KEY); } catch { /* ignore */ }
      renderHistory();
    });

    const initialQuery = new URLSearchParams(window.location.search).get('q') ?? '';
    renderHistory();
    if (input && initialQuery) {
      input.value = initialQuery;
      void performSearch();
    }

    let shouldFocusSearch = false;
    try {
      shouldFocusSearch = sessionStorage.getItem('focus-search') === '1';
      if (shouldFocusSearch) sessionStorage.removeItem('focus-search');
    } catch { /* ignore */ }
    if (shouldFocusSearch) input?.focus();
    // 监听器都绑在被 swap 替换的 DOM 节点上，旧节点随之销毁，无需显式解绑
  });
</script>

<style>
  .search-panel { max-width: 860px; margin-inline: auto; }

  .search-box {
    padding: clamp(22px, 4vw, 34px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  label { display: block; margin-bottom: 14px; font-size: 1.05rem; font-weight: 700; }

  .search-input-row { position: relative; }

  input {
    width: 100%;
    height: 56px;
    padding: 0 88px 0 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--ink);
    background: var(--surface-soft);
    font-size: 0.96rem;
    transition: border-color 180ms ease, background-color 180ms ease;
  }

  /* 不要在这里写 outline: none：它会覆盖全局 :focus-visible 焦点环，键盘用户看不到焦点位置 */
  input:focus { border-color: var(--border-strong); background: var(--surface); }

  /* 已有自定义「清除」按钮，去掉 WebKit 原生清除图标，避免出现两个叉 */
  input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  button {
    position: absolute;
    top: 6px;
    right: 6px;
    min-width: 44px;
    min-height: 44px;
    height: 44px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    background: var(--surface);
    font-size: 0.82rem;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease;
  }

  button:hover { color: var(--ink-strong); border-color: var(--border-strong); }

  .search-status { min-height: 1.5em; margin: 12px 0 0; color: var(--muted); font-size: 0.82rem; }

  /* 筛选/历史按钮脱离上方 input 行的绝对定位按钮规则 */
  .search-filters,
  .search-history { margin-top: 16px; }

  .search-filters button,
  .search-history button,
  .search-history__items button {
    position: static;
    width: auto;
    height: auto;
    min-width: 0;
    min-height: 32px;
    padding: 5px 13px;
    font-size: 0.8rem;
  }

  .search-filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .search-filters button[aria-pressed='true'] {
    color: var(--accent-ink);
    border-color: var(--accent);
    background: var(--accent);
  }

  .search-history__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
  }

  .search-history__items { display: flex; flex-wrap: wrap; gap: 8px; }
  .search-history__items button { color: var(--muted); background: var(--surface-soft); }

  .search-results { display: grid; gap: 12px; margin: 26px 0 0; padding: 0; list-style: none; }

  .search-results :global(a) {
    display: block;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 180ms ease;
  }

  .search-results :global(a:hover) { color: var(--ink); border-color: var(--border-strong); }
  .search-results :global(a.is-active) { border-color: var(--accent); }
  .search-results :global(.result-type) { display: block; margin-bottom: 7px; color: var(--muted-weak); font-size: 0.7rem; font-weight: 300; letter-spacing: 0.18em; }
  .search-results :global(strong) { font-size: 1.14rem; }
  .search-results :global(p) { margin: 8px 0 0; color: var(--muted); font-size: 0.9rem; }
  .search-results :global(mark) { color: var(--ink-strong); background: var(--accent-soft); }
  .search-fallback { color: var(--muted); }
</style>
