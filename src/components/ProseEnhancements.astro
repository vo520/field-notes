---
import { siteConfig } from '../config/site';

const copy = siteConfig.ui.codeCopy;
---

<div
  class="copy-announcer"
  aria-live="polite"
  aria-atomic="true"
  data-copy-announcer
  data-label-copy={copy.copy}
  data-label-copied={copy.copied}
  data-label-failed={copy.copyFailed}
  data-label-aria={copy.ariaLabel}
  data-announce-copied={copy.copiedAnnounce}
  data-announce-failed={copy.failedAnnounce}
></div>

<script>
  const announcer = document.querySelector<HTMLElement>('[data-copy-announcer]');
  const labels = {
    copy: announcer?.dataset.labelCopy ?? '',
    copied: announcer?.dataset.labelCopied ?? '',
    failed: announcer?.dataset.labelFailed ?? '',
    aria: announcer?.dataset.labelAria ?? '',
    announceCopied: announcer?.dataset.announceCopied ?? '',
    announceFailed: announcer?.dataset.announceFailed ?? '',
  };

  document.querySelectorAll<HTMLElement>('.prose pre').forEach((block) => {
    if (block.querySelector('[data-copy-code]')) return;
    const code = block.querySelector('code');
    if (!code) return;

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-code';
    button.dataset.copyCode = '';
    button.textContent = labels.copy;
    button.setAttribute('aria-label', labels.aria);
    let resetTimer = 0;
    button.addEventListener('click', async () => {
      // 每次点击先撤销上一次的复位定时器，避免旧定时器覆盖最新结果
      window.clearTimeout(resetTimer);
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        button.textContent = labels.copied;
        if (announcer) announcer.textContent = labels.announceCopied;
        resetTimer = window.setTimeout(() => { button.textContent = labels.copy; }, 1600);
      } catch {
        button.textContent = labels.failed;
        if (announcer) announcer.textContent = labels.announceFailed;
        // 失败提示同样要复位，否则按钮会一直停在「复制失败」
        resetTimer = window.setTimeout(() => { button.textContent = labels.copy; }, 1600);
      }
    });
    block.append(button);

    // 按钮绝对定位在右上角，若代码行长于容器（移动端常见）会盖住首行文字，
    // 这里按原内边距 + 按钮实际高度补出顶部留白，文章/项目两套 padding 都能自适应。
    const basePadding = Number.parseFloat(getComputedStyle(block).paddingTop) || 0;
    block.style.paddingTop = `${Math.ceil(basePadding + button.getBoundingClientRect().height)}px`;
  });
</script>

<style>
  .copy-announcer {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  :global(.prose pre) { position: relative; }

  :global(.copy-code) {
    position: absolute;
    top: 10px;
    right: 10px;
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    background: var(--surface);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease;
  }

  :global(.copy-code:hover) { color: var(--ink-strong); border-color: var(--border-strong); }
</style>

