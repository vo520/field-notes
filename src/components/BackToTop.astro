---
/**
 * 返回顶部按钮。滚动超 400px 渐显，点击 smooth scroll 到顶部。
 */
import { siteConfig } from '../config/site';
---

<button id="back-to-top" class="back-to-top" type="button" aria-label={siteConfig.ui.backToTop}>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5"/>
    <path d="m5 12 7-7 7 7"/>
  </svg>
</button>

<script>
  (function () {
    const btn = document.getElementById('back-to-top') as HTMLButtonElement | null;
    if (!btn || (btn as any).dataset.attached === '1') return;
    (btn as any).dataset.attached = '1';

    const root = document.documentElement;
    const THRESHOLD = 400;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function update() {
      btn!.classList.toggle('visible', root.scrollTop > THRESHOLD);
    }

    btn.addEventListener('click', () => {
      root.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    });

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => { update(); ticking = false; });
    }, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

<style>
  .back-to-top {
    position: fixed;
    bottom: calc(32px + var(--sab, 0px));
    right: 28px;
    z-index: 35;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 200ms ease, transform 200ms ease, background 180ms ease, visibility 200ms ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    -webkit-tap-highlight-color: transparent;
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top:hover { background: var(--surface-soft); }

  .back-to-top:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
