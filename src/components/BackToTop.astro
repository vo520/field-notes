---
/**
 * 返回顶部按钮。滚动超 400px 渐显，点击 smooth scroll 到顶部。
 */
import { siteConfig } from '../config/site';
---

<button id="back-to-top" class="back-to-top" type="button" aria-label={siteConfig.ui.backToTop}>
  <svg class="back-to-top__ring" width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true">
    <circle class="back-to-top__track" cx="22" cy="22" r="20" />
    <circle class="back-to-top__progress" data-back-to-top-progress cx="22" cy="22" r="20" />
  </svg>
  <svg class="back-to-top__arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5"/>
    <path d="m5 12 7-7 7 7"/>
  </svg>
</button>

<script>
  import { smoothScroll } from '../lib/smooth-scroll';
  import { registerPageInit } from '../lib/page-lifecycle';
  import { onScrollFrame } from '../lib/scroll-ticker';

  registerPageInit(() => {
    const btn = document.getElementById('back-to-top');
    if (!(btn instanceof HTMLButtonElement)) return;

    const root = document.documentElement;
    const THRESHOLD = 400;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ring = btn.querySelector('[data-back-to-top-progress]');
    const CIRCUMFERENCE = 2 * Math.PI * 20;
    if (ring instanceof SVGCircleElement) {
      ring.style.strokeDasharray = String(CIRCUMFERENCE);
      ring.style.strokeDashoffset = String(CIRCUMFERENCE);
    }

    // 读阶段只取滚动位置，写阶段才改 class 与圆环 dashoffset
    let scrollTop = root.scrollTop;
    let scrollTotal = 0;

    const onClick = () => {
      smoothScroll.halt();
      root.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'instant' : 'smooth' });
    };
    btn.addEventListener('click', onClick);

    const stopFrames = onScrollFrame({
      read: () => {
        scrollTop = root.scrollTop;
        scrollTotal = Math.max(root.scrollHeight - window.innerHeight, 0);
      },
      write: () => {
        btn.classList.toggle('visible', scrollTop > THRESHOLD);
        if (!(ring instanceof SVGCircleElement)) return;
        const progress = scrollTotal > 0 ? Math.min(1, Math.max(0, scrollTop / scrollTotal)) : 0;
        ring.style.strokeDashoffset = String(CIRCUMFERENCE * (1 - progress));
      },
    });

    return () => {
      stopFrames();
      btn.removeEventListener('click', onClick);
    };
  });
</script>

<style>
  .back-to-top {
    position: fixed;
    bottom: calc(32px + var(--sab, 0px));
    /* 横屏刘海机型右侧存在安全区，固定按钮同样要避让 */
    right: calc(28px + var(--sar, 0px));
    z-index: 35;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 200ms ease, transform 200ms ease, background 180ms ease, visibility 200ms ease;
    box-shadow: var(--shadow-float);
    -webkit-tap-highlight-color: transparent;
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top__ring,
  .back-to-top__arrow {
    position: absolute;
    inset: 0;
    margin: auto;
  }

  .back-to-top__track,
  .back-to-top__progress {
    stroke-width: 2;
  }

  .back-to-top__track {
    stroke: var(--border);
  }

  .back-to-top__progress {
    stroke: var(--accent);
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 22px 22px;
  }

  .back-to-top:hover { background: var(--surface-soft); }

  .back-to-top:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
