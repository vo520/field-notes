---
/**
 * 命令面板：Cmd/Ctrl+K 打开，聚合页面直达、文章/项目检索与常用操作。
 * 页面/文章/项目清单不再内联进 HTML（98 页各背 9KB），改为按需拉取 /site-index.json。
 */
import { siteConfig } from '../config/site';

const copy = siteConfig.ui.commandPalette;
---

<button
  type="button"
  class="command-palette-trigger"
  data-command-open
  aria-label={copy.ariaLabel}
  title={copy.ariaLabel}
>
  <span>⌘K</span>
</button>

<dialog class="command-dialog" data-command-palette aria-label={copy.title}>
  <input
    type="search"
    data-command-input
    placeholder={copy.placeholder}
    autocomplete="off"
    aria-label={copy.title}
    role="combobox"
    aria-expanded="true"
    aria-autocomplete="list"
    aria-controls="command-list"
  />
  <ol class="command-list" id="command-list" role="listbox" aria-label={copy.title} data-command-list></ol>
  <p class="command-empty" data-command-empty hidden>{copy.noResults}</p>
</dialog>

<script>
  import { navigate } from 'astro:transitions/client';
  import { registerPageInit } from '../lib/page-lifecycle';
  import { loadSiteIndex, type SiteIndex } from '../lib/site-index';
  import { siteConfig } from '../config/site';

  interface CommandItem { label: string; href: string; group: string; run?: () => void; }

  registerPageInit(() => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-command-palette]');
    const input = dialog?.querySelector<HTMLInputElement>('[data-command-input]');
    const list = dialog?.querySelector<HTMLElement>('[data-command-list]');
    const empty = dialog?.querySelector<HTMLElement>('[data-command-empty]');
    if (!dialog || !input || !list || !empty) return;

    const copy = siteConfig.ui.commandPalette;
    // 直达页面清单来自后台（chrome.json 的 commandPalette.pages），随配置进包，不占内联 JSON
    let commandItems: CommandItem[] = copy.pages.map((item) => ({ ...item, group: copy.pagesTitle }));
    // 文章/项目清单在打开面板时按需拉取；拉取失败时只保留页面清单与操作项
    let indexLoaded = false;
    let indexLoading = false;

    const applyIndex = (index: SiteIndex) => {
      commandItems = [
        ...index.pages.map((item) => ({ ...item, group: copy.pagesTitle })),
        ...index.articles.map((item) => ({ ...item, group: copy.postsTitle })),
        ...index.projects.map((item) => ({ ...item, group: copy.projectsTitle })),
      ];
      indexLoaded = true;
    };

    const ensureIndex = async () => {
      if (indexLoaded || indexLoading) return;
      indexLoading = true;
      const index = await loadSiteIndex();
      indexLoading = false;
      if (!index) return;
      applyIndex(index);
      // 清单到位后重绘当前结果，用户输入的关键词立即能匹配到文章与项目
      render();
    };

    const extraActions: { label: string; run: () => void }[] = [
      { label: siteConfig.search.label, run: () => {
        const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
        if (searchInput) searchInput.focus();
        else {
          try { sessionStorage.setItem('focus-search', '1'); } catch { /* ignore */ }
          navigate('/search/');
        }
      } },
      { label: siteConfig.ui.shortcuts.toggleTheme, run: () => {
        document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
      } },
      { label: siteConfig.ui.random.label, run: () => {
        document.querySelector<HTMLButtonElement>('[data-random-links]')?.click();
      } },
      { label: siteConfig.ui.shortcuts.helpLabel, run: () => {
        document.querySelector<HTMLButtonElement>('[data-shortcuts-open]')?.click();
      } },
    ];

    let matches: Array<{ label: string; href: string; group: string; run?: () => void }> = [];
    let itemNodes: HTMLElement[] = [];
    let active = -1;

    const setActive = (index: number) => {
      active = index;
      // 列表里混有分组标题，不能直接用 list.children 的下标，否则高亮会错位
      itemNodes.forEach((node, position) => {
        node.classList.toggle('is-active', position === index);
        node.setAttribute('aria-selected', String(position === index));
      });
      // aria-activedescendant 必须挂在 combobox（输入框）上，焦点在输入框时读屏才会播报当前项
      if (index >= 0 && itemNodes[index]) input.setAttribute('aria-activedescendant', itemNodes[index].id);
      else input.removeAttribute('aria-activedescendant');
      itemNodes[index]?.scrollIntoView({ block: 'nearest' });
    };

    // 打开前记录触发按钮，关闭后把焦点还回去，键盘用户不会掉回 body
    let lastTrigger: HTMLElement | null = null;

    const runItem = (item: { href: string; run?: () => void }) => {
      dialog.close();
      if (item.run) item.run();
      // 站内链接走 ClientRouter swap，保留过渡且命中预取；外链/无 href 不适用
      else if (item.href && item.href.startsWith('/')) navigate(item.href);
      else if (item.href) window.location.href = item.href;
    };

    const render = () => {
      const query = input.value.trim().toLowerCase();
      const linkMatches = commandItems.filter(
        (item) => !query || item.label.toLowerCase().includes(query) || item.href.includes(query),
      );
      const actionMatches = extraActions.filter((item) => !query || item.label.toLowerCase().includes(query));
      matches = [
        ...linkMatches.map((item) => ({ ...item })),
        ...actionMatches.map((item) => ({ label: item.label, href: '', run: item.run, group: copy.actionsTitle })),
      ];
      list.replaceChildren();
      itemNodes = [];
      let lastGroup = '';
      matches.forEach((item, index) => {
        if (item.group !== lastGroup) {
          const heading = document.createElement('li');
          heading.className = 'command-group';
          // listbox 的直接子元素只能是 option/group，分组标题降级为展示文本，避免被当成无效选项
          heading.setAttribute('role', 'presentation');
          heading.textContent = item.group;
          list.append(heading);
          lastGroup = item.group;
        }
        const node = document.createElement('li');
        node.textContent = item.label;
        // 结果项对读屏可见：稳定 id 供 aria-activedescendant 引用，option 语义声明可选中
        node.id = `command-item-${index}`;
        node.setAttribute('role', 'option');
        node.setAttribute('aria-selected', 'false');
        node.addEventListener('click', () => runItem(item));
        list.append(node);
        itemNodes.push(node);
      });
      empty.hidden = matches.length > 0;
      setActive(matches.length > 0 ? 0 : -1);
    };

    const onGlobalKeydown = (event: KeyboardEvent) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) {
          dialog.close();
          return;
        }
        // 其它模态（灯箱/截图弹窗/帮助面板）已打开时不叠加第二个浮层：
        // 原生 dialog 允许同时打开多个，会造成遮罩套遮罩、焦点错乱
        if (document.querySelector('dialog[open]')) return;
        // 移动端导航层展开时不叠加浮层，菜单是当前唯一交互上下文
        if (document.querySelector('.site-nav.is-open')) return;
        lastTrigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        input.value = '';
        render();
        dialog.showModal();
        input.focus();
        // 面板已可用，清单在后台补齐；到达后自动重绘
        void ensureIndex();
      }
    };

    const onInputKeydown = (event: KeyboardEvent) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        if (matches.length === 0) return;
        const step = event.key === 'ArrowDown' ? 1 : -1;
        setActive(active === -1 ? 0 : (active + step + matches.length) % matches.length);
        return;
      }
      const current = matches[active];
      if (event.key === 'Enter' && current) {
        event.preventDefault();
        runItem(current);
      }
    };

    dialog.querySelector('[data-command-input]')?.addEventListener('input', render);
    input.addEventListener('keydown', onInputKeydown);
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    // 关闭后归还焦点到打开前的元素（若它还在页面上）
    dialog.addEventListener('close', () => {
      const trigger = lastTrigger;
      if (trigger?.isConnected) trigger.focus({ preventScroll: true });
    });
    document.addEventListener('keydown', onGlobalKeydown);

    return () => {
      document.removeEventListener('keydown', onGlobalKeydown);
    };
  });
</script>

<style>
  .command-palette-trigger {
    position: fixed;
    z-index: 39;
    right: max(16px, calc((100vw - var(--content)) / 2 - 68px));
    bottom: 132px;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--muted);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: color 180ms ease, border-color 180ms ease;
  }

  .command-palette-trigger:hover { color: var(--ink-strong); border-color: var(--border-strong); }

  .command-dialog {
    width: min(560px, calc(100vw - 32px));
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-float);
  }

  .command-dialog::backdrop { background: rgba(0, 0, 0, 0.4); }

  .command-dialog input {
    width: 100%;
    height: 52px;
    padding: 0 20px;
    border: 0;
    border-bottom: 1px solid var(--border);
    color: var(--ink);
    background: transparent;
    /* 低于 16px 时 iOS 聚焦会自动放大页面，移动端输入后页面缩放错位 */
    font-size: 1rem;
  }

  /* 输入框已占满对话框，改用底部强调线提示焦点，避免 outline 被裁切 */
  .command-dialog input:focus { outline: none; border-bottom-color: var(--accent); }

  .command-list {
    max-height: min(50vh, 420px);
    margin: 0;
    padding: 8px;
    overflow-y: auto;
    /* 滚到底部后不要继续把滚动传给页面，移动端避免整页跟着滑动 */
    overscroll-behavior: contain;
    list-style: none;
  }

  .command-group {
    padding: 10px 12px 4px;
    color: var(--muted-weak);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .command-list li:not(.command-group) {
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .command-list li:not(.command-group):hover,
  .command-list li:not(.command-group).is-active { background: var(--surface-soft); color: var(--ink-strong); }

  /* 命令面板在手机上也能点开，列表项需要 44px 命中区 */
  @media (pointer: coarse) {
    .command-list li:not(.command-group) {
      display: flex;
      min-height: 44px;
      align-items: center;
    }
  }

  .command-empty { margin: 0; padding: 18px 20px 22px; color: var(--muted); font-size: 0.85rem; }
</style>
