---
import { siteConfig } from '../config/site';
import { formatCompactDate } from '../lib/date';
import TagList from './TagList.astro';

interface Props {
  type: 'article' | 'project';
  href: string;
  title: string;
  description: string;
  publishedAt: Date;
  meta?: string;
  tags?: readonly string[];
  featured?: boolean;
  /** View Transition 共享元素名：列表卡片 → 详情标题的同名动画；同名元素在一页内必须唯一 */
  transitionName?: string | undefined;
}

const {
  type,
  href,
  title,
  description,
  publishedAt,
  meta,
  tags = [],
  featured = false,
  transitionName,
} = Astro.props;
const label = type === 'project' ? 'PROJECT' : 'ARTICLE';
const date = formatCompactDate(publishedAt);
const copy = siteConfig.ui.contentCard;
---

<article class:list={['content-card', { 'content-card--featured': featured }]}>
  <a class="card-link" href={href} aria-label={copy.readAriaTemplate.replace('{title}', title)}><span></span></a>
  <div class="card-topline">
    <span>{label}</span>
    <button
      type="button"
      class="card-bookmark"
      data-bookmark
      data-bookmark-href={href}
      data-bookmark-title={title}
      data-bookmark-type={type}
      data-label-add={siteConfig.bookmarks.addLabel}
      data-label-added={siteConfig.bookmarks.addedLabel}
      data-announce-add={siteConfig.bookmarks.addedAnnounce}
      data-announce-remove={siteConfig.bookmarks.removedAnnounce}
      aria-label={siteConfig.bookmarks.addLabel}
      aria-pressed="false"
    >☆</button>
    <time datetime={publishedAt.toISOString()}>{date}</time>
  </div>
  <div class="card-main">
    <h3 {...(transitionName ? { 'transition:name': transitionName } : {})}>{title}</h3>
    <p>{description}</p>
  </div>
  <div class="card-footer">
    {tags.length > 0 && <TagList tags={tags} />}
    <span class="card-meta">{meta ?? copy.readFallback} <span aria-hidden="true">↗</span></span>
  </div>
  {/* 阅读进度条：有该页的阅读记录时由脚本填充，无记录保持隐藏 */}
  <div class="card-progress" data-card-progress hidden>
    <span class="card-progress__bar" data-card-progress-bar></span>
    <span class="card-progress__label" data-card-progress-label></span>
  </div>
</article>

<script>
  import { registerPageInit } from '../lib/page-lifecycle';
  import { siteConfig } from '../config/site';

  const BOOKMARK_KEY = 'site-bookmarks';
  const readBookmarks = () => {
    try {
      const raw = JSON.parse(localStorage.getItem(BOOKMARK_KEY) ?? '[]');
      return Array.isArray(raw) ? raw : [];
    } catch { return []; }
  };
  const writeBookmarks = (list: unknown[]) => {
    try { localStorage.setItem(BOOKMARK_KEY, JSON.stringify(list)); } catch { /* ignore */ }
  };
  registerPageInit(() => {
    const announce = document.querySelector('[data-copy-announcer]');
    const cleanups: Array<() => void> = [];

    // —— 卡片阅读进度：与 ReadingProgress 共用 site-reading-positions ——
    const readPositions = (): Record<string, { ratio?: number; at?: number }> => {
      try {
        const raw = JSON.parse(localStorage.getItem('site-reading-positions') ?? '{}');
        return raw && typeof raw === 'object' ? raw : {};
      } catch { return {}; }
    };
    const positions = readPositions();
    document.querySelectorAll<HTMLElement>('[data-card-progress]').forEach((bar) => {
      const card = bar.closest('article');
      const link = card?.querySelector<HTMLAnchorElement>('.card-link');
      const entry = link ? positions[link.pathname] : undefined;
      const ratio = typeof entry?.ratio === 'number' ? entry.ratio : undefined;
      // 5% 以下视为没读，不展示，避免「点开就退出」也带一条进度
      if (ratio === undefined || ratio < 0.05) return;
      const percent = Math.min(99, Math.max(1, Math.round(ratio * 100)));
      const fill = bar.querySelector<HTMLElement>('[data-card-progress-bar]');
      const labelNode = bar.querySelector<HTMLElement>('[data-card-progress-label]');
      if (fill) fill.style.setProperty('--progress', `${percent}%`);
      if (labelNode) labelNode.textContent = siteConfig.ui.contentCard.progressTemplate
        .replace('{percent}', String(percent));
      bar.hidden = false;
    });

    document.querySelectorAll<HTMLButtonElement>('[data-bookmark]').forEach((button) => {
      const href = button.dataset.bookmarkHref ?? '';
      const update = () => {
        const saved = readBookmarks().some((item) => item.href === href);
        button.setAttribute('aria-pressed', String(saved));
        button.textContent = saved ? '★' : '☆';
        button.setAttribute('aria-label', saved ? button.dataset.labelAdded ?? '' : button.dataset.labelAdd ?? '');
      };
      update();
      const onClick = () => {
        const list = readBookmarks();
        const index = list.findIndex((item) => item.href === href);
        if (index >= 0) {
          list.splice(index, 1);
          if (announce) announce.textContent = button.dataset.announceRemove ?? '';
        } else {
          list.push({
            href,
            title: button.dataset.bookmarkTitle ?? '',
            type: button.dataset.bookmarkType ?? 'article',
          });
          if (announce) announce.textContent = button.dataset.announceAdd ?? '';
        }
        writeBookmarks(list);
        update();
      };
      button.addEventListener('click', onClick);
      cleanups.push(() => button.removeEventListener('click', onClick));
    });

    return () => cleanups.forEach((cleanup) => cleanup());
  });
</script>

<style>
  .content-card {
    position: relative;
    display: flex;
    min-height: 288px;
    overflow: hidden;
    flex-direction: column;
    justify-content: space-between;
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .content-card:hover {
    border-color: var(--border-strong);
  }

  .content-card--featured {
    border-color: transparent;
    background: var(--surface-soft);
  }

  .content-card--featured:hover {
    border-color: var(--border);
  }

  .card-link {
    position: absolute;
    z-index: 2;
    inset: 0;
  }

  /* 整卡链接的焦点环默认画在盒外，会被卡片 overflow:hidden 裁掉；改为向内收 */
  .card-link:focus-visible {
    border-radius: inherit;
    outline-offset: -4px;
  }

  .card-topline,
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .card-topline {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.18em;
  }

  /* 收藏按钮压在整卡链接之上，否则点击只会跳走 */
  .content-card :global(.card-bookmark) {
    position: relative;
    z-index: 3;
    margin-left: auto;
    min-width: 44px;
    min-height: 44px;
    /* 负外边距抵消 44px 盒子对顶部行高的影响，视觉密度保持不变 */
    margin-block: -6px;
    padding: 0 4px;
    border: 0;
    color: var(--muted-weak);
    background: transparent;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    transition: color 180ms ease, transform 180ms ease;
  }

  .content-card :global(.card-bookmark:hover) { color: var(--accent); transform: scale(1.1); }
  .content-card :global(.card-bookmark[aria-pressed='true']) { color: var(--accent); }

  .card-main {
    margin-block: 44px 36px;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    line-height: 1.22;
  }

  p {
    max-width: 600px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.72;
  }

  .card-footer {
    align-items: flex-end;
  }

  .card-meta {
    flex: none;
    color: var(--muted);
    font-size: 0.76rem;
  }

  /* 卡片底部阅读进度条：默认 hidden，有阅读记录才显示 */
  .card-progress {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 22px;
    padding-inline: 26px;
    background: var(--surface-soft);
  }

  .content-card--featured .card-progress { background: var(--surface); }

  .card-progress[hidden] { display: none; }

  .card-progress__bar {
    flex: 1;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--border);
    overflow: hidden;
    position: relative;
  }

  .card-progress__bar::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--progress, 0%);
    background: var(--accent);
  }

  .card-progress__label {
    flex: none;
    color: var(--muted);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .content-card :global(.tag-list) {
    position: relative;
    z-index: 3;
  }

  @media (max-width: 640px) {
    .content-card {
      min-height: 250px;
      padding: 20px;
    }

    .card-main {
      margin-block: 36px 28px;
    }

    .card-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
