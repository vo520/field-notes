---
import { siteConfig } from '../config/site';
import { formatCompactDate } from '../lib/date';
import TagList from './TagList.astro';

interface Props {
  type: 'article' | 'project';
  href: string;
  title: string;
  description: string;
  publishedAt: Date;
  meta?: string;
  tags?: readonly string[];
  featured?: boolean;
}

const {
  type,
  href,
  title,
  description,
  publishedAt,
  meta,
  tags = [],
  featured = false,
} = Astro.props;
const label = type === 'project' ? 'PROJECT' : 'ARTICLE';
const date = formatCompactDate(publishedAt);
const copy = siteConfig.ui.contentCard;
---

<article class:list={['content-card', { 'content-card--featured': featured }]}>
  <a class="card-link" href={href} aria-label={copy.readAriaTemplate.replace('{title}', title)}><span></span></a>
  <div class="card-topline">
    <span>{label}</span>
    <time datetime={publishedAt.toISOString()}>{date}</time>
  </div>
  <div class="card-main">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <div class="card-footer">
    {tags.length > 0 && <TagList tags={tags} />}
    <span class="card-meta">{meta ?? copy.readFallback} <span aria-hidden="true">↗</span></span>
  </div>
</article>

<style>
  .content-card {
    position: relative;
    display: flex;
    min-height: 288px;
    overflow: hidden;
    flex-direction: column;
    justify-content: space-between;
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .content-card:hover {
    border-color: var(--border-strong);
  }

  .content-card--featured {
    border-color: transparent;
    background: var(--surface-soft);
  }

  .content-card--featured:hover {
    border-color: var(--border);
  }

  .card-link {
    position: absolute;
    z-index: 2;
    inset: 0;
  }

  /* 整卡链接的焦点环默认画在盒外，会被卡片 overflow:hidden 裁掉；改为向内收 */
  .card-link:focus-visible {
    border-radius: inherit;
    outline-offset: -4px;
  }

  .card-topline,
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .card-topline {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.18em;
  }

  .card-main {
    margin-block: 44px 36px;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    line-height: 1.22;
  }

  p {
    max-width: 600px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.72;
  }

  .card-footer {
    align-items: flex-end;
  }

  .card-meta {
    flex: none;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .content-card :global(.tag-list) {
    position: relative;
    z-index: 3;
  }

  @media (max-width: 640px) {
    .content-card {
      min-height: 250px;
      padding: 20px;
    }

    .card-main {
      margin-block: 36px 28px;
    }

    .card-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
