---
/**
 * 写作热力图：过去 365 天按发布日期聚合文章数。
 * 纯 SSR 计算，零运行时依赖；按周列、按日行排布，空格补在首尾保证列对齐。
 */
import type { CollectionEntry } from 'astro:content';

import { siteConfig } from '../config/site';

interface Props {
  articles: CollectionEntry<'articles'>[];
}

const { articles } = Astro.props;
const copy = siteConfig.about.heatmap;

// 以今天为终点回溯 365 天，按本地日历日归一（publishedAt 是 Date）
const today = new Date();
today.setHours(0, 0, 0, 0);
const start = new Date(today);
start.setDate(start.getDate() - 364);

const counts = new Map<string, number>();
for (const article of articles) {
  const day = new Date(article.data.publishedAt);
  day.setHours(0, 0, 0, 0);
  const key = `${day.getFullYear()}-${String(day.getMonth() + 1).padStart(2, '0')}-${String(day.getDate()).padStart(2, '0')}`;
  counts.set(key, (counts.get(key) ?? 0) + 1);
}

const days: { key: string; date: Date; count: number }[] = [];
for (let i = 0; i < 365; i += 1) {
  const date = new Date(start);
  date.setDate(start.getDate() + i);
  const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
  days.push({ key, date, count: counts.get(key) ?? 0 });
}
const total = days.reduce((sum, day) => sum + day.count, 0);
const max = Math.max(1, ...days.map((day) => day.count));
// 每列从周日开始；补首空到第一个周日
const leadingBlanks = days[0]?.date.getDay() ?? 0;
const level = (count: number) => (count === 0 ? 0 : Math.max(1, Math.ceil((count / max) * 4)));

// —— 站点统计：文章数 / 字数（粗估）/ 标签数 / 最长连续写作天数，纯 SSR ——
const wordCount = articles.reduce((sum, article) => {
  const text = (article.body ?? '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`[^`]*`/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');
  const cjk = text.match(/[\u4e00-\u9fa5]/g)?.length ?? 0;
  const latin = text.match(/[A-Za-z0-9]+/g)?.length ?? 0;
  return sum + cjk + latin;
}, 0);
const wordUnits = Math.max(1, Math.round(wordCount / 10000));
const tagCount = new Set(articles.flatMap((article) => article.data.tags ?? [])).size;
const dayStamps = [...new Set(
  articles.map((article) => {
    const day = new Date(article.data.publishedAt);
    day.setHours(0, 0, 0, 0);
    return day.getTime();
  }),
)].sort((a, b) => a - b);
let streak = dayStamps.length > 0 ? 1 : 0;
let current = 1;
for (let i = 1; i < dayStamps.length; i += 1) {
  current = dayStamps[i]! - dayStamps[i - 1]! === 86_400_000 ? current + 1 : 1;
  streak = Math.max(streak, current);
}
const articleCount = articles.length;

// —— 年度对比：按发布年份聚合，条形宽度按最大年归一 ——
const yearCounts = new Map<number, number>();
for (const article of articles) {
  const year = new Date(article.data.publishedAt).getFullYear();
  yearCounts.set(year, (yearCounts.get(year) ?? 0) + 1);
}
const years = [...yearCounts.entries()].sort(([a], [b]) => b - a).slice(0, 5);
const yearMax = Math.max(1, ...years.map(([, count]) => count));
// 月份标签按「列」定位：一天占一格，7 天一列，需把天序号换算成列号，否则标签会逐月向右漂移
const monthLabels = days
  .map((day, index) => ({ month: day.date.getMonth(), col: Math.floor((index + leadingBlanks) / 7) }))
  .filter((entry, index, all) => index === 0 || entry.month !== all[index - 1]!.month);
---

<section class="writing-heatmap" aria-labelledby="writing-heatmap-title" data-reveal>
  <p class="eyebrow">{copy.eyebrow}</p>
  <h2 id="writing-heatmap-title">{copy.title}</h2>
  <p class="writing-heatmap__intro">{copy.description}</p>
  {total > 0 ? (
    <div class="writing-heatmap__total">{copy.totalTemplate.replace('{count}', String(total))}</div>
  ) : (
    <p class="writing-heatmap__empty">{copy.empty}</p>
  )}
  <div class="writing-heatmap__scroll">
    <div class="writing-heatmap__months" aria-hidden="true">
      {monthLabels.map((entry) => (
        <span style={`--month-col: ${entry.col}`}>{entry.month + 1}月</span>
      ))}
    </div>
    <div class="writing-heatmap__grid" role="img" aria-label={`${copy.title}：${copy.totalTemplate.replace('{count}', String(total))}`}>
      {Array.from({ length: leadingBlanks }, () => <span class="writing-heatmap__blank" />)}
      {days.map((day) => (
        <span
          class="writing-heatmap__cell"
          data-level={level(day.count)}
          title={`${day.key}：${day.count} ${copy.unit}`}
        />
      ))}
    </div>
    <div class="writing-heatmap__legend" aria-hidden="true">
      <span>{copy.less}</span>
      {[0, 1, 2, 3, 4].map((step) => <span class="writing-heatmap__cell" data-level={step} />)}
      <span>{copy.more}</span>
    </div>
  </div>

  {articleCount > 0 && (
    <div class="writing-heatmap__stats" aria-label={copy.statsAriaLabel}>
      <div><strong>{copy.articlesTemplate.replace('{count}', String(articleCount))}</strong></div>
      <div><strong>{copy.wordsTemplate.replace('{count}', String(wordUnits))}</strong></div>
      <div><strong>{copy.tagsTemplate.replace('{count}', String(tagCount))}</strong></div>
      <div><strong>{copy.streakTemplate.replace('{count}', String(streak))}</strong></div>
    </div>
  )}

  {years.length > 1 && (
    <div class="writing-heatmap__years">
      <h3>{copy.yearsTitle}</h3>
      {years.map(([year, count]) => (
        <div class="writing-heatmap__year">
          <span>{copy.yearCountTemplate.replace('{year}', String(year)).replace('{count}', String(count))}</span>
          <div class="writing-heatmap__year-track" aria-hidden="true">
            <div class="writing-heatmap__year-bar" style={`--year-ratio: ${count / yearMax}`} />
          </div>
        </div>
      ))}
    </div>
  )}
</section>

<style>
  .writing-heatmap {
    margin-top: 64px;
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  h2 { margin: 10px 0 0; font-size: 1.6rem; }
  .writing-heatmap__intro { max-width: 620px; margin: 10px 0 0; color: var(--muted); font-size: 0.9rem; line-height: 1.7; }
  .writing-heatmap__total { margin: 18px 0 8px; color: var(--ink-strong); font-size: 0.9rem; font-weight: 600; }
  .writing-heatmap__empty { margin: 18px 0 0; color: var(--muted); }

  .writing-heatmap__scroll { overflow-x: auto; padding-bottom: 6px; }

  .writing-heatmap__grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 12px);
    gap: 4px;
    width: max-content;
  }

  .writing-heatmap__cell,
  .writing-heatmap__blank { width: 12px; height: 12px; border-radius: 2px; }
  .writing-heatmap__blank { visibility: hidden; }

  .writing-heatmap__cell[data-level='0'] { background: var(--surface-soft); }
  .writing-heatmap__cell[data-level='1'] { background: color-mix(in srgb, var(--accent) 25%, var(--surface-soft)); }
  .writing-heatmap__cell[data-level='2'] { background: color-mix(in srgb, var(--accent) 50%, var(--surface-soft)); }
  .writing-heatmap__cell[data-level='3'] { background: color-mix(in srgb, var(--accent) 75%, var(--surface-soft)); }
  .writing-heatmap__cell[data-level='4'] { background: var(--accent); }

  .writing-heatmap__months {
    position: relative;
    height: 20px;
    margin-left: 0;
    width: max-content;
  }

  .writing-heatmap__months span {
    position: absolute;
    left: calc(var(--month-col) * 16px);
    color: var(--muted);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .writing-heatmap__legend {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.74rem;
  }

  .writing-heatmap__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin-top: 22px;
  }

  .writing-heatmap__stats div {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-soft);
    color: var(--muted);
    font-size: 0.78rem;
  }

  .writing-heatmap__stats strong {
    display: block;
    margin-top: 4px;
    color: var(--ink-strong);
    font-size: 0.92rem;
  }

  .writing-heatmap__years { margin-top: 26px; }

  .writing-heatmap__years h3 {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  .writing-heatmap__year {
    display: grid;
    grid-template-columns: minmax(120px, auto) minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    padding-block: 5px;
  }

  .writing-heatmap__year span {
    color: var(--muted);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .writing-heatmap__year-track {
    height: 8px;
    border-radius: 4px;
    background: var(--surface-soft);
    overflow: hidden;
  }

  .writing-heatmap__year-bar {
    width: calc(var(--year-ratio, 0) * 100%);
    height: 100%;
    border-radius: 4px;
    background: var(--accent);
  }
</style>
