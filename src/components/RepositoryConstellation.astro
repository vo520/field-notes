---
import type { ProjectData } from '../lib/project-schema';
import { siteConfig } from '../config/site';

interface Props {
  repositories: NonNullable<ProjectData['repositories']>;
}

const { repositories } = Astro.props;
const copy = siteConfig.projectPage.repository;
const roleLabels = copy.roles;
---

{repositories.length > 0 && (
  <ul class="repository-constellation" aria-label={copy.listAriaLabel}>
    {repositories.map((repository) => (
      <li class="repository-node">
        <article>
          <div class="repository-node__heading">
            <span class="repository-node__role">{roleLabels[repository.role]}</span>
            <h3>{repository.name}</h3>
          </div>
          <p>{repository.description}</p>
          <ul class="repository-node__tech" aria-label={copy.techAriaTemplate.replace('{name}', repository.name)}>
            {repository.tech.map((technology) => <li>{technology}</li>)}
          </ul>
          <a href={repository.url} target="_blank" rel="noopener noreferrer">
            {copy.sourceLinkTemplate.replace('{role}', roleLabels[repository.role])} <span aria-hidden="true">↗</span>
          </a>
        </article>
      </li>
    ))}
  </ul>
)}

<style>
  .repository-constellation {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .repository-node {
    min-width: 0;
  }

  .repository-node article {
    display: flex;
    height: 100%;
    min-height: 260px;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .repository-node__heading {
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }

  .repository-node__role {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h3 {
    overflow-wrap: anywhere;
    margin: 9px 0 0;
    font-size: clamp(1.18rem, 2vw, 1.42rem);
    line-height: 1.25;
  }

  p {
    margin: 18px 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .repository-node__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0 0 22px;
    padding: 0;
    color: var(--muted);
    font-size: 0.76rem;
    list-style: none;
  }

  .repository-node__tech li:not(:last-child)::after {
    margin-left: 16px;
    color: var(--border);
    content: '/';
  }

  .repository-node a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    color: var(--ink);
    font-size: 0.86rem;
    text-decoration: none;
  }

  .repository-node a:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 1024px) {
    .repository-constellation {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .repository-node article {
      min-height: 0;
    }
  }
</style>
