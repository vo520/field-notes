---
import type { CollectionEntry } from 'astro:content';

import { siteConfig } from '../config/site';

interface Props {
  previous?: CollectionEntry<'articles'> | undefined;
  next?: CollectionEntry<'articles'> | undefined;
}

const { previous, next } = Astro.props;
---

{(previous || next) && (
  <nav class="article-nav" aria-label={siteConfig.articlePage.pagerAriaLabel}>
    {previous ? (
      <a href={`/articles/${previous.id}/`}>
        <span>{siteConfig.articlePage.prevLabel}</span>
        <strong>{previous.data.title}</strong>
      </a>
    ) : <span></span>}
    {next && (
      <a class="next" href={`/articles/${next.id}/`}>
        <span>{siteConfig.articlePage.nextLabel}</span>
        <strong>{next.data.title}</strong>
      </a>
    )}
  </nav>
)}

<style>
  .article-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 68px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  a {
    display: flex;
    min-height: 104px;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 180ms ease;
  }

  a:hover { border-color: var(--border-strong); color: var(--ink-strong); }
  a.next { text-align: right; }

  span { color: var(--muted); font-size: 0.76rem; }
  strong { line-height: 1.4; }

  @media (max-width: 640px) {
    .article-nav { grid-template-columns: 1fr; }
  }
</style>
