---
/**
 * 全站键盘快捷键：? 帮助面板、j/k 文章翻页、t 切主题。
 * 只在可打字的元素外生效；带 44px 帮助按钮，触屏也能打开说明。
 */
import { siteConfig } from '../config/site';

const copy = siteConfig.ui.shortcuts;
---

<button
  type="button"
  class="shortcuts-trigger"
  data-shortcuts-open
  aria-label={copy.helpLabel}
  title={copy.helpLabel}
>?</button>

<dialog class="shortcuts-dialog" data-shortcuts-dialog aria-labelledby="shortcuts-title">
  <div class="shortcuts-dialog__inner">
    <header>
      <h2 id="shortcuts-title">{copy.title}</h2>
      <button type="button" data-shortcuts-close aria-label={copy.closeLabel}>×</button>
    </header>
    <p class="shortcuts-dialog__intro">{copy.intro}</p>
    <dl>
      <div><dt>⌘K / Ctrl+K</dt><dd>{copy.commandPalette}</dd></div>
      <div><dt>/</dt><dd>{copy.openSearch}</dd></div>
      <div><dt>J / K</dt><dd>{copy.prevNext}</dd></div>
      <div><dt>T</dt><dd>{copy.toggleTheme}</dd></div>
      <div><dt>G → H</dt><dd>{copy.gotoHome}</dd></div>
      <div><dt>G → A</dt><dd>{copy.gotoAbout}</dd></div>
      <div><dt>G → P</dt><dd>{copy.gotoProjects}</dd></div>
      <div><dt>G → S</dt><dd>{copy.gotoSearch}</dd></div>
      <div><dt>?</dt><dd>{copy.help}</dd></div>
      <div><dt>Esc</dt><dd>{copy.closeLabel}</dd></div>
    </dl>
    <p class="shortcuts-dialog__note">{copy.note}</p>
  </div>
</dialog>

<script>
  import { navigate } from 'astro:transitions/client';
  import { registerPageInit } from '../lib/page-lifecycle';

  registerPageInit(() => {
    const dialog = document.querySelector('[data-shortcuts-dialog]');
    const openButton = document.querySelector('[data-shortcuts-open]');
    const closeButton = document.querySelector('[data-shortcuts-close]');
    if (!(dialog instanceof HTMLDialogElement)) return;

    const isTypingTarget = (target: EventTarget | null) => {
      if (!(target instanceof HTMLElement)) return false;
      return ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) || target.isContentEditable;
    };

    // g 前缀序列的按下时间戳；0 表示当前没有待完成的序列
    let pendingGoto = 0;

    // 与命令面板/灯箱一致：记录打开来源，关闭后归还焦点，键盘用户不会掉回 body
    let lastTrigger: HTMLElement | null = null;
    const openHelp = () => {
      if (dialog.open) return;
      const active = document.activeElement;
      // 从命令面板的动作进入时，其输入框所在的 dialog 已关闭；若把它记成返回目标，
      // 关闭帮助后焦点会落回不可见元素。此时改用页面上常驻的帮助按钮。
      lastTrigger = active instanceof HTMLElement && active.isConnected
        && !active.closest('dialog:not([open])')
        ? active
        : document.querySelector<HTMLElement>('[data-shortcuts-open]');
      dialog.showModal();
    };
    const onClose = () => dialog.close();
    const onDialogClick = (event: MouseEvent) => { if (event.target === dialog) dialog.close(); };
    const onKeydown = (event: KeyboardEvent) => {
      // 任意模态（帮助面板/灯箱/命令面板）打开时都不抢按键：
      // 否则会在遮罩后切主题、跳页，或叠加第二个模态
      if (dialog.open || document.querySelector('dialog[open]')) return;
      // 移动端导航层展开时同样让位：菜单是当前唯一的交互上下文，
      // 此刻切主题/跳页会让用户丢失位置
      if (document.querySelector('.site-nav.is-open')) return;
      if (event.metaKey || event.ctrlKey || event.altKey || event.repeat || event.isComposing) return;
      if (isTypingTarget(event.target)) return;

      const key = event.key;
      if (key === '?' || (key === '/' && event.shiftKey)) {
        event.preventDefault();
        openHelp();
        return;
      }
      if (key === 't' || key === 'T') {
        const themeToggle = document.querySelector('[data-theme-toggle]');
        if (themeToggle instanceof HTMLButtonElement) themeToggle.click();
        return;
      }
      if (key === 'g' || key === 'G') {
        // g 前缀序列：g 之后 1.5s 内按 h/a/p/s 跳到对应页面（vim 风格）
        pendingGoto = Date.now();
        return;
      }
      if (pendingGoto > 0 && Date.now() - pendingGoto <= 1500) {
        const gotoTargets: Record<string, string> = {
          h: '/',
          a: '/about/',
          p: '/projects/',
          s: '/search/',
        };
        const href = gotoTargets[key.toLowerCase()];
        if (href) {
          pendingGoto = 0;
          event.preventDefault();
          // 走 ClientRouter 的 swap 导航，保留 View Transitions 过渡；整页 location.href 会白刷新
          navigate(href);
          return;
        }
      }
      pendingGoto = 0;
      if (key === 'j' || key === 'J' || key === 'k' || key === 'K') {
        // 按方向找明确的链接：首篇没有上一篇、末篇没有下一篇时，
        // 不能回退成「取仅剩的一条」，否则 j/k 会跳到同一篇。
        const forward = key === 'j' || key === 'J';
        const selector = forward ? '.article-nav a.next' : '.article-nav a:not(.next)';
        const target = document.querySelector<HTMLAnchorElement>(selector);
        if (!target) return;
        event.preventDefault();
        // 模拟真实点击：ClientRouter 会拦截站内链接，配合预取做瞬时过渡
        target.click();
      }
    };

    openButton?.addEventListener('click', openHelp);
    closeButton?.addEventListener('click', onClose);
    dialog.addEventListener('click', onDialogClick);
    dialog.addEventListener('close', () => {
      const trigger = lastTrigger;
      if (trigger?.isConnected) trigger.focus({ preventScroll: true });
    });
    document.addEventListener('keydown', onKeydown);

    return () => {
      openButton?.removeEventListener('click', openHelp);
      closeButton?.removeEventListener('click', onClose);
      dialog.removeEventListener('click', onDialogClick);
      document.removeEventListener('keydown', onKeydown);
    };
  });
</script>

<style>
  .shortcuts-trigger {
    position: fixed;
    z-index: 39;
    right: max(16px, calc((100vw - var(--content)) / 2 - 68px));
    bottom: 84px;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--muted);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: color 180ms ease, border-color 180ms ease;
  }

  .shortcuts-trigger:hover {
    color: var(--ink-strong);
    border-color: var(--border-strong);
  }

  .shortcuts-dialog {
    width: min(420px, calc(100vw - 32px));
    /* 10 条快捷键在手机上会超出视口，必须限高并允许内部滚动，否则底部条目点不到 */
    max-height: calc(100vh - 32px);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--ink);
    background: var(--surface);
    box-shadow: var(--shadow-float);
  }

  .shortcuts-dialog::backdrop { background: rgba(0, 0, 0, 0.4); }

  /* 帮助面板同样是可滚动浮层，打开时锁住背景，避免正文从遮罩后滑走 */
  :global(html:has(.shortcuts-dialog[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  .shortcuts-dialog__inner { padding: 26px; }

  .shortcuts-dialog header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .shortcuts-dialog h2 { margin: 0; font-size: 1.35rem; }

  .shortcuts-dialog header button {
    min-width: 44px;
    min-height: 44px;
    border: 0;
    color: var(--muted);
    background: transparent;
    font-size: 1.5rem;
    cursor: pointer;
  }

  .shortcuts-dialog__intro {
    margin: 12px 0 22px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .shortcuts-dialog dl { margin: 0; display: grid; gap: 12px; }

  .shortcuts-dialog dl div {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
  }

  .shortcuts-dialog dt {
    padding: 6px 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--ink-strong);
    background: var(--surface-soft);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    text-align: center;
  }

  .shortcuts-dialog dd { margin: 0; font-size: 0.9rem; }

  .shortcuts-dialog__note {
    margin: 24px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    color: var(--muted-weak);
    font-size: 0.78rem;
    line-height: 1.6;
  }
</style>
