---
import { toTagSlug } from '../lib/content';

interface Props {
  tags: readonly string[];
  linked?: boolean;
}

const { tags, linked = false } = Astro.props;
---

<ul class="tag-list" data-linked={linked || undefined} aria-label="标签">
  {tags.map((tag) => (
    <li>
      {linked ? <a href={`/tags/${toTagSlug(tag)}/`}>{tag}</a> : <span>{tag}</span>}
    </li>
  ))}
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list :global(a),
  .tag-list :global(span) {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 11px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    background: transparent;
    font-size: 0.72rem;
    line-height: 1.6;
    text-decoration: none;
    transition: color 180ms ease, border-color 180ms ease;
  }

  /* 可点击 tag（linked=true：文章页、链接到 /tags/*）需要 44px 触控 */
  .tag-list[data-linked] :global(a) {
    min-height: 44px;
    padding: 8px 14px;
  }

  .tag-list :global(a:hover) {
    color: var(--ink-strong);
    border-color: var(--border-strong);
  }
</style>
