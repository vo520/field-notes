---
import { siteConfig } from '../config/site';
import { toTagSlug } from '../lib/content';

interface Props {
  tags: readonly string[];
  linked?: boolean;
  /** 可选链接模板：传 '/stacks/{slug}/' 时标签指向技术专题页；不传则沿用 /tags/ 的默认行为 */
  hrefTemplate?: string;
}

const { tags, linked = false, hrefTemplate } = Astro.props;
const hrefFor = (tag: string) => {
  const slug = toTagSlug(tag);
  return hrefTemplate ? hrefTemplate.replace('{slug}', slug) : `/tags/${slug}/`;
};
// 同一标签的不同写法（如 Astro / astro）会指向同一个标签页，渲染成多个入口只会让访客困惑。
// 与 groupBySlug 保持同一取舍：保留首次出现的写法，标签页标题才不会随标签顺序漂移。
const seenSlugs = new Set<string>();
const uniqueTags = tags.filter((tag) => {
  const slug = toTagSlug(tag);
  if (seenSlugs.has(slug)) return false;
  seenSlugs.add(slug);
  return true;
});
---

<ul class="tag-list" data-linked={linked || undefined} aria-label={siteConfig.ui.tagListAriaLabel}>
  {uniqueTags.map((tag) => (
    <li>
      {linked ? <a href={hrefFor(tag)}>{tag}</a> : <span>{tag}</span>}
    </li>
  ))}
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list :global(a),
  .tag-list :global(span) {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 11px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    background: transparent;
    font-size: 0.72rem;
    line-height: 1.6;
    text-decoration: none;
    transition: color 180ms ease, border-color 180ms ease;
  }

  /* 可点击 tag（linked=true：文章页、链接到 /tags/*）需要 44px 触控 */
  .tag-list[data-linked] :global(a) {
    min-height: 44px;
    padding: 8px 14px;
  }

  .tag-list :global(a:hover) {
    color: var(--ink-strong);
    border-color: var(--border-strong);
  }
</style>
