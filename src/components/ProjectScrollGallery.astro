---
/**
 * 滚动驱动的精选项目画廊：桌面精确指针下 sticky 视口随滚动进度切换项目，
 * 移动端 / 减动效 / 无 JS 一律降级为普通纵向列表。
 * 只做视觉呈现，所有项目链接与文案均来自传入数据，不引入硬编码。
 */
import { siteConfig } from '../config/site';

interface GalleryProject {
  id: string;
  title: string;
  description: string;
  cover: string | undefined;
}

interface Props {
  projects: GalleryProject[];
}

const { projects } = Astro.props;
const enabled = projects.length > 1;
---

{enabled && (
  <section class="scroll-gallery" data-scroll-gallery data-pagefind-ignore aria-label={siteConfig.home.projectsSection.title} style={`--gallery-count: ${projects.length}`}>
    <div class="scroll-gallery__viewport" data-gallery-viewport>
      {projects.map((project, index) => (
        <article class="scroll-gallery__panel" data-gallery-panel>
          <div class="scroll-gallery__media">
            {project.cover
              ? <img src={project.cover} alt="" width="1440" height="900" loading="lazy" decoding="async" />
              : <span class="scroll-gallery__placeholder" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
          </div>
          <div class="scroll-gallery__copy">
            <span class="scroll-gallery__index" aria-hidden="true">{String(index + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <a class="scroll-gallery__link" href={`/projects/${project.id}/`}>{siteConfig.home.projectsSection.cta} →</a>
          </div>
        </article>
      ))}
      <div class="scroll-gallery__dots" data-gallery-dots aria-hidden="true">
        {projects.map((_, index) => <span data-gallery-dot class:list={{ active: index === 0 }}></span>)}
      </div>
      <div class="scroll-gallery__track" data-gallery-track aria-hidden="true"><span data-gallery-fill></span></div>
    </div>
  </section>
)}

<script>
  import { registerPageInit } from '../lib/page-lifecycle';

  registerPageInit(async () => {
    if (!document.querySelector('[data-scroll-gallery]')) return;
    const { canUseStickyMotion, clamp01, easeOutQuad, observeStageProgress } = await import('../lib/stage-progress');
    if (!canUseStickyMotion()) return;
    const root = document.querySelector<HTMLElement>('[data-scroll-gallery]');
    if (!root) return;

    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-gallery-panel]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-gallery-dot]'));
    if (panels.length < 2) return;

    root.dataset.active = '1';
    let current = 0;

    // 单个面板内的 0~1 局部进度驱动镜头推近与文案位移，模拟 x500 的 scrub 时间线
    const apply = (progress: number) => {
      const segment = progress * panels.length;
      const index = Math.min(panels.length - 1, Math.floor(segment));
      const local = clamp01(segment - index);
      root.style.setProperty('--gallery-progress', progress.toFixed(4));
      panels[index]?.style.setProperty('--panel-local', easeOutQuad(local).toFixed(4));
      if (index === current) return;

      current = index;
      panels.forEach((panel, i) => {
        panel.classList.toggle('is-current', i === index);
        if (i !== index) panel.style.setProperty('--panel-local', '0');
      });
      dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
    };

    panels[0]?.classList.add('is-current');
    return observeStageProgress(root, apply);
  });
</script>

<style>
  .scroll-gallery {
    padding-block: clamp(48px, 7vw, 88px);
  }

  .scroll-gallery__viewport {
    position: relative;
  }

  .scroll-gallery__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
    padding-block: 18px;
    border-bottom: 1px solid var(--border);
  }

  .scroll-gallery__media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
  }

  .scroll-gallery__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scroll-gallery__placeholder {
    color: var(--muted-weak);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 300;
    letter-spacing: 0.08em;
  }

  .scroll-gallery__copy {
    min-width: 0;
  }

  .scroll-gallery__index {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
  }

  .scroll-gallery__copy h3 {
    margin: 14px 0 0;
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    line-height: 1.15;
  }

  .scroll-gallery__copy p {
    margin: 16px 0 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .scroll-gallery__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-top: 18px;
    color: var(--ink);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .scroll-gallery__link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .scroll-gallery__dots,
  .scroll-gallery__track {
    display: none;
  }

  /* 仅桌面精确指针启用 sticky 切换：外层撑高，视口钉住，面板叠放按进度切换 */
  [data-scroll-gallery][data-active='1'] {
    height: calc(var(--gallery-count, 3) * 100vh);
  }

  [data-scroll-gallery][data-active='1'] .scroll-gallery__viewport {
    position: sticky;
    top: calc(var(--header-height) + 24px + var(--sat, 0px));
    height: calc(100vh - var(--header-height) - 48px);
    overflow: hidden;
  }

  [data-scroll-gallery][data-active='1'] .scroll-gallery__panel {
    position: absolute;
    inset: 0;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    padding-block: 0;
    border-bottom: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px);
    transition: opacity 320ms ease, transform 320ms ease, visibility 320ms ease;
  }

  [data-scroll-gallery][data-active='1'] .scroll-gallery__panel.is-current {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  [data-scroll-gallery][data-active='1'] .scroll-gallery__dots {
    position: absolute;
    right: 0;
    bottom: 12px;
    left: 0;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  [data-scroll-gallery][data-active='1'] [data-gallery-dot] {
    width: 20px;
    height: 3px;
    border-radius: 999px;
    background: var(--border-strong);
    transition: background 220ms ease;
  }

  [data-scroll-gallery][data-active='1'] [data-gallery-dot].active {
    background: var(--accent);
  }

  [data-scroll-gallery][data-active='1'] .scroll-gallery__track {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    height: 2px;
    background: var(--border);
  }

  [data-scroll-gallery][data-active='1'] [data-gallery-fill] {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--gallery-progress, 0));
    transform-origin: left center;
  }

  /* 面板内 scrub：图片推近、文案反向微移，不再是硬切镜头 */
  [data-scroll-gallery][data-active='1'] .scroll-gallery__media img,
  [data-scroll-gallery][data-active='1'] .scroll-gallery__copy {
    will-change: transform;
  }

  [data-scroll-gallery][data-active='1'] .scroll-gallery__media img {
    transform: scale(calc(1 + 0.09 * var(--panel-local, 0)))
      translateY(calc((0.5 - var(--panel-local, 0)) * 12px));
  }

  [data-scroll-gallery][data-active='1'] .scroll-gallery__copy {
    transform: translateY(calc((0.5 - var(--panel-local, 0)) * 18px));
  }

  @media (max-width: 768px) {
    .scroll-gallery__panel {
      grid-template-columns: 1fr;
    }
  }
</style>
