---
import type { ProjectCategory } from '../lib/projects';
import type { ProjectData } from '../lib/project-schema';

import TagList from './TagList.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  cover: string;
  category: ProjectCategory;
  status: 'active' | 'completed' | 'archived';
  tech: readonly string[];
  repoUrl?: string | undefined;
  sourceVisibility?: 'public' | 'private' | undefined;
  repositories?: ProjectData['repositories'] | undefined;
  featured?: boolean | undefined;
}

const {
  href,
  title,
  description,
  cover,
  category,
  status,
  tech,
  repoUrl,
  sourceVisibility = 'public',
  repositories,
  featured = false,
} = Astro.props;
const repositoryCount = repositories?.length || 1;
const statusLabels = {
  active: '持续迭代',
  completed: '已经完成',
  archived: '已归档',
} as const;
---

<article
  class:list={['project-card', { 'project-card--featured': featured }]}
  data-project-category={category}
>
  <a class="project-cover" href={href} aria-label={`查看项目：${title}`}>
    <img src={cover} alt={`${title} 项目封面`} width="1440" height="900" loading="lazy" />
  </a>
  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{category}</span>
      <span>{statusLabels[status]}</span>
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p class="project-card__description">{description}</p>
    <TagList tags={tech.slice(0, 3)} />
    <p class="project-card__repository-count">
      {repoUrl ? (
        <>
          <strong>{repositoryCount}</strong> 个关联仓库
        </>
      ) : (
        sourceVisibility === 'private' ? '私有项目 · 源码未公开' : '暂无公开仓库'
      )}
    </p>
    <div class="project-card__actions">
      <a class="project-card__action project-card__action--primary" href={href}>
        查看详情 <span aria-hidden="true">→</span>
      </a>
      {repoUrl && repositoryCount === 1 && (
        <a class="project-card__action" href={repoUrl} target="_blank" rel="noopener noreferrer">源码 ↗</a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition: border-color 200ms ease;
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card:hover {
    border-color: var(--border-strong);
  }

  .project-cover {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--border);
    background: var(--surface-soft);
  }

  .project-cover img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 320ms ease;
  }

  .project-card:hover .project-cover img {
    transform: scale(1.04);
  }

  .project-card__body {
    display: flex;
    min-height: 268px;
    flex: 1;
    flex-direction: column;
    padding: clamp(22px, 2.4vw, 30px);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .project-card__meta span {
    display: inline-flex;
    align-items: center;
    padding: 3px 11px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  h3 {
    margin: 18px 0 0;
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    line-height: 1.2;
  }

  h3 a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ink-strong);
    text-decoration: none;
  }

  .project-card__description {
    margin: 12px 0 20px;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.72;
  }

  .project-card :global(.tag-list) {
    gap: 6px;
  }

  .project-card__repository-count {
    margin: 20px 0 0;
    color: var(--muted-weak);
    font-size: 0.82rem;
  }

  .project-card__repository-count strong {
    color: var(--ink);
    font-size: 0.94rem;
  }

  .project-card__actions {
    display: flex;
    gap: 10px;
    margin-top: auto;
    padding-top: 22px;
  }

  .project-card__action {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 20px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--ink-strong);
    background: transparent;
    font-size: 0.86rem;
    text-decoration: none;
    transition: color 200ms ease, background-color 200ms ease, border-color 200ms ease;
  }

  .project-card__action:hover {
    color: var(--accent-ink);
    border-color: var(--accent);
    background: var(--accent);
  }

  .project-card__action--primary {
    flex: 1;
    color: var(--accent-ink);
    border-color: var(--accent);
    background: var(--accent);
  }

  .project-card__action--primary:hover {
    color: var(--accent-ink);
    border-color: color-mix(in srgb, var(--accent) 82%, var(--canvas));
    background: color-mix(in srgb, var(--accent) 82%, var(--canvas));
  }

  @media (max-width: 440px) {
    .project-card__body {
      padding: 22px 20px;
    }

    .project-card__action {
      padding-inline: 14px;
    }
  }
</style>
