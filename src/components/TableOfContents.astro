---
import type { MarkdownHeading } from 'astro';

import { siteConfig } from '../config/site';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{visibleHeadings.length > 0 && (
  <aside class="toc" data-toc aria-label={siteConfig.articlePage.tocLabel}>
    <p>{siteConfig.articlePage.tocLabel}</p>
    <ol>
      {visibleHeadings.map((heading) => (
        <li class:list={{ nested: heading.depth === 3 }}>
          <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </aside>
)}

<script>
  (function () {
    const toc = document.querySelector<HTMLElement>('[data-toc]');
    if (!toc || toc.dataset.attached === '1') return;
    toc.dataset.attached = '1';
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (links.length === 0) return;

    const targets = links
      .map((link) => ({ link, el: document.getElementById(link.dataset.tocLink ?? '') }))
      .filter((item): item is { link: HTMLAnchorElement; el: HTMLElement } => Boolean(item.el));
    if (targets.length === 0) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const probe = window.innerHeight * 0.25;
      let activeIndex = 0;
      targets.forEach((item, index) => {
        if (item.el.getBoundingClientRect().top <= probe) activeIndex = index;
      });
      links.forEach((link, index) => {
        if (index === activeIndex) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  })();
</script>

<style>
  .toc {
    position: sticky;
    top: calc(104px + var(--sat, 0px));
    max-height: calc(100vh - 130px);
    max-height: calc(100dvh - 130px - var(--sat, 0px));
    overflow: auto;
    align-self: start;
    padding-left: 20px;
    border-left: 1px solid var(--border);
  }

  .toc p {
    margin: 0 0 13px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li { margin-top: 8px; }
  li.nested { padding-left: 12px; }

  a {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 180ms ease;
  }

  a:hover { color: var(--ink-strong); }

  a[aria-current='location'] {
    color: var(--accent-ink);
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .toc { display: none; }
  }
</style>

