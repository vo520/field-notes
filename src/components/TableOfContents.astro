---
import type { MarkdownHeading } from 'astro';

import { siteConfig } from '../config/site';

interface SectionLink {
  id: string;
  label: string;
  nested?: boolean;
}

interface Props {
  headings?: MarkdownHeading[];
  sections?: SectionLink[];
  label?: string;
  /** aside：文章侧栏目录；rail：首页/详情页悬浮章节导航 */
  variant?: 'aside' | 'rail';
}

const {
  headings = [],
  sections,
  label = siteConfig.articlePage.tocLabel,
  variant = 'aside',
} = Astro.props;
// 文章继续从 headings 派生；其它页面直接传显式章节，共用同一套高亮脚本
const items: SectionLink[] = sections
  ? sections
  : headings
      .filter((heading) => heading.depth === 2 || heading.depth === 3)
      .map((heading) => ({ id: heading.slug, label: heading.text, nested: heading.depth === 3 }));
---

{items.length > 0 && (
  <aside class:list={['toc', `toc--${variant}`]} data-toc data-toc-variant={variant} aria-label={label}>
    <p>{label}</p>
    <ol>
      {items.map((item) => (
        <li class:list={{ nested: item.nested }}>
          <a href={`#${item.id}`} data-toc-link={item.id}>{item.label}</a>
        </li>
      ))}
    </ol>
  </aside>
)}

<script>
  import { smoothScroll } from '../lib/smooth-scroll';

  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((toc) => {
    if (toc.dataset.attached === '1') return;
    toc.dataset.attached = '1';
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (links.length === 0) return;
    links.forEach((link) => link.addEventListener('click', () => smoothScroll.halt()));

    const targets = links
      .map((link) => ({ link, el: document.getElementById(link.dataset.tocLink ?? '') }))
      .filter((item): item is { link: HTMLAnchorElement; el: HTMLElement } => Boolean(item.el));
    if (targets.length === 0) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const probe = window.innerHeight * 0.25;
      let activeIndex = 0;
      targets.forEach((item, index) => {
        if (item.el.getBoundingClientRect().top <= probe) activeIndex = index;
      });
      // 页面底部最后一节已整体移出观察带时，手动高亮最后一项
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      if (maxScroll > 0 && window.scrollY >= maxScroll - 8) activeIndex = targets.length - 1;
      links.forEach((link, index) => {
        if (index === activeIndex) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  });
</script>

<style>
  .toc {
    position: sticky;
    top: calc(104px + var(--sat, 0px));
    max-height: calc(100vh - 130px);
    max-height: calc(100dvh - 130px - var(--sat, 0px));
    overflow: auto;
    align-self: start;
    padding-left: 20px;
    border-left: 1px solid var(--border);
  }

  .toc p {
    margin: 0 0 13px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li { margin-top: 8px; }
  li.nested { padding-left: 12px; }

  a {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 180ms ease;
  }

  a:hover { color: var(--ink-strong); }

  a[aria-current='location'] {
    color: var(--accent-ink);
    font-weight: 500;
  }

  /* 悬浮章节导航：复用同一份链接与高亮脚本，仅在桌面精确指针下出现 */
  .toc--rail {
    position: fixed;
    z-index: 40;
    top: 50%;
    right: max(16px, calc((100vw - var(--content)) / 2 - 68px));
    width: auto;
    max-height: min(70vh, 520px);
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--canvas) 88%, transparent);
    backdrop-filter: blur(10px);
    transform: translateY(-50%);
  }

  .toc--rail p { display: none; }
  .toc--rail li.nested { padding-left: 0; }

  .toc--rail a {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 26px;
    white-space: nowrap;
  }

  .toc--rail a::before {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-strong);
    content: '';
    transition: background 200ms ease, transform 200ms ease;
  }

  .toc--rail a[aria-current='location']::before {
    background: var(--accent);
    transform: scale(1.35);
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .toc { display: none; }
  }
</style>

