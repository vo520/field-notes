---
import type { MarkdownHeading } from 'astro';

import { siteConfig } from '../config/site';

interface SectionLink {
  id: string;
  label: string;
  nested?: boolean;
}

interface Props {
  headings?: MarkdownHeading[];
  sections?: SectionLink[];
  label?: string;
  /** aside：文章侧栏目录；rail：首页/详情页悬浮章节导航 */
  variant?: 'aside' | 'rail';
}

const {
  headings = [],
  sections,
  label = siteConfig.articlePage.tocLabel,
  variant = 'aside',
} = Astro.props;
// 文章继续从 headings 派生；其它页面直接传显式章节，共用同一套高亮脚本
const items: SectionLink[] = sections
  ? sections
  : headings
      .filter((heading) => heading.depth === 2 || heading.depth === 3)
      .map((heading) => ({ id: heading.slug, label: heading.text, nested: heading.depth === 3 }));
---

{items.length > 0 && (
  <aside class:list={['toc', `toc--${variant}`]} data-toc data-toc-variant={variant} aria-label={label}>
    <p>{label}</p>
    <ol>
      {items.map((item) => (
        <li class:list={{ nested: item.nested }}>
          <a href={`#${item.id}`} data-toc-link={item.id} title={item.label}><span>{item.label}</span></a>
          {variant === 'aside' && (
            <button
              type="button"
              class="toc-anchor-copy"
              data-copy-link
              data-copy-anchor={item.id}
              aria-label={siteConfig.ui.share.anchorAriaLabel}
              title={siteConfig.ui.share.anchorAriaLabel}
            >#</button>
          )}
        </li>
      ))}
    </ol>
  </aside>
)}

<script>
  import { smoothScroll } from '../lib/smooth-scroll';
  import { registerPageInit } from '../lib/page-lifecycle';
  import { onScrollFrame } from '../lib/scroll-ticker';

  registerPageInit(() => {
    const cleanups: Array<() => void> = [];
    document.querySelectorAll<HTMLElement>('[data-toc]').forEach((toc) => {
      const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
      if (links.length === 0) return;
      const onLinkClick = () => smoothScroll.halt();
      links.forEach((link) => link.addEventListener('click', onLinkClick));

      const targets = links
        .map((link) => ({ link, el: document.getElementById(link.dataset.tocLink ?? '') }))
        .filter((item): item is { link: HTMLAnchorElement; el: HTMLElement } => Boolean(item.el));
      if (targets.length === 0) {
        cleanups.push(() => links.forEach((link) => link.removeEventListener('click', onLinkClick)));
        return;
      }

      // 读阶段一次性取所有锚点位置与滚动基准，写阶段只改 aria-current
      let activeLink = targets[0]?.link;

      const stopFrames = onScrollFrame({
        read: () => {
          const currentProbe = window.innerHeight * 0.25;
          const scrollY = window.scrollY;
          // 按 link 身份高亮：targets 可能过滤掉不存在的锚点，不能用它的下标去标记 links
          let next = targets[0]?.link;
          for (const item of targets) {
            if (item.el.getBoundingClientRect().top <= currentProbe) next = item.link;
          }
          // 页面底部最后一节已整体移出观察带时，手动高亮最后一项
          const total = document.documentElement.scrollHeight - window.innerHeight;
          if (total > 0 && scrollY >= total - 8) {
            next = targets[targets.length - 1]?.link;
          }
          activeLink = next;
        },
        write: () => {
          links.forEach((link) => {
            if (link === activeLink) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        },
      });
      cleanups.push(() => {
        stopFrames();
        links.forEach((link) => link.removeEventListener('click', onLinkClick));
      });
    });
    return () => cleanups.forEach((cleanup) => cleanup());
  });
</script>

<style>
  .toc {
    position: sticky;
    top: calc(104px + var(--sat, 0px));
    max-height: calc(100vh - 130px);
    max-height: calc(100dvh - 130px - var(--sat, 0px));
    overflow: auto;
    align-self: start;
    padding-left: 20px;
    border-left: 1px solid var(--border);
  }

  .toc p {
    margin: 0 0 13px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li { margin-top: 8px; }
  li.nested { padding-left: 12px; }

  a {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 180ms ease;
  }

  li { position: relative; }

  a:hover { color: var(--ink-strong); }

  .toc-anchor-copy {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 6px;
    border: 0;
    border-radius: 4px;
    color: var(--muted);
    background: var(--surface);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    cursor: pointer;
    /* 不能改用 display:none：那样按钮会移出 Tab 顺序，键盘用户永远触发不到
       :focus-visible，锚点按钮变成鼠标专属。用透明 + 禁用点击，聚焦时再显形 */
    opacity: 0;
    pointer-events: none;
  }

  .toc--aside li:hover .toc-anchor-copy,
  .toc-anchor-copy:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .toc-anchor-copy:hover { color: var(--ink-strong); background: var(--accent-soft); }

  /* accent-ink 是「强调底色上的文字色」，浅色主题为白字；目录底色并非强调色，直接用会隐形 */
  a[aria-current='location'] {
    color: var(--ink-strong);
    font-weight: 600;
  }

  /* 悬浮章节导航：默认只留竖向节点轨，悬停/键盘聚焦再展开标签，减少正文遮挡 */
  .toc--rail {
    position: fixed;
    z-index: 40;
    top: 50%;
    right: max(16px, calc((100vw - var(--content)) / 2 - 68px));
    width: 38px;
    max-height: min(70vh, 520px);
    max-height: min(70dvh, 520px);
    padding: 12px 14px;
    overflow-x: hidden;
    overflow-y: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    box-shadow: var(--shadow);
    backdrop-filter: blur(12px);
    scrollbar-width: thin;
    transform: translateY(-50%);
    transition: width 220ms ease, border-radius 220ms ease, box-shadow 220ms ease;
  }

  .toc--rail:hover,
  .toc--rail:focus-within {
    width: min(220px, calc(100vw - 32px));
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-float);
  }

  .toc--rail p { display: none; }
  .toc--rail li.nested { padding-left: 0; }
  .toc--rail li + li { margin-top: 4px; }

  /* 连接线从首个节点中心连到末个节点中心；节点自带底色覆盖线段 */
  .toc--rail ol {
    position: relative;
  }

  .toc--rail ol::before {
    position: absolute;
    top: 13px;
    bottom: 13px;
    left: 3px;
    width: 1px;
    background: var(--border-strong);
    content: '';
  }

  .toc--rail a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 26px;
    color: var(--muted-weak);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .toc--rail a span {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .toc--rail:hover a span,
  .toc--rail:focus-within a span {
    opacity: 1;
    transform: none;
  }

  .toc--rail a::before {
    position: relative;
    z-index: 1;
    flex: 0 0 6px;
    width: 6px;
    height: 6px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--surface);
    content: '';
    transition: background 200ms ease, border-color 200ms ease, transform 200ms ease;
  }

  .toc--rail a[aria-current='location'] {
    color: var(--ink-strong);
  }

  .toc--rail a[aria-current='location']::before {
    border-color: var(--accent);
    background: var(--accent);
    transform: scale(1.25);
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .toc { display: none; }
  }
</style>

