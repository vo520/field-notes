---
import type { MarkdownHeading } from 'astro';

import { siteConfig } from '../config/site';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{visibleHeadings.length > 0 && (
  <aside class="toc" aria-label={siteConfig.articlePage.tocLabel}>
    <p>{siteConfig.articlePage.tocLabel}</p>
    <ol>
      {visibleHeadings.map((heading) => (
        <li class:list={{ nested: heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </aside>
)}

<style>
  .toc {
    position: sticky;
    top: calc(104px + var(--sat, 0px));
    max-height: calc(100vh - 130px);
    max-height: calc(100dvh - 130px - var(--sat, 0px));
    overflow: auto;
    align-self: start;
    padding-left: 20px;
    border-left: 1px solid var(--border);
  }

  .toc p {
    margin: 0 0 13px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li { margin-top: 8px; }
  li.nested { padding-left: 12px; }

  a {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 180ms ease;
  }

  a:hover { color: var(--ink-strong); }

  @media (max-width: 1024px) {
    .toc { display: none; }
  }
</style>

