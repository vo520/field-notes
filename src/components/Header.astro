---
import { siteConfig } from '../config/site';
import MobileMenu from './MobileMenu.astro';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="header-pill">
    <a class="brand" href="/" aria-label={`${siteConfig.name} 首页`}>
      <span class="brand-mark" aria-hidden="true">{siteConfig.brandMark}</span>
      <span class="brand-copy">
        <strong>{siteConfig.author.name}</strong>
        <small>{siteConfig.author.role}</small>
      </span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label="主导航">
      {siteConfig.nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="search-link" href="/search/">搜索 <kbd>/</kbd></a>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <MobileMenu />
    </div>
  </div>
</header>

<script>
  document.addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey || event.repeat) return;
    if (event.isComposing) return;
    const target = event.target as HTMLElement;
    const typing = ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) || target.isContentEditable;
    if (typing || document.querySelector('dialog[open]')) return;

    const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
    event.preventDefault();
    if (searchInput) searchInput.focus();
    else {
      try { sessionStorage.setItem('focus-search', '1'); } catch { /* ignore */ }
      window.location.href = '/search/';
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 30;
    top: 0;
    padding-top: calc(12px + var(--sat, 0px));
  }

  .header-pill {
    position: relative;
    display: flex;
    width: min(calc(100% - 32px), var(--content));
    height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: clamp(12px, 2vw, 24px);
    margin-inline: auto;
    padding: 0 12px 0 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--header-glass);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }

  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--ink-strong);
  }

  .brand-mark {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: var(--radius-sm);
    color: var(--accent-ink);
    background: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .brand-copy {
    display: grid;
    line-height: 1.12;
  }

  .brand-copy strong {
    font-size: 0.93rem;
    font-weight: 700;
  }

  .brand-copy small {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.6rem;
    font-weight: 300;
    letter-spacing: 0.16em;
  }

  .site-nav {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2.4vw, 34px);
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 4px 2px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 400;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .site-nav a::after {
    position: absolute;
    right: 0;
    bottom: 10px;
    left: 0;
    height: 2px;
    background: var(--accent);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--ink-strong);
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-nav .search-link {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    margin-left: 8px;
    padding: 6px 14px;
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
  }

  .site-nav .search-link::after {
    display: none;
  }

  .site-nav .search-link:hover {
    border-color: var(--border-strong);
  }

  kbd {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .header-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
  }

  .header-actions :global(.theme-toggle) {
    flex: 0 0 auto;
  }

  @media (max-width: 980px) {
    .brand-copy {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .header-pill {
      padding-left: 16px;
    }

    .header-actions {
      margin-left: auto;
      gap: 6px;
    }

    .site-nav {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      left: 0;
      z-index: 1;
      display: none;
      align-items: stretch;
      padding: 10px;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background: var(--surface);
    }

    .site-nav.is-open {
      display: grid;
    }

    .site-nav a {
      min-height: 44px;
      padding: 10px 12px;
    }

    .site-nav a::after {
      bottom: 6px;
    }

    .site-nav .search-link {
      margin: 6px 0 0;
      border: 0;
    }
  }
</style>
