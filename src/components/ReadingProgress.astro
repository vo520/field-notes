---
/**
 * 文章页阅读进度条 + 剩余阅读时间 + 阅读位置记忆。
 * 只在 article / project 页面渲染（有 readingProgress 开关）。
 * 纯内联 JS，零运行时依赖。
 */
import { siteConfig } from '../config/site';

interface Props {
  minutes?: number;
}

const { minutes = 0 } = Astro.props;
const template = siteConfig.ui.readingProgress.remainingTemplate;
const resumeCopy = siteConfig.ui.readingResume;
---

<div id="reading-progress" class="reading-progress" aria-hidden="true"></div>
{minutes > 0 && (
  <div
    class="reading-remaining"
    data-reading-remaining
    data-template={template}
    data-minutes={minutes}
    aria-hidden="true"
  >{template.replace('{minutes}', String(minutes))}</div>
)}
<div class="reading-resume" data-reading-resume hidden>
  <span data-resume-message></span>
  <button type="button" data-resume-go>{resumeCopy.resume}</button>
  <button type="button" data-resume-dismiss>{resumeCopy.dismiss}</button>
</div>

<script>
  import { registerPageInit } from '../lib/page-lifecycle';
  import { smoothScroll } from '../lib/smooth-scroll';
  import { siteConfig } from '../config/site';

  registerPageInit(() => {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;

    const root = document.documentElement;
    const body = document.body;
    const remaining = document.querySelector('[data-reading-remaining]');
    const template = remaining?.getAttribute('data-template') ?? '';
    const totalMinutes = Number.parseInt(remaining?.getAttribute('data-minutes') ?? '0', 10);
    const resumeBar = document.querySelector<HTMLElement>('[data-reading-resume]');
    const resumeMessage = document.querySelector<HTMLElement>('[data-resume-message]');
    const resumeGo = document.querySelector<HTMLButtonElement>('[data-resume-go]');
    const resumeDismiss = document.querySelector<HTMLButtonElement>('[data-resume-dismiss]');
    const resumeCopy = siteConfig.ui.readingResume;

    // —— 阅读位置记忆：只在当前页有历史记录时提示，记录写入与清理都收敛在本组件 ——
    const POSITIONS_KEY = 'site-reading-positions';
    const POSITIONS_TTL = 30 * 24 * 60 * 60 * 1000;
    const RESUME_MIN = 0.05;
    const RESUME_MAX = 0.95;

    type Position = { ratio: number; at: number };
    const readPositions = (): Record<string, Position> => {
      try {
        const raw = JSON.parse(localStorage.getItem(POSITIONS_KEY) ?? '{}');
        return raw && typeof raw === 'object' ? raw : {};
      } catch { return {}; }
    };
    const writePosition = (ratio: number) => {
      try {
        const all = readPositions();
        // 顺手清掉过期条目，防止无界增长
        const now = Date.now();
        for (const [path, entry] of Object.entries(all)) {
          if (!entry || typeof entry.at !== 'number' || now - entry.at > POSITIONS_TTL) delete all[path];
        }
        all[window.location.pathname] = { ratio, at: now };
        localStorage.setItem(POSITIONS_KEY, JSON.stringify(all));
      } catch { /* ignore */ }
    };

    let savedRatio = -1;
    try {
      const saved = readPositions()[window.location.pathname];
      if (saved && typeof saved.ratio === 'number' && Date.now() - saved.at <= POSITIONS_TTL) {
        savedRatio = saved.ratio;
      }
    } catch { /* ignore */ }

    const maxScroll = () => {
      const total = root.scrollHeight - (window.innerHeight || root.clientHeight);
      return total > 0 ? total : 0;
    };

    // 用户点了「从头开始」就不再回写位置：随后的滚动落盘与 swap 前落盘都跳过
    let resumeDismissed = false;

    if (savedRatio >= RESUME_MIN && savedRatio <= RESUME_MAX && resumeBar && resumeMessage) {
      resumeMessage.textContent = resumeCopy.messageTemplate
        .replace('{percent}', String(Math.round(savedRatio * 100)));
      resumeBar.hidden = false;
      resumeGo?.addEventListener('click', () => {
        resumeBar!.hidden = true;
        // 先停掉惯性滚轮，再按记录的比例恢复，避免被平滑滚动接管
        smoothScroll.halt();
        window.scrollTo({ top: maxScroll() * savedRatio, behavior: 'instant' });
      });
      resumeDismiss?.addEventListener('click', () => {
        resumeBar!.hidden = true;
        resumeDismissed = true;
        writePosition(0);
      });
    }

    function update() {
      const scrollTop = root.scrollTop || body.scrollTop;
      const windowHeight = window.innerHeight || root.clientHeight;
      const total = root.scrollHeight - windowHeight;
      // 用 scaleX 代替改 width：transform 只走合成器，不触发逐帧 layout，
      // 与侧栏 TOC / Header 显隐共用同一个滚动 rAF 预算
      const ratio = total <= 0 ? 0 : Math.min(1, Math.max(0, scrollTop / total));
      bar!.style.transform = `scaleX(${ratio.toFixed(4)})`;
      if (remaining instanceof HTMLElement && totalMinutes > 0 && template) {
        const left = Math.max(0, Math.ceil(totalMinutes * (1 - ratio)));
        remaining.textContent = template.replace('{minutes}', String(left));
      }
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        update();
        ticking = false;
      });
    }

    // 滚动停止 800ms 后落盘，避免每次滚动都写 localStorage
    let saveTimer = 0;
    const saveOnIdle = () => {
      if (resumeDismissed) return;
      window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(() => {
        const total = maxScroll();
        if (total > 0) writePosition(Math.min(1, Math.max(0, (root.scrollTop || body.scrollTop) / total)));
      }, 800);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('scroll', saveOnIdle, { passive: true });
    window.addEventListener('resize', onScroll);
    update();

    return () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('scroll', saveOnIdle);
      window.removeEventListener('resize', onScroll);
      window.clearTimeout(saveTimer);
      // 离开页面前把最后位置写进去；cleanup 在 swap 前执行，此刻 DOM 还在
      if (!resumeDismissed) {
        const total = maxScroll();
        if (total > 0) writePosition(Math.min(1, Math.max(0, (root.scrollTop || body.scrollTop) / total)));
      }
    };
  });
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    height: 2px;
    width: 100%;
    background: linear-gradient(90deg, var(--accent), var(--ink-strong));
    transition: transform 120ms ease-out;
    transform: scaleX(0);
    transform-origin: 0 50%;
    will-change: transform;
  }

  .reading-remaining {
    position: fixed;
    z-index: 40;
    /* 放左下角：右下角已被「返回顶部」和快捷键按钮占用，三者曾互相叠压 */
    left: calc(16px + var(--sal, 0px));
    bottom: calc(24px + var(--sab, 0px));
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
    backdrop-filter: blur(8px);
  }

  @media (max-width: 640px) {
    .reading-remaining { display: none; }
  }

  .reading-resume {
    position: fixed;
    z-index: 40;
    left: 50%;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--ink);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    box-shadow: var(--shadow-float);
    backdrop-filter: blur(8px);
    transform: translateX(-50%);
  }

  .reading-resume[hidden] { display: none; }

  .reading-resume button {
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 6px 12px;
    color: var(--muted);
    background: transparent;
    font-size: 0.76rem;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease;
  }

  .reading-resume button:hover { color: var(--ink-strong); border-color: var(--border-strong); }
  .reading-resume button[data-resume-go] { color: var(--ink-strong); }

  @media (max-width: 640px) {
    /* 横屏刘海/竖屏 Home 指示条都被安全区包住，否则恢复条会被遮住一角 */
    .reading-resume {
      right: calc(16px + var(--sar, 0px));
      left: calc(16px + var(--sal, 0px));
      bottom: calc(16px + var(--sab, 0px));
      width: auto;
      justify-content: space-between;
      gap: 8px;
      transform: none;
    }
    /* 移动端手指点击，按钮撑到 44px 才够稳 */
    .reading-resume button { min-height: 44px; padding: 8px 16px; font-size: 0.82rem; }
  }
</style>
