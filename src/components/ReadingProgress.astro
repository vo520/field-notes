---
/**
 * 文章页阅读进度条。
 * 只在 article 页面渲染（有 data-article-progress 标记）。
 * 纯内联 JS，零运行时依赖。
 */
---

<div id="reading-progress" class="reading-progress" aria-hidden="true"></div>

<script>
  (function () {
    const bar = document.getElementById('reading-progress');
    if (!bar || bar.dataset.attached === '1') return;
    bar.dataset.attached = '1';

    const root = document.documentElement;
    const body = document.body;

    function update() {
      const scrollTop = root.scrollTop || body.scrollTop;
      const windowHeight = window.innerHeight || root.clientHeight;
      const total = root.scrollHeight - windowHeight;
      if (total <= 0) {
        bar!.style.width = '0%';
        return;
      }
      const progress = Math.min(100, Math.max(0, (scrollTop / total) * 100));
      bar!.style.width = progress.toFixed(2) + '%';
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        update();
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  })();
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, var(--accent), var(--ink-strong));
    transition: width 120ms ease-out;
    transform: translateZ(0);
    will-change: width;
  }
</style>
