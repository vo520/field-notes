---
import type { CollectionEntry } from 'astro:content';

import { siteConfig } from '../config/site';

interface Props {
  project: CollectionEntry<'projects'>;
}

const copy = siteConfig.projectPage.capabilities;
const { project } = Astro.props;
const { modules, roles, workflow, metrics, integrations } = project.data;
const hasCapabilities = Boolean(modules?.length || roles?.length || workflow?.length || metrics?.length || integrations?.length);
// 编号按实际渲染的区块递增；metrics 可选，写死会导致「01 / 02 / 04」跳号
let sectionIndex = 0;
const sectionNumber = () => String(++sectionIndex).padStart(2, '0');
---

{hasCapabilities && (
  <section class="project-capabilities container" data-project-capabilities aria-labelledby="project-capabilities-title">
    <header class="project-capabilities__heading">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2 id="project-capabilities-title">{copy.title}</h2>
      </div>
      <p>{copy.intro}</p>
    </header>

    {modules?.length ? (
      <section class="capability-block" aria-labelledby="capability-modules-title">
        <div class="capability-block__title"><span>{sectionNumber()}</span><h3 id="capability-modules-title">{copy.modules}</h3></div>
        <div class="module-grid">
          {modules.map((module, index) => (
            <article class:list={['module-card', { 'module-card--featured': index < 2 }]}>
              {index < 2 && <span class="module-card__tag">重点</span>}
              <h4>{module.name}</h4>
              <p>{module.description}</p>
              <ul>{module.features.map((feature) => <li>{feature}</li>)}</ul>
            </article>
          ))}
        </div>
      </section>
    ) : null}

    <div class="capability-columns">
      {roles?.length ? (
        <section class="capability-block" aria-labelledby="capability-roles-title">
          <div class="capability-block__title"><span>{sectionNumber()}</span><h3 id="capability-roles-title">{copy.roles}</h3></div>
          <div class="role-list">
            {roles.map((role) => <div class="role-row"><strong>{role.name}</strong><span>{role.scope}</span></div>)}
          </div>
        </section>
      ) : null}

      {metrics?.length ? (
        <section class="capability-block" aria-labelledby="capability-metrics-title">
          <div class="capability-block__title"><span>{sectionNumber()}</span><h3 id="capability-metrics-title">{copy.metrics}</h3></div>
          <div class="metric-grid">
            {metrics.map((metric) => <div class="metric-card"><span>{metric.label}</span><strong>{metric.value}</strong><small>{metric.trend}</small></div>)}
          </div>
        </section>
      ) : null}
    </div>

    {workflow?.length ? (
      <section class="capability-block" aria-labelledby="capability-workflow-title">
        <div class="capability-block__title"><span>{sectionNumber()}</span><h3 id="capability-workflow-title">{copy.workflow}</h3></div>
        <ol class="workflow-list">
          {workflow.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step.label}</strong><small>{step.status}</small></li>)}
        </ol>
      </section>
    ) : null}

    {integrations?.length ? (
      <section class="capability-integrations" aria-label={copy.integrations}>
        <span>{copy.integrations}</span>
        <div>{integrations.map((integration) => <b>{integration}</b>)}</div>
      </section>
    ) : null}
  </section>
)}

<style>
  .project-capabilities {
    padding-block: clamp(64px, 8vw, 96px);
    border-bottom: 1px solid var(--border);
  }

  .project-capabilities__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 42px;
  }

  .project-capabilities h2 {
    /* 章节导航锚点落到该标题时需避让悬浮头部 */
    scroll-margin-top: var(--header-offset);
    margin: 0;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    line-height: 1.14;
  }
  .project-capabilities__heading > p { margin: 0; color: var(--muted); line-height: 1.75; }
  .capability-block { margin-top: 34px; }
  .capability-block__title { display: flex; gap: 12px; align-items: baseline; margin-bottom: 18px; }
  .capability-block__title span { color: var(--muted-weak); font: 300 0.72rem/1 var(--font-sans); letter-spacing: 0.18em; }
  .capability-block h3 { margin: 0; font-size: 1.3rem; }
  .module-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .module-card, .metric-card { padding: 22px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
  /* 前两个模块是项目重点：用强调边框与标记区分，避免所有能力卡看起来一样重 */
  .module-card--featured {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .module-card__tag {
    display: inline-block;
    margin-bottom: 10px;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    color: var(--accent-ink);
    background: var(--accent);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .module-card h4 { margin: 0; font-size: 1.05rem; }
  .module-card p { margin: 10px 0 16px; color: var(--muted); line-height: 1.65; }
  .module-card ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .module-card li { color: var(--ink); font-size: 0.88rem; }
  /* ↗ 在全站专指站外/新窗口链接（正文外链、简历外链都带），
     这里只是特性列表的项目符号，用破折号避免误读成可点的外链 */
  .module-card li::before { margin-right: 8px; color: var(--muted-weak); content: '—'; }
  .capability-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; }
  .role-list { border-top: 1px solid var(--border); }
  .role-row { display: flex; justify-content: space-between; gap: 20px; padding: 14px 0; border-bottom: 1px solid var(--border); }
  .role-row span { color: var(--muted); text-align: right; }
  .metric-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .metric-card { display: grid; gap: 8px; }
  .metric-card span, .metric-card small { color: var(--muted); }
  .metric-card strong { font-size: 1.8rem; }
  .metric-card small { color: var(--muted); }
  /* 步骤数由内容决定（3–5 步常见），固定 5 列会把说明挤成竖排窄条 */
  .workflow-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
  .workflow-list li { display: grid; gap: 12px; align-content: start; padding: 18px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface-soft); }
  .workflow-list li > span { color: var(--muted-weak); font: 300 0.72rem/1 var(--font-sans); letter-spacing: 0.12em; }
  .workflow-list strong { line-height: 1.35; }
  .workflow-list small { color: var(--muted); }
  .capability-integrations { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 20px; align-items: center; margin-top: 38px; padding-top: 22px; border-top: 1px solid var(--border); }
  .capability-integrations > span { color: var(--muted); font-size: 0.82rem; }
  .capability-integrations div { display: flex; flex-wrap: wrap; gap: 8px; }
  .capability-integrations b { padding: 5px 12px; border: 1px solid var(--border); border-radius: var(--radius-pill); color: var(--muted); font-size: 0.76rem; font-weight: 400; }
  @media (max-width: 768px) {
    .project-capabilities__heading, .capability-columns { grid-template-columns: 1fr; gap: 24px; }
    .module-grid { grid-template-columns: 1fr; }
    .workflow-list { grid-template-columns: 1fr; }
    .capability-integrations { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
