---
import type { CollectionEntry } from 'astro:content';

import { siteConfig } from '../config/site';
import { ALL_PROJECT_CATEGORIES, getProjectCategoryStats } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  /** 分类页已经按分类过滤，筛选条会误导访客，因此默认关闭 */
  showFilters?: boolean;
}

const { projects, showFilters = true } = Astro.props;
const copy = siteConfig.projectsPage;
const filters = [
  { category: ALL_PROJECT_CATEGORIES, count: projects.length },
  ...getProjectCategoryStats(projects).filter(({ count }) => count > 0),
];
const orderedProjects = [...projects].sort(
  (left, right) => Number(right.data.featured) - Number(left.data.featured),
);
---

<section class="project-gallery-shell" aria-label={showFilters ? copy.filterAriaLabel : copy.listAriaLabel}>
  {showFilters && (
    <div class="project-filters" role="group" aria-label={copy.filterGroupAriaLabel}>
      {filters.map(({ category, count }) => (
        <button
          type="button"
          data-project-filter={category}
          data-project-filter-count={count}
          aria-pressed={category === ALL_PROJECT_CATEGORIES ? 'true' : 'false'}
          aria-controls="project-gallery"
        >
          <span>{category === ALL_PROJECT_CATEGORIES ? copy.allCategory : category}</span>
          <span class="project-filter__count" aria-label={siteConfig.ui.projectCountAriaTemplate.replace('{count}', String(count))}>{count}</span>
        </button>
      ))}
    </div>
  )}

  <div id="project-gallery" class="project-gallery" data-project-gallery>
    {orderedProjects.map((project) => (
      <ProjectCard
        href={`/projects/${project.id}/`}
        title={project.data.title}
        description={project.data.description}
        cover={project.data.cover}
        category={project.data.category}
        status={project.data.status}
        tech={project.data.tech}
        repoUrl={project.data.repoUrl}
        sourceVisibility={project.data.sourceVisibility}
        repositories={project.data.repositories}
        featured={project.data.featured}
      />
    ))}
  </div>

  <p class="project-empty" data-project-empty hidden>{copy.emptyText}</p>
</section>

<script>
  import { ALL_PROJECT_CATEGORIES, getProjectCategoryUrl, parseProjectCategory } from '../lib/projects';
  import { toTagSlug } from '../lib/slug';
  import { registerPageInit } from '../lib/page-lifecycle';

  registerPageInit(() => {
  const gallery = document.querySelector<HTMLElement>('[data-project-gallery]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]');
  const empty = document.querySelector<HTMLElement>('[data-project-empty]');

  const applyFilter = (filter: string) => {
    let visible = 0;
    // 与分类页、发布闸门同口径：卡片分类大小写/全半角不同也算命中
    const filterSlug = toTagSlug(filter);

    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.projectFilter === filter));
    });
    gallery?.querySelectorAll<HTMLElement>('[data-project-category]').forEach((card) => {
      const matches = filter === ALL_PROJECT_CATEGORIES
        || toTagSlug(card.dataset.projectCategory ?? '') === filterSlug;
      card.hidden = !matches;
      if (matches) visible += 1;
    });

    if (empty) empty.hidden = visible > 0;
  };

  // 分类页不渲染筛选条，URL 上的 category 参数在那里没有对应按钮，不能拿来隐藏卡片
  if (buttons.length > 0) {
    const initialFilter = parseProjectCategory(new URLSearchParams(window.location.search).get('category'));
    const availableFilters = new Set([...buttons].map((button) => button.dataset.projectFilter));
    applyFilter(availableFilters.has(initialFilter) ? initialFilter : ALL_PROJECT_CATEGORIES);
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = parseProjectCategory(button.dataset.projectFilter ?? null);

      applyFilter(filter);
      window.history.replaceState({}, '', getProjectCategoryUrl(window.location.href, filter));
    });
  });
  // 监听器都绑在被 swap 替换的按钮节点上，无需显式解绑
  });
</script>

<style>
  .project-filters {
    display: flex;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-inline: contain;
    gap: 8px;
    margin-bottom: 28px;
    padding: 0 0 6px;
    scrollbar-width: thin;
  }

  .project-filters button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    flex: none;
    padding: 8px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
    background: transparent;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }

  .project-filter__count {
    color: var(--muted-weak);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    text-align: center;
  }

  .project-filters button:hover {
    color: var(--ink-strong);
    border-color: var(--border-strong);
  }

  .project-filters button[aria-pressed='true'] {
    color: var(--accent-ink);
    border-color: var(--accent);
    background: var(--accent);
  }

  .project-filters button[aria-pressed='true'] .project-filter__count {
    color: color-mix(in srgb, var(--accent-ink) 62%, transparent);
  }

  .project-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .project-empty {
    margin: 28px 0 0;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 768px) {
    .project-gallery { grid-template-columns: 1fr; }
  }
</style>
