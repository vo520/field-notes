---
import { siteConfig } from '../config/site';
import {
  resolveGiscusConfig,
  resolveGiscusTheme,
} from '../lib/giscus';

interface Props {
  mapping: 'pathname' | 'specific';
  term?: string | undefined;
  title?: string;
}

const copy = siteConfig.ui.comments;
const { mapping, term, title = copy.defaultTitle } = Astro.props;
const config = resolveGiscusConfig(import.meta.env);
---

<link rel="preconnect" href="https://giscus.app" />

<section
  class="comments"
  aria-labelledby="comments-title"
  data-giscus-host
  data-mapping={mapping}
  data-term={term}
  data-error={copy.error}
  data-retry={copy.retry}
>
  <header>
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="comments-title">{title}</h2>
    <p>{copy.intro}</p>
  </header>

  <div
    class="giscus-mount"
    data-giscus-mount
    data-repo={config.repo}
    data-repo-id={config.repoId}
    data-category={config.category}
    data-category-id={config.categoryId}
    data-mapping={mapping}
    data-term={term}
    data-giscus-theme={resolveGiscusTheme('light')}
  >
    <p class="giscus-loading" data-giscus-status>{copy.loading}</p>
  </div>
</section>

<script>
  import { resolveGiscusTheme } from '../lib/giscus';

  const hosts = document.querySelectorAll<HTMLElement>('[data-giscus-host]');
  // 主题可能在 giscus 脚本/iframe 加载完成前切换，必须保留最新值供 iframe 就绪后补发
  let currentTheme = resolveGiscusTheme(document.documentElement.dataset.theme);

  const syncGiscusFrames = (theme: string) => {
    document.querySelectorAll<HTMLIFrameElement>('iframe.giscus-frame').forEach((frame) => {
      frame.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
    });
  };

  const showLoadError = (host: HTMLElement, mount: HTMLElement) => {
    const message = document.createElement('p');
    message.className = 'giscus-error';
    message.textContent = host.dataset.error ?? '';

    const retry = document.createElement('button');
    retry.className = 'giscus-retry';
    retry.type = 'button';
    retry.textContent = host.dataset.retry ?? '';
    retry.addEventListener('click', () => {
      mount.dataset.loaded = 'false';
      loadGiscus(host);
    }, { once: true });

    mount.replaceChildren(message, retry);
  };

  const loadGiscus = (host: HTMLElement) => {
    const mount = host.querySelector<HTMLElement>('[data-giscus-mount]');
    if (!mount || mount.dataset.loaded === 'true') return;

    mount.dataset.loaded = 'true';
    mount.replaceChildren();

    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    script.addEventListener('error', () => showLoadError(host, mount), { once: true });

    const attributes: Record<string, string> = {
      repo: mount.dataset.repo ?? '',
      'repo-id': mount.dataset.repoId ?? '',
      category: mount.dataset.category ?? '',
      'category-id': mount.dataset.categoryId ?? '',
      mapping: mount.dataset.mapping ?? 'pathname',
      strict: '0',
      'reactions-enabled': '1',
      'emit-metadata': '0',
      'input-position': 'top',
      theme: currentTheme,
      lang: 'zh-CN',
      loading: 'lazy',
    };

    if (mount.dataset.term) attributes.term = mount.dataset.term;
    Object.entries(attributes).forEach(([name, value]) => script.setAttribute(`data-${name}`, value));
    mount.append(script);
  };

  // iframe 的 load 不冒泡，但捕获阶段能在挂载节点上拿到；此时补发一次，避免切换主题消息丢失
  hosts.forEach((host) => {
    const mount = host.querySelector<HTMLElement>('[data-giscus-mount]');
    mount?.addEventListener('load', (event) => {
      if (event.target instanceof HTMLIFrameElement && event.target.classList.contains('giscus-frame')) {
        syncGiscusFrames(currentTheme);
      }
    }, true);
  });

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        loadGiscus(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '420px 0px' });
    hosts.forEach((host) => observer.observe(host));
  } else {
    hosts.forEach(loadGiscus);
  }

  document.addEventListener('site-theme-change', (event) => {
    currentTheme = resolveGiscusTheme(
      event instanceof CustomEvent ? event.detail?.theme : document.documentElement.dataset.theme,
    );
    syncGiscusFrames(currentTheme);
  });
</script>

<style>
  .comments {
    min-width: 0;
    padding-top: 56px;
    border-top: 1px solid var(--border);
  }

  .comments header h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3.4vw, 2.6rem);
    line-height: 1.15;
  }

  .comments header > p:last-child {
    max-width: 680px;
    margin: 12px 0 0;
    color: var(--muted);
  }

  .giscus-mount {
    min-height: 220px;
    margin-top: 28px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .giscus-loading,
  :global(.giscus-error) {
    margin: 0;
    color: var(--muted);
  }

  :global(.giscus-retry) {
    min-height: 44px;
    margin-top: 16px;
    padding: 0 18px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--ink);
    background: var(--surface-soft);
    cursor: pointer;
  }

  :global(.giscus-retry:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .giscus-mount :global(.giscus-frame) {
    width: 100%;
  }
</style>
