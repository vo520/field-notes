---
import type { ProjectData } from '../lib/project-schema';
import { siteConfig } from '../config/site';

interface Props {
  screenshots: NonNullable<ProjectData['screenshots']>;
  projectTitle: string;
  headingId: string;
}

const copy = siteConfig.projectPage.screenshots;
const { screenshots, projectTitle, headingId } = Astro.props;
const firstScreenshot = screenshots[0];
if (!firstScreenshot) throw new Error('项目截图画廊至少需要一张截图');
const initialProgress = `01 / ${String(screenshots.length).padStart(2, '0')}`;
---

<div class="screenshot-scroll-stage" data-screenshot-scroll-stage style={`--screenshot-count: ${screenshots.length}`}>
<section class="project-screenshots container" data-project-screenshots aria-labelledby={headingId}>
  <div class="project-screenshots__heading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id={headingId}>{copy.title}</h2>
    <p class="project-screenshots__intro">{copy.intro}</p>
    <div class="project-screenshots__current">
      <span class="project-screenshots__progress" data-screenshot-progress>{initialProgress}</span>
      <h3 data-screenshot-title>{firstScreenshot.title}</h3>
      <p data-screenshot-caption>{firstScreenshot.caption}</p>
      <div class="project-screenshots__scrub" data-screenshot-scrub aria-hidden="true"><span data-screenshot-scrub-fill></span></div>
      <button class="project-screenshots__open" type="button" data-open-screenshot-dialog>{copy.open}</button>
    </div>
  </div>

  <div class="project-screenshots__gallery">
    <figure
      class="project-screenshots__stage"
      data-screenshot-stage
      data-viewport={firstScreenshot.viewport}
      style={`--screenshot-ratio: ${firstScreenshot.width} / ${firstScreenshot.height}`}
    >
      <div class="project-screenshots__media">
        <img
          data-screenshot-stage-image
          src={firstScreenshot.src}
          alt={firstScreenshot.alt}
          width={firstScreenshot.width}
          height={firstScreenshot.height}
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>

    <div class="project-screenshots__thumbnails" role="group" aria-label={copy.thumbnailsAriaLabel}>
      {screenshots.map((screenshot, index) => (
        <button
          class="project-screenshots__thumbnail"
          type="button"
          data-screenshot-thumbnail
          data-screenshot={JSON.stringify(screenshot)}
          aria-current={index === 0 ? 'true' : 'false'}
          aria-label={copy.thumbnailAriaTemplate.replace('{title}', screenshot.title)}
        >
          <img
            src={screenshot.src}
            alt=""
            width={screenshot.width}
            height={screenshot.height}
            loading="lazy"
            decoding="async"
          />
          <span>{String(index + 1).padStart(2, '0')}</span>
        </button>
      ))}
    </div>
  </div>

  <dialog data-screenshot-dialog aria-label={copy.dialogAriaTemplate.replace('{title}', projectTitle)}>
    <div class="project-screenshots__dialog-panel">
      <button class="project-screenshots__dialog-close" type="button" data-close-screenshot-dialog aria-label={copy.closeAriaLabel}>×</button>
      <button class="project-screenshots__dialog-nav" type="button" data-previous-screenshot aria-label={copy.prevAriaLabel}>←</button>
      <figure class="project-screenshots__dialog-figure">
        <img
          data-screenshot-dialog-image
          src={firstScreenshot.src}
          alt={firstScreenshot.alt}
          width={firstScreenshot.width}
          height={firstScreenshot.height}
        />
        <figcaption>
          <h3 data-screenshot-dialog-title>{firstScreenshot.title}</h3>
          <p data-screenshot-dialog-caption>{firstScreenshot.caption}</p>
        </figcaption>
      </figure>
      <button class="project-screenshots__dialog-nav" type="button" data-next-screenshot aria-label={copy.nextAriaLabel}>→</button>
    </div>
  </dialog>

  <noscript>
    <div class="project-screenshots__static-list">
      {screenshots.map((screenshot) => (
        <figure>
          <img
            src={screenshot.src}
            alt={screenshot.alt}
            width={screenshot.width}
            height={screenshot.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <h3>{screenshot.title}</h3>
            <p>{screenshot.caption}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </noscript>
</section>
</div>

<script>
  import { smoothScroll } from '../lib/smooth-scroll';
  import { canUseStickyMotion, clamp01, easeOutQuad, observeStageProgress } from '../lib/stage-progress';
  import { registerPageInit } from '../lib/page-lifecycle';

  interface ScreenshotData {
    src: string;
    alt: string;
    title: string;
    caption: string;
    viewport: 'desktop' | 'mobile';
    width: number;
    height: number;
  }

  registerPageInit(() => {
    const cleanups: Array<() => void> = [];
    document.querySelectorAll<HTMLElement>('[data-project-screenshots]').forEach((gallery) => {
    const stage = gallery.querySelector<HTMLElement>('[data-screenshot-stage]');
    const stageImage = gallery.querySelector<HTMLImageElement>('[data-screenshot-stage-image]');
    const title = gallery.querySelector<HTMLElement>('[data-screenshot-title]');
    const caption = gallery.querySelector<HTMLElement>('[data-screenshot-caption]');
    const progress = gallery.querySelector<HTMLElement>('[data-screenshot-progress]');
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-screenshot-dialog]');
    const dialogImage = gallery.querySelector<HTMLImageElement>('[data-screenshot-dialog-image]');
    const dialogTitle = gallery.querySelector<HTMLElement>('[data-screenshot-dialog-title]');
    const dialogCaption = gallery.querySelector<HTMLElement>('[data-screenshot-dialog-caption]');
    const openButton = gallery.querySelector<HTMLButtonElement>('[data-open-screenshot-dialog]');
    const closeButton = gallery.querySelector<HTMLButtonElement>('[data-close-screenshot-dialog]');
    const previousButton = gallery.querySelector<HTMLButtonElement>('[data-previous-screenshot]');
    const nextButton = gallery.querySelector<HTMLButtonElement>('[data-next-screenshot]');
    const thumbnailButtons = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>('[data-screenshot-thumbnail]'),
    );
    const screenshots = thumbnailButtons.map((button) => JSON.parse(button.dataset.screenshot ?? '') as ScreenshotData);
    const scrollStage = gallery.closest<HTMLElement>('[data-screenshot-scroll-stage]');

    if (
      screenshots.length === 0
      || !stage
      || !stageImage
      || !title
      || !caption
      || !progress
      || !dialog
      || !dialogImage
      || !dialogTitle
      || !dialogCaption
      || !openButton
      || !closeButton
      || !previousButton
      || !nextButton
    ) return;

    let currentIndex = 0;
    // 手动选择（缩略图/灯箱/键盘）后暂停滚动接管，直到用户真正滚动页面
    let manualLock = false;
    let lastScrollY = window.scrollY;

    const selectScreenshot = (index: number) => {
      currentIndex = (index + screenshots.length) % screenshots.length;
      const item = screenshots[currentIndex];
      if (!item) throw new Error('无法选择项目截图');
      stageImage.src = item.src;
      stageImage.alt = item.alt;
      stageImage.width = item.width;
      stageImage.height = item.height;
      stage.dataset.viewport = item.viewport;
      stage.style.setProperty('--screenshot-ratio', `${item.width} / ${item.height}`);
      title.textContent = item.title;
      caption.textContent = item.caption;
      progress.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(screenshots.length).padStart(2, '0')}`;
      // 手动选择时同步镜头进度，避免锁定期进度条停在上一张
      if (scrollStage?.dataset.active === '1') {
        scrollStage.style.setProperty('--screenshot-progress', (currentIndex / screenshots.length).toFixed(4));
        scrollStage.style.setProperty('--screenshot-local', '0');
      }
      dialogImage.src = item.src;
      dialogImage.alt = item.alt;
      dialogImage.width = item.width;
      dialogImage.height = item.height;
      dialogTitle.textContent = item.title;
      dialogCaption.textContent = item.caption;
      thumbnailButtons.forEach((button, buttonIndex) => {
        button.setAttribute('aria-current', String(buttonIndex === currentIndex));
      });
    };

    const selectManually = (index: number) => {
      // 先停掉残余惯性，否则站点自身的 scrollTo 会立刻解除手动锁并覆盖选择
      smoothScroll.halt();
      manualLock = true;
      lastScrollY = window.scrollY;
      selectScreenshot(index);
    };

    const thumbnailHandlers = thumbnailButtons.map((_, index) => () => selectManually(index));
    thumbnailButtons.forEach((button, index) => button.addEventListener('click', thumbnailHandlers[index]!));
    const onOpen = () => {
      // 其它模态已打开时不叠加第二个浮层
      if (document.querySelector('dialog[open]')) return;
      dialog.showModal();
    };
    const onClose = () => dialog.close();
    const onPrev = () => selectManually(currentIndex - 1);
    const onNext = () => selectManually(currentIndex + 1);
    const onDialogClick = (event: MouseEvent) => { if (event.target === dialog) dialog.close(); };
    openButton.addEventListener('click', onOpen);
    closeButton.addEventListener('click', onClose);
    previousButton.addEventListener('click', onPrev);
    nextButton.addEventListener('click', onNext);
    dialog.addEventListener('click', onDialogClick);
    cleanups.push(() => {
      thumbnailButtons.forEach((button, index) => button.removeEventListener('click', thumbnailHandlers[index]!));
      openButton.removeEventListener('click', onOpen);
      closeButton.removeEventListener('click', onClose);
      previousButton.removeEventListener('click', onPrev);
      nextButton.removeEventListener('click', onNext);
      dialog.removeEventListener('click', onDialogClick);
    });

    const onKeydown = (event: KeyboardEvent) => {
      if (!dialog.open) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); selectManually(currentIndex - 1); }
      else if (event.key === 'ArrowRight') { event.preventDefault(); selectManually(currentIndex + 1); }
      else if (event.key === 'Home') { event.preventDefault(); selectManually(0); }
      else if (event.key === 'End') { event.preventDefault(); selectManually(screenshots.length - 1); }
    };
    document.addEventListener('keydown', onKeydown);
    cleanups.push(() => document.removeEventListener('keydown', onKeydown));

    // 灯箱内滚轮切换截图：带冷却节流避免一次滚动翻多张；大图可滚动时优先原生滚动
    if (window.matchMedia('(pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const dialogFigure = dialog.querySelector<HTMLElement>('.project-screenshots__dialog-figure');
      let lastWheel = 0;
      const onWheel = (event: WheelEvent) => {
        if (!dialog.open || Math.abs(event.deltaY) < 4) return;
        const fig = dialogFigure;
        const insideScrollableFigure = fig
          && (event.target as Element | null)?.closest('.project-screenshots__dialog-figure') === fig
          && fig.scrollHeight > fig.clientHeight + 2;
        if (insideScrollableFigure) return;
        const now = performance.now();
        if (now - lastWheel < 220) { event.preventDefault(); return; }
        lastWheel = now;
        event.preventDefault();
        selectManually(currentIndex + (event.deltaY > 0 ? 1 : -1));
      };
      dialog.addEventListener('wheel', onWheel, { passive: false });
      cleanups.push(() => dialog.removeEventListener('wheel', onWheel));
    }

    // 桌面 sticky 帧序列：进度映射截图索引，段内局部进度做轻微推近镜头
    if (screenshots.length > 2 && canUseStickyMotion()) {
      if (scrollStage) {
        scrollStage.dataset.active = '1';
        const stopStage = observeStageProgress(scrollStage, (value) => {
          if (manualLock) {
            if (Math.abs(window.scrollY - lastScrollY) < 2) return;
            manualLock = false;
          }
          lastScrollY = window.scrollY;
          if (dialog.open) return;
          const segment = value * screenshots.length;
          const index = Math.min(screenshots.length - 1, Math.floor(segment));
          if (index !== currentIndex) selectScreenshot(index);
          scrollStage.style.setProperty('--screenshot-progress', value.toFixed(4));
          scrollStage.style.setProperty('--screenshot-local', easeOutQuad(clamp01(segment - index)).toFixed(4));
        });
        cleanups.push(stopStage);
      }
    }
    });
    return () => cleanups.forEach((cleanup) => cleanup());
  });
</script>

<style>
  .screenshot-scroll-stage {
    position: relative;
  }

  /* 仅桌面脚本启用：外层撑高形成 scrub 行程，内层钉住逐帧切换 */
  .screenshot-scroll-stage[data-active='1'] {
    height: calc(var(--screenshot-count, 1) * 100vh);
  }

  .screenshot-scroll-stage[data-active='1'] .project-screenshots {
    position: sticky;
    top: calc(var(--header-height) + 16px + var(--sat, 0px));
    height: calc(100vh - var(--header-height) - 32px);
    align-content: center;
    padding-block: 24px;
  }

  .screenshot-scroll-stage[data-active='1'] .project-screenshots__stage img {
    transform: scale(calc(1 + 0.06 * var(--screenshot-local, 0)));
    will-change: transform;
  }

  .project-screenshots__scrub {
    display: none;
  }

  .screenshot-scroll-stage[data-active='1'] .project-screenshots__scrub {
    display: block;
    height: 2px;
    margin-top: 18px;
    background: var(--border);
  }

  .screenshot-scroll-stage[data-active='1'] [data-screenshot-scrub-fill] {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--screenshot-progress, 0));
    transform-origin: left center;
  }

  .project-screenshots {
    display: grid;
    grid-template-columns: minmax(220px, 4fr) minmax(0, 8fr);
    gap: clamp(36px, 5vw, 72px);
    padding-block: clamp(64px, 8vw, 96px);
    border-bottom: 1px solid var(--border);
  }

  .project-screenshots__heading h2 {
    /* 章节导航会直接跳到该标题，需为悬浮头部留出避让距离 */
    scroll-margin-top: var(--header-offset);
    margin: 0;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    line-height: 1.14;
  }

  .project-screenshots__intro {
    margin: 22px 0 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .project-screenshots__current {
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .project-screenshots__gallery {
    min-width: 0;
  }

  .project-screenshots__stage,
  .project-screenshots__dialog-figure,
  .project-screenshots__static-list figure {
    margin: 0;
  }

  .project-screenshots__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: var(--screenshot-ratio, 16 / 10);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
  }

  .project-screenshots__stage[data-viewport='mobile'] .project-screenshots__media {
    width: min(100%, 380px);
    max-width: 380px;
    margin-inline: auto;
    padding: 10px;
    border: 1px solid var(--border-strong);
    border-radius: 22px;
    background: var(--surface);
  }

  .project-screenshots__stage[data-viewport='mobile'] .project-screenshots__media::before {
    position: absolute;
    top: 4px;
    left: 50%;
    width: 54px;
    height: 4px;
    border-radius: 999px;
    background: var(--border);
    content: '';
    transform: translateX(-50%);
  }

  .project-screenshots__stage[data-viewport='mobile'] .project-screenshots__media::after {
    position: absolute;
    bottom: 4px;
    left: 50%;
    width: 78px;
    height: 3px;
    border-radius: 999px;
    background: var(--border);
    content: '';
    transform: translateX(-50%);
  }

  .project-screenshots img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .project-screenshots__stage img {
    height: 100%;
  }

  .project-screenshots__stage[data-viewport='mobile'] img {
    border-radius: 20px;
  }

  .project-screenshots__current h3,
  .project-screenshots__dialog-figure h3,
  .project-screenshots__static-list h3 {
    margin: 6px 0 0;
    font-size: 1.15rem;
  }

  .project-screenshots__current p,
  .project-screenshots__dialog-figure p,
  .project-screenshots__static-list p {
    margin: 8px 0 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .project-screenshots__progress {
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .project-screenshots__open,
  .project-screenshots__thumbnail,
  .project-screenshots__dialog-close,
  .project-screenshots__dialog-nav {
    min-height: 44px;
    border: 1px solid var(--border);
    color: var(--ink);
    background: var(--surface);
    font: inherit;
    cursor: pointer;
  }

  .project-screenshots__open {
    margin-top: 18px;
    padding: 10px 22px;
    border-color: var(--border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    transition: color 200ms ease, background-color 200ms ease, border-color 200ms ease;
  }

  .project-screenshots__open:hover {
    color: var(--accent-ink);
    border-color: var(--accent);
    background: var(--accent);
  }

  .project-screenshots__thumbnails {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(108px, 1fr));
    gap: 12px;
    margin-top: 22px;
  }

  .project-screenshots__thumbnail {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    padding: 0;
    border-radius: var(--radius-sm);
    opacity: 0.55;
    transition: opacity 180ms ease, border-color 180ms ease;
  }

  .project-screenshots__thumbnail[aria-current='true'] {
    border-color: var(--border-strong);
    opacity: 1;
  }

  .project-screenshots__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-screenshots__thumbnail span {
    position: absolute;
    right: 6px;
    bottom: 6px;
    padding: 2px 6px;
    border-radius: 999px;
    color: var(--ink);
    background: color-mix(in srgb, var(--canvas) 82%, transparent);
    font-size: 0.68rem;
  }

  [data-screenshot-dialog] {
    width: min(1100px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--ink);
    background: var(--surface);
  }

  [data-screenshot-dialog]::backdrop {
    background: color-mix(in srgb, var(--canvas) 78%, transparent);
    backdrop-filter: blur(12px);
  }

  /* 原生 dialog 只让背景 inert，滚轮/触控仍会滚动底页，打开时锁住文档滚动。 */
  :global(html:has([data-screenshot-dialog][open])) {
    overflow: hidden;
    /* 隐藏滚动条的同时占住槽位，避免桌面端弹窗开关时页面横向跳动。 */
    scrollbar-gutter: stable;
  }

  .project-screenshots__dialog-panel {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    padding: 56px 18px 24px;
  }

  .project-screenshots__dialog-close {
    position: absolute;
    top: 10px;
    right: 10px;
    min-width: 44px;
    border-radius: 50%;
    font-size: 1.4rem;
  }

  .project-screenshots__dialog-nav {
    min-width: 44px;
    border-radius: 50%;
    font-size: 1.2rem;
  }

  .project-screenshots__dialog-figure {
    overflow: auto;
    max-height: calc(100vh - 132px);
    max-height: calc(100dvh - 132px);
  }

  .project-screenshots__dialog-figure img {
    max-height: calc(100vh - 220px);
    max-height: calc(100dvh - 220px);
  }

  .project-screenshots__static-list {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  .project-screenshots__static-list figure {
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
  }

  @media (max-width: 768px) {
    .project-screenshots {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .project-screenshots__thumbnails {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(132px, 44vw);
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 8px;
      scroll-snap-type: x proximity;
      overscroll-behavior-inline: contain;
    }

    .project-screenshots__thumbnail {
      scroll-snap-align: start;
    }

    .project-screenshots__dialog-panel {
      grid-template-columns: 44px minmax(0, 1fr) 44px;
      gap: 8px;
      padding-inline: 8px;
    }

    .project-screenshots__static-list {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-screenshots__thumbnail,
    .project-screenshots__open,
    .project-screenshots__dialog-nav,
    .project-screenshots__dialog-close {
      transition: none;
    }
  }

  /* 打印不该继承滚动舞台的 100vh 行程；恢复成普通图片区，避免空白页 */
  @media print {
    .screenshot-scroll-stage[data-active='1'] { height: auto; }

    .screenshot-scroll-stage[data-active='1'] .project-screenshots {
      position: static;
      height: auto;
      align-content: start;
      padding-block: 24px;
    }

    .screenshot-scroll-stage[data-active='1'] [data-screenshot-stage-image] {
      transform: none !important;
    }

    .project-screenshots__scrub { display: none !important; }
  }
</style>
