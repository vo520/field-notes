---
import { siteConfig } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href="/">{siteConfig.brand}</a>
      <p>{siteConfig.description}</p>
    </div>
    <div class="footer-links" aria-label="页脚链接">
      <a href="/rss.xml">RSS</a>
      <a href="/tags/">标签</a>
      <a href="/archive/">归档</a>
      <a href="/projects/categories/">项目分类</a>
      <a href="/guestbook/">留言板</a>
      {siteConfig.social.github && (
        <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      )}
      {siteConfig.social.gitee && (
        <a href={siteConfig.social.gitee} target="_blank" rel="noopener noreferrer">Gitee</a>
      )}
      {siteConfig.social.email && (
        <a href={`mailto:${siteConfig.social.email}`}>邮箱</a>
      )}
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} {siteConfig.author.name}</span>
    <span>Astro · Cloudflare Workers · GitHub Discussions</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(56px, 8vw, 104px);
    padding-block: 56px calc(28px + var(--sab, 0px));
    background: var(--surface-soft);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
  }

  .footer-brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-grid p {
    max-width: 520px;
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .footer-links {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    font-size: 0.9rem;
  }

  .footer-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 4px;
    color: var(--muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 46px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
