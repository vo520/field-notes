---
import { getCollection } from 'astro:content';

import { siteConfig } from '../config/site';
import { isPublishedProject, isVisibleEntry } from '../lib/content';

const year = new Date().getFullYear();
// 随机漫游的目标在构建期定稿：只收已发布内容，避免把草稿/未过闸门的项目写进前台
const articles = (await getCollection('articles'))
  .filter((entry) => isVisibleEntry(entry, import.meta.env.PROD))
  .map((entry) => `/articles/${entry.id}/`);
const projects = (await getCollection('projects'))
  .filter((entry) => isPublishedProject(entry, import.meta.env.PROD))
  .map((entry) => `/projects/${entry.id}/`);
const randomTargets = [...articles, ...projects];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href="/">{siteConfig.brand}</a>
      <p>{siteConfig.description}</p>
    </div>
    <nav class="footer-links" aria-label={siteConfig.footer.linksAriaLabel}>
      {siteConfig.footer.links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      {siteConfig.social.github && (
        <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">{siteConfig.footer.githubLabel}</a>
      )}
      {siteConfig.social.gitee && (
        <a href={siteConfig.social.gitee} target="_blank" rel="noopener noreferrer">{siteConfig.footer.giteeLabel}</a>
      )}
      {siteConfig.social.email && (
        <a href={`mailto:${siteConfig.social.email}`}>{siteConfig.footer.emailLabel}</a>
      )}
      {randomTargets.length > 0 && (
        <button
          type="button"
          class="footer-random"
          data-random-links={JSON.stringify(randomTargets)}
          aria-label={siteConfig.ui.random.ariaLabel}
        >{siteConfig.ui.random.label} ↗</button>
      )}
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>{siteConfig.footer.copyrightTemplate.replace('{year}', String(year)).replace('{name}', siteConfig.author.name)}</span>
    <span>{siteConfig.footer.techNote}</span>
  </div>
</footer>

<script>
  import { navigate } from 'astro:transitions/client';
  import { registerPageInit } from '../lib/page-lifecycle';

  registerPageInit(() => {
    const cleanups: Array<() => void> = [];
    document.querySelectorAll<HTMLButtonElement>('[data-random-links]').forEach((button) => {
      const onClick = () => {
        let links = [];
        try { links = JSON.parse(button.dataset.randomLinks ?? '[]'); } catch { /* ignore */ }
        if (!Array.isArray(links) || links.length === 0) return;
        // 排除当前页，避免点了「随便看看」原地不动
        const current = window.location.pathname;
        const candidates = links.length > 1 ? links.filter((link) => link !== current) : links;
        // 站内随机跳转走 ClientRouter swap，保留过渡；整页 location.href 会白刷新
        const target = candidates[Math.floor(Math.random() * candidates.length)] ?? links[0];
        if (typeof target === 'string' && target.startsWith('/')) navigate(target);
        else if (typeof target === 'string') window.location.href = target;
      };
      button.addEventListener('click', onClick);
      cleanups.push(() => button.removeEventListener('click', onClick));
    });
    return () => cleanups.forEach((cleanup) => cleanup());
  });
</script>

<style>
  .site-footer {
    margin-top: clamp(56px, 8vw, 104px);
    padding-block: 56px calc(28px + var(--sab, 0px));
    background: var(--surface-soft);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
  }

  .footer-brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-grid p {
    max-width: 520px;
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0 20px;
    font-size: 0.9rem;
  }

  .footer-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 4px;
    color: var(--muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-random {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 4px;
    border: 0;
    color: var(--muted);
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .footer-random:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 46px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  /* 页脚在平板宽度下「简介 + 8 个链接」挤在同一行会把简介压成一字一行，提前收到单列 */
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 640px) {
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
