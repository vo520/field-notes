---
import { siteConfig } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href="/">{siteConfig.brand}</a>
      <p>{siteConfig.description}</p>
    </div>
    <nav class="footer-links" aria-label={siteConfig.footer.linksAriaLabel}>
      {siteConfig.footer.links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      {siteConfig.social.github && (
        <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">{siteConfig.footer.githubLabel}</a>
      )}
      {siteConfig.social.gitee && (
        <a href={siteConfig.social.gitee} target="_blank" rel="noopener noreferrer">{siteConfig.footer.giteeLabel}</a>
      )}
      {siteConfig.social.email && (
        <a href={`mailto:${siteConfig.social.email}`}>{siteConfig.footer.emailLabel}</a>
      )}
      <button
        type="button"
        class="footer-random"
        data-random-links
        aria-label={siteConfig.ui.random.ariaLabel}
      >{siteConfig.ui.random.label} ↗</button>
      <span class="footer-random-status" data-random-announcer role="status" aria-live="polite" aria-atomic="true"></span>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>{siteConfig.footer.copyrightTemplate.replace('{year}', String(year)).replace('{name}', siteConfig.author.name)}</span>
    <span>{siteConfig.footer.techNote}</span>
  </div>
</footer>

<script>
  import { navigate } from 'astro:transitions/client';
  import { registerPageInit } from '../lib/page-lifecycle';
  import { loadSiteIndex } from '../lib/site-index';
  import { siteConfig } from '../config/site';

  registerPageInit(() => {
    const cleanups: Array<() => void> = [];
    const RETRY_DELAY = 600;
    document.querySelectorAll<HTMLButtonElement>('[data-random-links]').forEach((button) => {
      // 原文案在初始化时捕获：连续点击时不会把上一次的反馈文案误当成原文案
      const original = button.textContent;
      const originalLabel = button.getAttribute('aria-label');
      const announcer = document.querySelector<HTMLElement>('[data-random-announcer]');
      let feedbackTimer = 0;
      let announceTimer = 0;
      let retryTimer = 0;
      let retryWake: (() => void) | undefined;
      let disposed = false;
      let retrying = false;
      // 延迟可被 cleanup 唤醒：View Transitions swap 时不留下悬挂的 async 流程
      const waitBeforeRetry = () => new Promise<void>((resolve) => {
        retryWake = resolve;
        retryTimer = window.setTimeout(() => { retryWake = undefined; resolve(); }, RETRY_DELAY);
      });
      // aria-label 优先级高于 textContent：失败时不同步它，读屏用户只会听到「随机打开…」
      const setFeedback = (failed: boolean) => {
        button.textContent = failed ? siteConfig.ui.random.unavailable : original;
        button.setAttribute(
          'aria-label',
          failed ? siteConfig.ui.random.unavailable : originalLabel ?? siteConfig.ui.random.ariaLabel,
        );
        if (!announcer) return;
        window.clearTimeout(announceTimer);
        announcer.textContent = '';
        // 连续两次失败写入相同文案时，先清空再写才能触发读屏重播
        announceTimer = window.setTimeout(() => {
          if (!disposed) announcer.textContent = failed ? siteConfig.ui.random.unavailable : '';
        }, 0);
      };
      const onClick = async () => {
        if (retrying || disposed) return;
        // 漫游目标从 /site-index.json 按需拉取（sessionStorage 缓存），
        // 不再把上百条路径内联进每个页面的 HTML
        let index = await loadSiteIndex();
        if (!index && !disposed) {
          // 首次失败（含超时）给反馈并自动重试一次；加载器不缓存失败，重试会真正重新请求
          retrying = true;
          setFeedback(true);
          await waitBeforeRetry();
          if (disposed) return;
          index = await loadSiteIndex();
          retrying = false;
        }
        if (disposed) return;
        const links = index?.randomTargets ?? [];
        if (links.length === 0) {
          // 重试仍失败：保持反馈文案一段时间再恢复，按钮不做无声无息的死点击
          setFeedback(true);
          window.clearTimeout(feedbackTimer);
          feedbackTimer = window.setTimeout(() => { setFeedback(false); }, 1600);
          return;
        }
        setFeedback(false);
        // 排除当前页，避免点了「随便看看」原地不动
        const current = window.location.pathname;
        const candidates = links.length > 1 ? links.filter((link) => link !== current) : links;
        // 站内随机跳转走 ClientRouter swap，保留过渡；整页 location.href 会白刷新
        const target = candidates[Math.floor(Math.random() * candidates.length)] ?? links[0];
        if (typeof target === 'string' && target.startsWith('/')) navigate(target);
        else if (typeof target === 'string') window.location.href = target;
      };
      button.addEventListener('click', onClick);
      cleanups.push(() => {
        disposed = true;
        button.removeEventListener('click', onClick);
        window.clearTimeout(feedbackTimer);
        window.clearTimeout(announceTimer);
        window.clearTimeout(retryTimer);
        retryWake?.();
        retryWake = undefined;
      });
    });
    return () => cleanups.forEach((cleanup) => cleanup());
  });
</script>

<style>
  .site-footer {
    margin-top: clamp(56px, 8vw, 104px);
    padding-block: 56px calc(28px + var(--sab, 0px));
    background: var(--surface-soft);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
  }

  .footer-brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-grid p {
    max-width: 520px;
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0 20px;
    font-size: 0.9rem;
  }

  .footer-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 4px;
    color: var(--muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-random {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 4px;
    border: 0;
    color: var(--muted);
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .footer-random:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-random-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 46px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  /* 页脚在平板宽度下「简介 + 8 个链接」挤在同一行会把简介压成一字一行，提前收到单列 */
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 640px) {
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
