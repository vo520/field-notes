---
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="切换到深色模式"
  title="切换浅色 / 深色"
>
  <span class="theme-toggle__icon" aria-hidden="true">
    <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"></path>
    </svg>
    <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M20.2 14.6A8.4 8.4 0 1 1 9.4 3.8a6.9 6.9 0 0 0 10.8 10.8Z"></path>
    </svg>
  </span>
  <span class="theme-toggle__label" data-theme-label>浅色</span>
</button>

<script is:inline>
  (() => {
    const toggle = document.currentScript?.previousElementSibling;
    if (!toggle) return;
    const label = toggle.querySelector('[data-theme-label]');
    const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    if (label) label.textContent = theme === 'dark' ? '深色' : '浅色';
    toggle.setAttribute('aria-label', theme === 'dark' ? '切换到浅色模式' : '切换到深色模式');
  })();
</script>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (toggle) {
    const label = toggle.querySelector<HTMLElement>('[data-theme-label]');

    const applyTheme = (theme: 'light' | 'dark') => {
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
      if (label) label.textContent = theme === 'dark' ? '深色' : '浅色';
      toggle.setAttribute('aria-label', theme === 'dark' ? '切换到浅色模式' : '切换到深色模式');
      try {
        localStorage.setItem('site-theme', theme);
      } catch {
        // 存储不可用时仍保留当前页面主题。
      }
      document.dispatchEvent(new CustomEvent('site-theme-change', { detail: { theme } }));
    };

    toggle.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      applyTheme(current === 'dark' ? 'light' : 'dark');
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--ink);
    background: transparent;
    cursor: pointer;
    font-size: 0.82rem;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
    background: var(--accent-soft);
  }

  .theme-toggle__icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
    align-items: center;
    justify-content: center;
  }

  .theme-toggle__icon svg {
    width: 16px;
    height: 16px;
  }

  .theme-toggle__moon,
  :root[data-theme='dark'] .theme-toggle__sun {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle__moon {
    display: block;
  }

  @media (max-width: 520px) {
    .theme-toggle__label {
      display: none;
    }

    .theme-toggle {
      padding: 6px 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }
</style>
