---
import { siteConfig } from '../config/site';

const copy = siteConfig.themeToggle;
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label={copy.switchToDark}
  title={copy.title}
  data-label-light={copy.lightLabel}
  data-label-dark={copy.darkLabel}
  data-aria-light={copy.switchToLight}
  data-aria-dark={copy.switchToDark}
>
  <span class="theme-toggle__icon" aria-hidden="true">
    <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"></path>
    </svg>
    <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M20.2 14.6A8.4 8.4 0 1 1 9.4 3.8a6.9 6.9 0 0 0 10.8 10.8Z"></path>
    </svg>
  </span>
  <span class="theme-toggle__label" data-theme-label>{copy.lightLabel}</span>
</button>

<script is:inline>
  (() => {
    const toggle = document.currentScript?.previousElementSibling;
    if (!toggle) return;
    const label = toggle.querySelector('[data-theme-label]');
    const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    if (label) label.textContent = theme === 'dark' ? toggle.dataset.labelDark : toggle.dataset.labelLight;
    toggle.setAttribute('aria-label', theme === 'dark' ? toggle.dataset.ariaLight : toggle.dataset.ariaDark);
  })();
</script>

<script>
  import { registerPageInit } from '../lib/page-lifecycle';

  registerPageInit(() => {
    const toggle = document.querySelector('[data-theme-toggle]');
    if (!(toggle instanceof HTMLButtonElement)) return;

    const label = toggle.querySelector('[data-theme-label]');
    // 客户端导航后 inline 脚本不会重跑，按钮会带着浅色默认文案；这里按当前主题同步一次，但不写入存储
    const initialTheme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    if (label) label.textContent = (initialTheme === 'dark' ? toggle.dataset.labelDark : toggle.dataset.labelLight) ?? '';
    toggle.setAttribute('aria-label', (initialTheme === 'dark' ? toggle.dataset.ariaLight : toggle.dataset.ariaDark) ?? '');
    // persist 仅用于用户主动切换；跟随系统/跨标签同步时不能写入存储，否则会覆盖「未手动选择」状态
    const applyTheme = (theme: 'light' | 'dark', persist = true) => {
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
      // 与首屏脚本保持一致：同步移动端浏览器工具栏颜色
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#141414' : '#ffffff');
      if (label) label.textContent = (theme === 'dark' ? toggle.dataset.labelDark : toggle.dataset.labelLight) ?? '';
      toggle.setAttribute('aria-label', (theme === 'dark' ? toggle.dataset.ariaLight : toggle.dataset.ariaDark) ?? '');
      if (persist) {
        try { localStorage.setItem('site-theme', theme); } catch { /* 存储不可用时仍保留当前页面主题 */ }
      }
      document.dispatchEvent(new CustomEvent('site-theme-change', { detail: { theme } }));
    };

    const onClick = () => {
      const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      applyTheme(current === 'dark' ? 'light' : 'dark');
    };
    const onSystemChange = (event: MediaQueryListEvent) => {
      try {
        const stored = localStorage.getItem('site-theme');
        if (stored === 'dark' || stored === 'light') return;
      } catch { return; }
      applyTheme(event.matches ? 'dark' : 'light', false);
    };
    const onStorage = (event: StorageEvent) => {
      if (event.key !== 'site-theme') return;
      const theme = event.newValue === 'dark' ? 'dark' : event.newValue === 'light' ? 'light' : null;
      if (!theme || document.documentElement.dataset.theme === theme) return;
      applyTheme(theme, false);
    };

    const media = window.matchMedia('(prefers-color-scheme: dark)');

    // —— 夜间自动（22:00–07:00 深色）：只在用户从未手动选择时生效 ——
    // 首屏由 BaseLayout 内联脚本判定；这里负责浏览中途跨过时间边界的实时切换。
    const manualChoiceStored = () => {
      try {
        const stored = localStorage.getItem('site-theme');
        return stored === 'dark' || stored === 'light';
      } catch { return true; } // 存储不可用时保守处理，不做自动切换
    };
    const scheduledTimer = window.setInterval(() => {
      if (manualChoiceStored()) return;
      const hour = new Date().getHours();
      const expected = hour >= 22 || hour < 7
        ? 'dark'
        : (media.matches ? 'dark' : 'light');
      if (document.documentElement.dataset.theme !== expected) applyTheme(expected, false);
    }, 60_000);

    toggle.addEventListener('click', onClick);
    media.addEventListener('change', onSystemChange);
    window.addEventListener('storage', onStorage);

    return () => {
      window.clearInterval(scheduledTimer);
      toggle.removeEventListener('click', onClick);
      media.removeEventListener('change', onSystemChange);
      window.removeEventListener('storage', onStorage);
    };
  });
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--ink);
    background: transparent;
    cursor: pointer;
    font-size: 0.82rem;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
    background: var(--accent-soft);
  }

  .theme-toggle__icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
    align-items: center;
    justify-content: center;
  }

  .theme-toggle__icon svg {
    width: 16px;
    height: 16px;
  }

  .theme-toggle__moon,
  :root[data-theme='dark'] .theme-toggle__sun {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle__moon {
    display: block;
  }

  @media (max-width: 480px) {
    .theme-toggle__label {
      display: none;
    }

    .theme-toggle {
      padding: 6px 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }
</style>
